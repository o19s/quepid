<%= page_header "Scores for #{case_title @case}" do %>
  <div class="btn-toolbar mb-2 mb-md-0">
    <div class="btn-group me-2">
      <%= link_to "Back to Case", case_core_path(@case), class: "btn btn-sm btn-outline-secondary"  %>
    </div>
  </div>
<% end %>

<p>
  List out all the ratings collected for a Case.
</p>

<div class="card">
  <div class="card-header">   
    <%= form_tag(case_ratings_path(@case), { method: :get }) do %> 
      <div class="mb-0 d-flex fs-6 justify-content-center">
          
        <div class="input-group">
          <%= text_field_tag :search, params[:search],
              class: 'form-control form-control-sm',
              placeholder: 'Filter by query, doc id, or rating',
              id: 'q'
          %>
          <%= button_tag type: 'submit', class: 'btn btn-sm btn-outline-secondary', id: 'button-addon2' do %>
            <i class="bi bi-search-heart"></i>
          <% end %>
        </div>
        
                
      </div>
    <% end %>
  </div>
  
  <div class="card-body">
    <table class="table table-hover table-sm">
      <thead>
        <tr>
          <th>Rating ID</th>
          <th>Query</th>
          <th><%= sort_link(@q, :doc_id, 'Doc ID') %></th>
          <th><%= sort_link(@q, :rating, 'Rating') %></th>
          <th>User</th>
          <th><%= sort_link(@q, :created_at, 'Created At') %></th>
          <th><%= sort_link(@q, :updated_at, 'Updated At') %></th>
        </tr>
      </thead>
  
      <tbody>      
        <% @ratings.each do |rating| %>
          <tr>
            <td><%= rating.id %></td>
            <td><%= rating.query.query_text %></td>
            <td><%= rating.doc_id %></td>
            <td><%= rating.rating %></td>
            <td><%= rating&.user&.fullname %></td>
            <td>
              <%= rating.created_at %>
            </td>
            <td>
              <%= rating.updated_at %>
            </td>  
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="card-footer d-flex justify-content-center">
    <%== @pagy.series_nav(:bootstrap) %> 
  </div>
</div>
