<%# locals: (ai_judge:, option_defaults:, images_supported:, specs:) %>
<% sorted_judge_options = option_defaults.merge(ai_judge.judge_options).except(:llm_include_images, :llm_service_url, :llm_timeout, :supported_scales).reverse_merge(specs.transform_values { nil }.transform_keys(&:to_sym)).sort_by { |k, _| k.to_s == 'llm_provider' ? 0 : 1 } %>
<% sorted_judge_options.each do |key, value| %>
  <% spec = specs[key.to_s] %>
  <% provider_unset = key.to_s == 'llm_provider' && ai_judge.connection.nil? %>
  <%# The provider comes from the connection: shown read-only once there is one (a connection's name needn't say it), hidden until then. %>
  <div class="row mb-3 <%= 'provider-option-field' if spec %> <%= 'd-none' if provider_unset %>" data-provider="<%= spec&.dig(:provider) %>" <% if spec %>data-ai-judge-form-target="providerOptionField"<% end %>>
    <%= label_tag "judge_options[#{key}]", spec&.dig(:label) || key.to_s.humanize.titleize, class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-4">
      <% if key.to_s == 'llm_provider' %>
        <%# Read-only, not disabled: the field still submits, and the server takes the provider from the connection. %>
        <%= select_tag "user[judge_options][llm_provider]",
              options_for_select(LlmProvider.select_options, provider_unset ? '' : value.to_s),
              include_blank: provider_unset ? 'Choose a connection first' : false,
              id: 'judge_options_llm_provider', tabindex: -1,
              class: 'form-select form-select-sm bg-body-secondary pe-none',
              aria: { readonly: true },
              data: { ai_judge_form_target: 'provider' } %>
      <% elsif spec&.dig(:type) == :number %>
        <%= number_field_tag "user[judge_options][#{key}]", value,
              id: "judge_options_#{key}", class: 'form-control form-control-sm',
              min: spec[:min], max: spec[:max], step: spec[:step] %>
        <div class="form-text"><%= spec[:hint] %></div>
      <% else %>
        <%= text_field_tag "user[judge_options][#{key}]", value,
          id: "judge_options_#{key}",
          class: 'form-control form-control-sm', data: { ai_judge_form_target: { 'llm_service_url' => 'url', 'llm_api_version' => 'version', 'llm_model' => 'model' }[key.to_s] } %>
      <% end %>
    </div>
  </div>
<% end %>
<div class="row mb-3">
  <%= label_tag 'judge_options_supported_scales', 'Limit to scales', class: 'col-sm-2 col-form-label' %>
  <div class="col-sm-4">
    <%= text_area_tag 'user[judge_options][supported_scales]', ai_judge.judge_options[:supported_scales],
          id: 'judge_options_supported_scales', rows: 2,
          class: 'form-control form-control-sm',
          data: { ai_judge_wizard_target: 'supportedScales', action: 'input->ai-judge-wizard#filterScales' } %>
    <div class="form-text">
      Leave blank if this judge can rate on any scale. If its model only predicts certain labels (for example, a
      classifier trained on 0&ndash;3), enter each scale it supports on its own line, such as <code>0,1,2,3</code>.
      The judge can then only be tested with, and assigned to, books that use one of those scales.
    </div>
  </div>
</div>
<div class="row mb-3">
  <div class="col-sm-2">Images</div>
  <div class="col-sm-4">
    <% image_setting = ai_judge.judge_options[:llm_include_images] %>
    <% include_images = image_setting.nil? || image_setting == '' || ActiveModel::Type::Boolean.new.cast(image_setting) %>
    <%= hidden_field_tag 'user[judge_options][llm_include_images]', images_supported ? 'false' : include_images.to_s, data: { ai_judge_form_target: 'imagesHidden' } %>
    <div class="form-check form-switch">
      <%= check_box_tag 'user[judge_options][llm_include_images]', 'true', include_images && images_supported,
            id: 'judge_options_llm_include_images', class: 'form-check-input',
            role: 'switch', disabled: !images_supported,
            data: { ai_judge_form_target: 'images', wanted: include_images.to_s, unsupported: (!images_supported).to_s } %>
      <%= label_tag 'judge_options_llm_include_images', 'Judge with images', class: 'form-check-label' %>
    </div>
    <div class="form-text">Use the document image or thumbnail URL. Turn off for text-only models.</div>
    <div class="form-text text-warning-emphasis" data-ai-judge-form-target="imagesNotice" style="display:none">
      <span data-ai-judge-form-target="imagesNoticeProvider"></span> doesn't support images, so none are sent.
    </div>
  </div>
</div>
<% LlmProvider.each do |entry| %>
  <template data-ai-judge-form-target="preset" data-provider="<%= entry.key %>"><%= sanitize entry.help_html, tags: %w[strong b br code a], attributes: %w[href target rel] %></template>
<% end %>
<div id="provider-help" data-ai-judge-form-target="help" class="alert alert-info mt-3 mb-0 small" style="display:none;">
</div>
