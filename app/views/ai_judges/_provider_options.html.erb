<%# locals: (ai_judge:, option_defaults:, images_supported:, provider:, specs:) %>
<% sorted_judge_options = option_defaults.merge(ai_judge.judge_options).except(:llm_include_images, :llm_image_type, :llm_image_dimensions, :llm_service_url, :llm_timeout, :supported_scales).reverse_merge(specs.transform_values { nil }.transform_keys(&:to_sym)).sort_by { |k, _| k.to_s == 'llm_provider' ? 0 : 1 } %>
<%# Rarely changed settings live in Advanced settings below. %>
<% advanced_keys = %i[llm_model llm_api_version] %>
<% sorted_judge_options.reject { |key, _| advanced_keys.include?(key) }.each do |key, value| %>
  <%= render 'ai_judges/option_row', ai_judge: ai_judge, key: key, value: value, spec: specs[key.to_s] %>
<% end %>
<div class="row mb-3">
  <div class="col-sm-2">Images</div>
  <div class="col-sm-4">
    <% image_setting = ai_judge.judge_options[:llm_include_images] %>
    <%# A judge that never saved the switch gets its provider's default: opt-in for Jev (ADR 0009). %>
    <% include_images = image_setting.nil? || image_setting == '' ? (provider.nil? || provider.images_by_default?) : ActiveModel::Type::Boolean.new.cast(image_setting) %>
    <%= hidden_field_tag 'user[judge_options][llm_include_images]', images_supported ? 'false' : include_images.to_s, data: { ai_judge_form_target: 'imagesHidden' } %>
    <div class="form-check form-switch">
      <%= check_box_tag 'user[judge_options][llm_include_images]', 'true', include_images && images_supported,
            id: 'judge_options_llm_include_images', class: 'form-check-input',
            role: 'switch', disabled: !images_supported,
            data: { ai_judge_form_target: 'images', wanted: include_images.to_s, unsupported: (!images_supported).to_s,
                    action: 'change->ai-judge-form#syncImageSettings' } %>
      <%= label_tag 'judge_options_llm_include_images', 'Judge with images', class: 'form-check-label' %>
    </div>
    <div class="form-text">Use the document image or thumbnail URL. Turn off for text-only models.</div>
    <div class="form-text text-warning-emphasis" data-ai-judge-form-target="imagesNotice" style="display:none">
      <span data-ai-judge-form-target="imagesNoticeProvider"></span> doesn't support images, so none are sent.
    </div>
  </div>
</div>
<%# How the image reaches the model and the size it is resized to, from what the provider accepts
    (LlmProvider#image_types / #image_dimensions; ADR 0009 D10, D11). ai-judge-form keeps it in step
    with the provider, the switch and the image type. %>
<% image_types = provider&.allowed_image_types || [] %>
<% image_type = ai_judge.judge_options[:llm_image_type].presence || provider&.default_image_type %>
<% bounds = provider&.supports_images? ? provider.image_dimensions : nil %>
<% images_on = include_images && images_supported %>
<% advanced_open = %i[image_type image_dimensions supported_scales].any? { |attribute| ai_judge.errors.include?(attribute) } %>
<%# Like the provider row, nothing to show until a connection says which provider this is. %>
<div class="mb-3" data-ai-judge-form-target="advanced" style="<%= 'display:none' unless ai_judge.connection %>">
  <a class="collapse-toggle text-decoration-none" data-bs-toggle="collapse" href="#ai-judge-advanced" role="button"
     aria-expanded="<%= advanced_open %>" aria-controls="ai-judge-advanced">
    <i class="bi bi-chevron-right" aria-hidden="true"></i> Advanced settings
  </a>
  <div class="collapse <%= 'show' if advanced_open %>" id="ai-judge-advanced">
    <div class="pt-2">
    <% sorted_judge_options.select { |key, _| advanced_keys.include?(key) }.each do |key, value| %>
      <%= render 'ai_judges/option_row', ai_judge: ai_judge, key: key, value: value, spec: specs[key.to_s] %>
    <% end %>
    <div class="row mb-3">
      <%= label_tag 'judge_options_supported_scales', 'Limit to scales', class: 'col-sm-2 col-form-label' %>
      <div class="col-sm-4">
        <%= text_area_tag 'user[judge_options][supported_scales]', ai_judge.judge_options[:supported_scales],
              id: 'judge_options_supported_scales', rows: 2,
              class: 'form-control form-control-sm',
              data: { ai_judge_wizard_target: 'supportedScales', action: 'input->ai-judge-wizard#filterScales' } %>
        <div class="form-text">
          Leave blank if this judge can rate on any scale. If its model only predicts certain labels (for example, a
          classifier trained on 0&ndash;3), enter each scale it supports on its own line, such as <code>0,1,2,3</code>.
          The judge can then only be tested with, and assigned to, books that use one of those scales.
        </div>
      </div>
    </div>
    <%# The image settings, for a provider that has any to pick. %>
    <div data-ai-judge-form-target="imageSettings" style="<%= 'display:none' unless provider&.advanced_image_settings? %>">
    <div class="row mb-3">
      <%= label_tag 'judge_options_llm_image_type', 'Image type', class: 'col-sm-2 col-form-label' %>
      <div class="col-sm-4">
        <%# A disabled select doesn't submit, so a locked (single) type travels in this field. %>
        <%= hidden_field_tag 'user[judge_options][llm_image_type]', image_type, id: nil,
              disabled: !images_on, data: { ai_judge_form_target: 'imageTypeHidden' } %>
        <%= select_tag 'user[judge_options][llm_image_type]',
              options_for_select(image_types.map { |type| [ { 'url' => 'URL', 'base64' => 'Base64' }[type] || type, type ] }, image_type),
              id: 'judge_options_llm_image_type', class: 'form-select form-select-sm',
              disabled: !images_on || image_types.size < 2,
              data: { ai_judge_form_target: 'imageType', action: 'change->ai-judge-form#syncImageSettings' } %>
        <div class="form-text" data-ai-judge-form-target="imageTypeHint">
          <%= "Fixed for #{provider.label}." if image_types.size == 1 %>
        </div>
      </div>
    </div>
    <div class="row mb-3">
      <%= label_tag 'judge_options_llm_image_dimensions', 'Image dimensions', class: 'col-sm-2 col-form-label' %>
      <div class="col-sm-4">
        <%= number_field_tag 'user[judge_options][llm_image_dimensions]', ai_judge.judge_options[:llm_image_dimensions],
              id: 'judge_options_llm_image_dimensions', class: 'form-control form-control-sm',
              min: bounds&.dig(:min), max: bounds&.dig(:max), step: 1, placeholder: bounds&.dig(:recommended),
              disabled: !images_on || bounds.nil? || image_type == 'url',
              data: { ai_judge_form_target: 'imageDimensions' } %>
        <div class="form-text" data-ai-judge-form-target="imageDimensionsHint">
          <% if bounds %>Resize images to this size (<%= bounds[:min] %>&ndash;<%= bounds[:max] %> px). Blank uses the recommended <%= bounds[:recommended] %> px. Smaller images use fewer tokens, but can make judgements less accurate.<% end %>
        </div>
      </div>
    </div>
    </div>
    </div>
  </div>
</div>
<% LlmProvider.each do |entry| %>
  <template data-ai-judge-form-target="preset" data-provider="<%= entry.key %>"><%= sanitize entry.help_html, tags: %w[strong b br code a], attributes: %w[href target rel] %></template>
<% end %>
<div id="provider-help" data-ai-judge-form-target="help" class="alert alert-info mt-3 mb-0 small" style="display:none;">
</div>
