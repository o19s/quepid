<%# locals: (ai_judge:, form:, book:, book_id:, scorer:, scorer_id:, submitted_options:) %>
<% option_defaults = LlmService::DEFAULT_OPTIONS.merge(llm_provider: 'openai', llm_api_version: '') %>
<%# A book's own scale if there's a book context, otherwise a scorer's (picked
    below, in Step 2, when there's no book) - either way, the same scale an
    actual judging run would be handed. %>
<% scale = book ? JudgeScale.for(book) : JudgeScale.for_scorer(scorer) %>
<div class="card" data-controller="ai-judge-form ai-judge-wizard"
     data-ai-judge-wizard-sample-url-value="<%= ai_judge_sample_query_doc_pair_path(ai_judge.persisted? ? ai_judge.id : 'new', book_id: book_id) %>"
     data-ai-judge-wizard-test-url-value="<%= ai_judge_test_prompt_path(ai_judge.persisted? ? ai_judge.id : 'new', book_id: book_id, scorer_id: scorer_id) %>"
     data-ai-judge-form-presets-value="<%= LlmProvider.presets.to_json %>"
     data-ai-judge-form-stock-prompts-value="<%= LlmProvider.stock_system_prompts.to_json %>"
     data-ai-judge-form-option-defaults-value="<%= option_defaults.to_json %>"
     data-ai-judge-form-has-scale-value="<%= scale.present? %>"
     data-ai-judge-form-book-value="<%= book.present? %>"
     data-ai-judge-wizard-existing-value="<%= ai_judge.persisted? %>"
     data-ai-judge-wizard-draft-key-value="<%= ai_judge.persisted? ? ai_judge.id : 'new' %>"
     data-action="shown.bs.tab->ai-judge-form#syncTab">
  <div class="card-header">
    <h5 class="card-title"><i class="bi bi-robot"></i> AI Judge</h5>
  </div>
  <div class="card-body">
    <% if ai_judge.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(ai_judge.errors.count, "error") %> prohibited this ai_judge from being saved:</h2>

        <ul>
          <% ai_judge.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div data-ai-judge-wizard-target="status" class="alert" style="display:none"></div>
    <% provider = LlmProvider.find(ai_judge.judge_options[:llm_provider]) %>
    <% images_supported = provider.nil? || provider.supports_images? %>
    <% specs = LlmProvider.option_field_specs %>
    <h4><span class="badge bg-primary">1</span> Configure AI Judge</h4>
    <%= render 'shared/team_picker', form: form, label: 'Teams to Share this AI Judge With', selected_ids: params.dig(:user, :team_ids), help_text: "Leave unchecked to keep this judge private. Team members can use and edit shared judges." %>
    <%= hidden_field_tag :book_id, book_id if book_id %>

    <div class="row mb-3">
      <%= form.label :name, class: 'col-sm-2 col-form-label' %>
      <div class="col-sm-4">
        <%= form.text_field :name, class: "form-control", data: { ai_judge_wizard_target: "name", action: "input->ai-judge-wizard#checkReveal" } %>
      </div>
    </div>

    <div class="row mb-3">
      <%= form.label :llm_key, class: 'col-sm-2 col-form-label' %>
      <div class="col-sm-10">
        <div class="input-group" data-controller="password-toggle">
          <div class="masked-input-wrapper is-masked" data-password-toggle-target="wrapper">
            <%= form.text_field :llm_key, class: "form-control masked-field", autocomplete: "off",
                  data: { password_toggle_target: "input", action: "input->password-toggle#renderOverlay" } %>
            <div class="masked-input-overlay" data-password-toggle-target="overlay" aria-hidden="true"></div>
          </div>
          <button type="button" class="btn btn-outline-secondary" data-action="password-toggle#toggle" aria-label="Show LLM key">
            <i class="bi bi-eye" data-password-toggle-target="icon"></i>
          </button>
        </div>
        <div class="form-text">
          This is the key to access your LLM provider's API. What it looks like, and
          whether it is needed at all, depends on the provider &mdash; see its notes under
          Model Configuration.
        </div>
      </div>
    </div>

    <%= render "ai_judges/provider_options", ai_judge: ai_judge, form: form, option_defaults: option_defaults,
               images_supported: images_supported, specs: specs, submitted_options: submitted_options %>

    <div class="row mb-3" id="escalation-field">
      <%= form.label :escalates_to_id, 'When unsure, wake On-Call Judge', class: 'col-sm-2 col-form-label' %>
      <div class="col-sm-4">
        <%= form.collection_select :escalates_to_id, escalation_targets, :id, :name,
              { include_blank: 'Nobody' }, class: 'form-select' %>
        <% if ai_judge.persisted? && ai_judge.on_call? %>
          <div class="alert alert-info small mb-0 mt-2" id="on-call-notice">
            <i class="bi bi-moon-stars" aria-hidden="true"></i>
            <strong>On call</strong> for <%= ai_judge.escalated_from_names %>:
            this judge only rates pairs escalated to it.
          </div>
        <% end %>
      </div>
      <div class="col-sm-6">
        <div class="alert alert-info small mb-0" id="escalation-help">
          <div class="mb-2">
            <strong>On-Call Judge</strong><br>
            Woken when the primary judge produces an invalid or missing score.
          </div>
          <div class="mb-2">
            <strong>Escalation Triggers</strong><br>
            The query/doc pair is marked <strong>unrateable</strong> and escalated to the on-call judge
            if the primary judge:
            <ul class="mb-1">
              <li>Returns no rating.</li>
              <li>Returns a score outside the book's valid scale (e.g., giving a 3 on a 0&ndash;1 scale).</li>
              <li>Scores below its defined <strong>Minimum Confidence</strong> threshold (applies only to
                judges that support confidence scores, like TypeSafe Jev).</li>
              <li>Encounters an API failure (timeout, invalid key, or provider error).</li>
            </ul>
          </div>
          <div>
            <strong>How It Works</strong><br>
            The on-call judge remains idle until the primary judge finishes its run. It then processes
            all escalated pairs in a separate run. Both ratings remain linked in the system so both
            scores are preserved and visible.
          </div>
        </div>
      </div>
    </div>

    <div class="row mb-3">
      <%= form.label :system_prompt, provider&.prompt_label || 'System prompt', class: 'col-sm-2 col-form-label', data: { ai_judge_form_target: 'systemPromptLabel' } %>
      <%= form.textarea :system_prompt, class: "form-control", rows: 6, data: { ai_judge_form_target: "systemPrompt", action: "input->ai-judge-form#updateProviderPanels" } %>
    </div>
    <div class="form-text" data-ai-judge-form-target="systemPromptHint" style="display:none"></div>
    <div class="alert alert-warning small" data-ai-judge-form-target="systemPromptWarning" style="display:none">
      This text is another provider's default, written for a different kind of model.
      <button type="button" class="btn btn-sm btn-outline-secondary" data-action="click->ai-judge-form#useDefaultPrompt">
        Use <span data-ai-judge-form-target="defaultPromptProvider"></span>'s default
      </button>
    </div>
    <hr>

    <%= render "ai_judges/prompt_testing", ai_judge: ai_judge, book: book, scorer: scorer, scorer_id: scorer_id, scale: scale, provider: provider %>
  </div>

  <div class="card-footer">
    <%= form.submit 'Save', class: 'btn btn-primary float-start' %>
    <%= link_to 'Back to AI Judges', ai_judges_path, class: "btn btn-outline-secondary float-end" %>
  </div>
</div>
