<div class="card" data-controller="ai-judge-form ai-judge-wizard"
     data-ai-judge-wizard-sample-url-value="<%= ai_judge_sample_query_doc_pair_path(ai_judge.persisted? ? ai_judge.id : 'new', book_id: @book_id) %>"
     data-ai-judge-wizard-test-url-value="<%= ai_judge_test_prompt_path(ai_judge.persisted? ? ai_judge.id : 'new', book_id: @book_id) %>"
     data-ai-judge-wizard-existing-value="<%= ai_judge.persisted? %>" data-action="shown.bs.tab->ai-judge-form#syncTab">
  <div class="card-header">
    <h5 class="card-title"><i class="bi bi-robot"></i> AI Judge</h5>
  </div>
  <div class="card-body">
    <% if ai_judge.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(ai_judge.errors.count, "error") %> prohibited this ai_judge from being saved:</h2>

        <ul>
          <% ai_judge.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div data-ai-judge-wizard-target="status" class="alert" style="display:none"></div>
    <h4><span class="badge bg-primary">1</span> Configure AI Judge</h4>
    <%= render 'shared/team_picker', form: form, label: 'Teams to Share this AI Judge With', selected_ids: params.dig(:user, :team_ids), help_text: "Leave unchecked to keep this judge private. Team members can use and edit shared judges." %>
    <%= hidden_field_tag :book_id, @book_id if @book_id %>

    <div class="row mb-3">
      <%= form.label :name, class: 'col-sm-2 col-form-label' %>
      <div class="col-sm-4">
        <%= form.text_field :name, class: "form-control", data: { ai_judge_wizard_target: "name", action: "input->ai-judge-wizard#checkReveal" } %>
      </div>
    </div>

    <div class="row mb-3">
      <%= form.label :llm_key, class: 'col-sm-2 col-form-label' %>
      <div class="col-sm-10">
        <%= form.text_field :llm_key, class: "form-control" %>
        <div class="form-text">
          This is the key to access your LLM provider's API.
          Leave blank for providers that do not require a key, such as local Ollama.
        </div>
      </div>
    </div>

    <ul class="nav nav-underline mb-3" id="pills-tab" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="pills-structured-fields-tab" data-bs-toggle="pill" data-bs-target="#pills-structured-fields" type="button" role="tab" aria-controls="pills-structured-fields" aria-selected="true">Structured Fields</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="pills-json-tab" data-ai-judge-form-target="jsonTab" data-bs-toggle="pill" data-bs-target="#pills-json" type="button" role="tab" aria-controls="pills-json" aria-selected="false">JSON</button>
      </li>
    </ul>
    <div class="tab-content" id="pills-tabContent">
      <div class="tab-pane fade show active" id="pills-structured-fields" role="tabpanel" aria-labelledby="pills-structured-fields-tab" tabindex="0">

        <% sorted_judge_options = { llm_provider: 'openai', llm_service_url: 'https://api.openai.com', llm_model: 'gpt-4o', llm_timeout: 30, llm_api_version: '' }.merge(@ai_judge.judge_options).except(:llm_include_images).sort_by { |k, _| k.to_s == 'llm_provider' ? 0 : 1 } %>
        <% sorted_judge_options.each do |key, value| %>
          <div class="row mb-3">
            <%= label_tag "judge_options[#{key}]", key.to_s.humanize.titleize, class: 'col-sm-2 col-form-label' %>
            <div class="col-sm-4">
              <% if key.to_s == 'llm_provider' %>
                <%= select_tag "user[judge_options][llm_provider]",
                      options_for_select([
                        ['OpenAI',                          'openai'],
                        ['Azure OpenAI',                    'azure_openai'],
                        ['Azure AI Foundry',                'azure_ai_foundry'],
                        ['Azure AI Foundry (Serverless)',    'azure_ai_foundry_serverless'],
                        ['Azure AI Foundry (Anthropic)',     'azure_ai_foundry_anthropic'],
                        ['Anthropic',                       'anthropic'],
                        ['Google Gemini',                   'google_gemini'],
                        ['Ollama',                          'ollama'],
                      ], value.to_s),
                      id: 'judge_options_llm_provider',
                      class: 'form-select form-select-sm structured-field', data: { ai_judge_form_target: "structured provider", action: "change->ai-judge-form#providerChanged" }
                %>
              <% else %>
                <%= text_field_tag "user[judge_options][#{key}]", value,
                  id: "judge_options_#{key}",
                  class: 'form-control form-control-sm structured-field', data: { ai_judge_form_target: "structured #{ { 'llm_service_url' => 'url', 'llm_api_version' => 'version', 'llm_model' => 'model' }[key.to_s]}" }
                %>
              <% end %>
            </div>
          </div>
        <% end %>
        <div class="row mb-3">
          <div class="col-sm-2">Images</div>
          <div class="col-sm-4">
            <% image_setting = @ai_judge.judge_options[:llm_include_images] %>
            <% include_images = image_setting.nil? || image_setting == '' || ActiveModel::Type::Boolean.new.cast(image_setting) %>
            <%= hidden_field_tag 'user[judge_options][llm_include_images]', 'false', data: { ai_judge_form_target: 'structured' } %>
            <div class="form-check">
              <%= check_box_tag 'user[judge_options][llm_include_images]', 'true', include_images,
                    id: 'judge_options_llm_include_images', class: 'form-check-input',
                    disabled: !LlmService.image_urls_supported?(@ai_judge.judge_options[:llm_provider]),
                    data: { ai_judge_form_target: 'structured images' } %>
              <%= label_tag 'judge_options_llm_include_images', 'Judge with images', class: 'form-check-label' %>
            </div>
            <div class="form-text">Use the document image or thumbnail URL. Turn off for text-only models. Ollama does not accept image URLs.</div>
          </div>
        </div>
        <template data-ai-judge-form-target="preset" data-provider="openai" data-url="https://api.openai.com" data-version="" data-model="gpt-4o">
      <strong>OpenAI</strong> &mdash; Direct API access.<br><b>URL:</b> <code>https://api.openai.com</code><br><b>Model:</b> e.g. <code>gpt-4o</code>, <code>gpt-4.1</code><br><b>Key:</b> Your OpenAI API key (starts with <code>sk-</code>)<br><b>API Version:</b> Leave blank
    </template>
    <template data-ai-judge-form-target="preset" data-provider="azure_openai" data-url="https://RESOURCE.openai.azure.com" data-version="" data-model="gpt-4.1">
      <strong>Azure OpenAI</strong> &mdash; OpenAI models hosted on Azure.<br><b>URL:</b> <code>https://YOUR-RESOURCE.openai.azure.com</code><br><b>Model:</b> Your deployment name, e.g. <code>gpt-4.1</code>, <code>gpt-5.1</code><br><b>Key:</b> Azure resource API key<br><b>API Version:</b> Set to use deployment-based routing (e.g. <code>2024-12-01-preview</code>), or leave blank for <code>/openai/v1/</code> path
    </template>
    <template data-ai-judge-form-target="preset" data-provider="azure_ai_foundry" data-url="https://RESOURCE.services.ai.azure.com" data-version="2025-01-01-preview" data-model="gpt-4o">
      <strong>Azure AI Foundry</strong> &mdash; Unified Azure AI endpoint.<br><b>URL:</b> <code>https://YOUR-RESOURCE.services.ai.azure.com</code><br><b>Model:</b> Model name, e.g. <code>gpt-4o</code><br><b>Key:</b> Azure AI services key<br><b>API Version:</b> Defaults to <code>2025-01-01-preview</code>
    </template>
    <template data-ai-judge-form-target="preset" data-provider="azure_ai_foundry_serverless" data-url="https://MODEL-NAME.REGION.models.ai.azure.com" data-version="" data-model="">
      <strong>Azure AI Foundry (Serverless)</strong> &mdash; Models-as-a-Service pay-per-token endpoint.<br><b>URL:</b> <code>https://MODEL-NAME.REGION.models.ai.azure.com</code><br><b>Model:</b> Model name from the deployment<br><b>Key:</b> Serverless endpoint key<br><b>API Version:</b> Leave blank
    </template>
    <template data-ai-judge-form-target="preset" data-provider="azure_ai_foundry_anthropic" data-url="https://RESOURCE.services.ai.azure.com/anthropic" data-version="" data-model="claude-3-5-haiku-20241022">
      <strong>Azure AI Foundry (Anthropic)</strong> &mdash; Claude models via Azure using the native Anthropic Messages API.<br><b>URL:</b> <code>https://YOUR-RESOURCE.services.ai.azure.com/anthropic</code><br><b>Model:</b> e.g. <code>claude-3-5-haiku-20241022</code><br><b>Key:</b> Azure AI services key (sent as <code>x-api-key</code> header)<br><b>API Version:</b> Leave blank (the <code>anthropic-version</code> header is set automatically)
    </template>
    <template data-ai-judge-form-target="preset" data-provider="anthropic" data-url="https://api.anthropic.com" data-version="" data-model="claude-sonnet-4-5-20250514">
      <strong>Anthropic</strong> &mdash; Direct Anthropic API access.<br><b>URL:</b> <code>https://api.anthropic.com</code><br><b>Model:</b> e.g. <code>claude-opus-4-6</code>, <code>claude-sonnet-4-5-20250514</code><br><b>Key:</b> Your Anthropic API key (sent as <code>x-api-key</code> header)<br><b>API Version:</b> Leave blank
    </template>
    <template data-ai-judge-form-target="preset" data-provider="google_gemini" data-url="https://generativelanguage.googleapis.com/v1beta/openai" data-version="" data-model="gemini-2.0-flash">
      <strong>Google Gemini</strong> &mdash; Uses the OpenAI-compatible endpoint.<br><b>URL:</b> <code>https://generativelanguage.googleapis.com/v1beta/openai</code><br><b>Model:</b> e.g. <code>gemini-2.0-flash</code><br><b>Key:</b> Your Google AI API key<br><b>API Version:</b> Leave blank
    </template>
    <template data-ai-judge-form-target="preset" data-provider="ollama" data-url="<%= Rails.configuration.ollama_service_url %>" data-version="" data-model="qwen3:0.6b">
      <strong>Ollama</strong> &mdash; Local models via the Ollama container.<br><b>URL:</b> <code><%= Rails.configuration.ollama_service_url %></code><br><b>Model:</b> e.g. <code>qwen3:0.6b</code>, <code>llama3</code><br><b>Key:</b> Leave blank<br><b>API Version:</b> Leave blank
    </template>
    <div id="provider-help" data-ai-judge-form-target="help" class="alert alert-info mt-3 mb-0 small" style="display:none;">
        </div>
      </div>
      <div class="tab-pane fade" id="pills-json" role="tabpanel" aria-labelledby="pills-json-tab" tabindex="0">
        <div class="row mb-3">
          <div class="form-text">
            This the raw JSON stored as <code>options</code> for the Judge.
            Make sure you are editing under the <code>judge_options</code> key.
          </div>
          <%= form.text_area :options, value: @submitted_options || format_json(@ai_judge.options),
            class: 'form-control json-field', rows: 10, disabled: true, data: { ai_judge_form_target: "json" } %>
        </div>
      </div>
    </div>


    <div class="row mb-3">
      <%= form.label :system_prompt, class: 'col-sm-2 col-form-label' %>
      <%= form.textarea :system_prompt, class: "form-control", rows: 6 %>
    </div>
    <hr>

    <!-- Step 2: Test & Refine -->
    <div class="mb-4">
      <h4><span class="badge bg-primary">2</span> Test &amp; Refine</h4>

      <div data-ai-judge-wizard-target="step2" style="display: none;">
        <p class="text-muted">Run the prompt against a real query/doc pair and see how the judge rates it. Edit the prompt above and run again as many times as you like before saving.</p>

        <div class="row gx-5">
          <div class="col-md-6">
            <h6>Query Doc Pair to Evaluate</h6>
            <div class="d-grid mb-2">
              <button type="button" class="btn btn-light" data-action="click->ai-judge-wizard#sampleQueryDocPair">Change Query Doc Pair</button>
            </div>

            <div class="field">
              <label>Query text</label>
              <input type="text" class="form-control" data-ai-judge-wizard-target="queryText">
            </div>

            <div class="field">
              <label>Doc ID</label>
              <input type="text" class="form-control" data-ai-judge-wizard-target="docId">
            </div>

            <div class="field">
              <label>Information Need</label>
              <input type="text" class="form-control" data-ai-judge-wizard-target="informationNeed">
            </div>

            <div class="field">
              <label>Document Fields</label> <small>JSON</small><br>
              <textarea class="form-control" data-ai-judge-wizard-target="documentFields"
                        data-controller="codemirror" data-codemirror-mode="json" data-codemirror-height="300"></textarea>
            </div>

            <div class="field">
              <label>Options</label> <small>JSON</small><br>
              <textarea class="form-control" data-ai-judge-wizard-target="options"
                        data-controller="codemirror" data-codemirror-mode="json" data-codemirror-height="150"></textarea>
            </div>

            <div class="field">
              <label>Notes</label><br>
              <textarea class="form-control" data-ai-judge-wizard-target="notes"></textarea>
            </div>

            <div class="field">
              <label>Position</label>
              <input type="text" class="form-control" data-ai-judge-wizard-target="position">
            </div>
          </div>
          <div class="col-md-6">
            <h6>Rating Information</h6>
            <button type="button" class="btn btn-primary" data-ai-judge-wizard-target="runPromptButton" data-action="click->ai-judge-wizard#runPrompt">Run Prompt</button>

            <div data-ai-judge-wizard-target="loadingSpinner" style="display: none;" class="text-center my-4">
              <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
              <p class="mt-2">Evaluating with AI Judge...</p>
            </div>

            <div data-ai-judge-wizard-target="ratingInfo" style="display: none;">
              <p>LLM Response: <span data-ai-judge-wizard-target="rating"></span></p>
              <p data-ai-judge-wizard-target="explanation"></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card-footer">
    <%= form.submit 'Save', class: 'btn btn-primary float-start' %>
    <%= link_to 'Back to AI Judges', ai_judges_path, class: "btn btn-outline-secondary float-end" %>
  </div>
</div>
