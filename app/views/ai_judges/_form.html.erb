<% option_defaults = LlmService::DEFAULT_OPTIONS.merge(llm_provider: 'openai', llm_api_version: '') %>
<div class="card" data-controller="ai-judge-form ai-judge-wizard"
     data-ai-judge-wizard-sample-url-value="<%= ai_judge_sample_query_doc_pair_path(ai_judge.persisted? ? ai_judge.id : 'new', book_id: @book_id) %>"
     data-ai-judge-wizard-test-url-value="<%= ai_judge_test_prompt_path(ai_judge.persisted? ? ai_judge.id : 'new', book_id: @book_id) %>"
     data-ai-judge-form-presets-value="<%= LlmProvider.presets.to_json %>"
     data-ai-judge-form-stock-prompts-value="<%= LlmProvider.stock_system_prompts.to_json %>"
     data-ai-judge-form-option-defaults-value="<%= option_defaults.to_json %>"
     data-ai-judge-form-has-scale-value="<%= !JudgeScale.for(@book).empty? %>"
     data-ai-judge-wizard-existing-value="<%= ai_judge.persisted? %>" data-action="shown.bs.tab->ai-judge-form#syncTab">
  <div class="card-header">
    <h5 class="card-title"><i class="bi bi-robot"></i> AI Judge</h5>
  </div>
  <div class="card-body">
    <% if ai_judge.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(ai_judge.errors.count, "error") %> prohibited this ai_judge from being saved:</h2>

        <ul>
          <% ai_judge.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div data-ai-judge-wizard-target="status" class="alert" style="display:none"></div>
    <% provider = LlmProvider.find(ai_judge.judge_options[:llm_provider]) %>
    <% scale = JudgeScale.for(@book) %>
    <% images_supported = provider.nil? || provider.supports_images? %>
    <% specs = LlmProvider.option_field_specs %>
    <h4><span class="badge bg-primary">1</span> Configure AI Judge</h4>
    <%= render 'shared/team_picker', form: form, label: 'Teams to Share this AI Judge With', selected_ids: params.dig(:user, :team_ids), help_text: "Leave unchecked to keep this judge private. Team members can use and edit shared judges." %>
    <%= hidden_field_tag :book_id, @book_id if @book_id %>

    <div class="row mb-3">
      <%= form.label :name, class: 'col-sm-2 col-form-label' %>
      <div class="col-sm-4">
        <%= form.text_field :name, class: "form-control", data: { ai_judge_wizard_target: "name", action: "input->ai-judge-wizard#checkReveal" } %>
      </div>
    </div>

    <div class="row mb-3">
      <%= form.label :llm_key, class: 'col-sm-2 col-form-label' %>
      <div class="col-sm-10">
        <%= form.text_field :llm_key, class: "form-control" %>
        <div class="form-text">
          This is the key to access your LLM provider's API.
          See the selected provider’s notes for its key requirements.
        </div>
      </div>
    </div>

    <ul class="nav nav-underline mb-3" id="pills-tab" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="pills-structured-fields-tab" data-bs-toggle="pill" data-bs-target="#pills-structured-fields" type="button" role="tab" aria-controls="pills-structured-fields" aria-selected="true">Structured Fields</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="pills-json-tab" data-ai-judge-form-target="jsonTab" data-bs-toggle="pill" data-bs-target="#pills-json" type="button" role="tab" aria-controls="pills-json" aria-selected="false">JSON</button>
      </li>
    </ul>
    <div class="tab-content" id="pills-tabContent">
      <div class="tab-pane fade show active" id="pills-structured-fields" role="tabpanel" aria-labelledby="pills-structured-fields-tab" tabindex="0">

        <% sorted_judge_options = option_defaults.merge(@ai_judge.judge_options).except(:llm_include_images).reverse_merge(specs.transform_values { nil }.transform_keys(&:to_sym)).sort_by { |k, _| k.to_s == 'llm_provider' ? 0 : 1 } %>
        <% sorted_judge_options.each do |key, value| %>
          <% spec = specs[key.to_s] %>
          <div class="row mb-3 <%= 'provider-option-field' if spec %>" data-provider="<%= spec&.dig(:provider) %>" <%= 'data-ai-judge-form-target=providerOptionField' if spec %>>
            <%= label_tag "judge_options[#{key}]", spec&.dig(:label) || key.to_s.humanize.titleize, class: 'col-sm-2 col-form-label' %>
            <div class="col-sm-4">
              <% if key.to_s == 'llm_provider' %>
                <%= select_tag "user[judge_options][llm_provider]",
                      options_for_select(LlmProvider.select_options, value.to_s),
                      id: 'judge_options_llm_provider',
                      class: 'form-select form-select-sm', data: { ai_judge_form_target: "structured provider", action: "change->ai-judge-form#providerChanged" }
                %>
              <% elsif spec&.dig(:type) == :number %>
                <%= number_field_tag "user[judge_options][#{key}]", value,
                      id: "judge_options_#{key}", class: 'form-control form-control-sm',
                      min: spec[:min], max: spec[:max], step: spec[:step], data: { ai_judge_form_target: "structured" } %>
                <div class="form-text"><%= spec[:hint] %></div>
              <% else %>
                <%= text_field_tag "user[judge_options][#{key}]", value,
                  id: "judge_options_#{key}",
                  class: 'form-control form-control-sm', data: { ai_judge_form_target: "structured #{ { 'llm_service_url' => 'url', 'llm_api_version' => 'version', 'llm_model' => 'model' }[key.to_s]}" }
                %>
              <% end %>
            </div>
          </div>
        <% end %>
        <div class="row mb-3">
          <div class="col-sm-2">Images</div>
          <div class="col-sm-4">
            <% image_setting = @ai_judge.judge_options[:llm_include_images] %>
            <% include_images = image_setting.nil? || image_setting == '' || ActiveModel::Type::Boolean.new.cast(image_setting) %>
            <%= hidden_field_tag 'user[judge_options][llm_include_images]', images_supported ? 'false' : include_images.to_s, data: { ai_judge_form_target: 'structured imagesHidden' } %>
            <div class="form-check">
              <%= check_box_tag 'user[judge_options][llm_include_images]', 'true', include_images && images_supported,
                    id: 'judge_options_llm_include_images', class: 'form-check-input',
                    disabled: !images_supported,
                    data: { ai_judge_form_target: 'structured images', wanted: include_images.to_s, unsupported: (!images_supported).to_s } %>
              <%= label_tag 'judge_options_llm_include_images', 'Judge with images', class: 'form-check-label' %>
            </div>
            <div class="form-text">Use the document image or thumbnail URL. Turn off for text-only models.</div>
            <div class="form-text text-warning-emphasis" data-ai-judge-form-target="imagesNotice" style="display:none">
              <span data-ai-judge-form-target="imagesNoticeProvider"></span> doesn't support images, so none are sent.
            </div>
          </div>
        </div>
        <% LlmProvider.each do |entry| %>
          <template data-ai-judge-form-target="preset" data-provider="<%= entry.key %>"><%= entry.help_html.html_safe %></template>
        <% end %>
        <div id="provider-help" data-ai-judge-form-target="help" class="alert alert-info mt-3 mb-0 small" style="display:none;">
        </div>
      </div>
      <div class="tab-pane fade" id="pills-json" role="tabpanel" aria-labelledby="pills-json-tab" tabindex="0">
        <div class="row mb-3">
          <div class="form-text">
            This the raw JSON stored as <code>options</code> for the Judge.
            Make sure you are editing under the <code>judge_options</code> key.
          </div>
          <%= form.text_area :options, value: @submitted_options || format_json(@ai_judge.options),
            class: 'form-control', rows: 10, disabled: true, data: { ai_judge_form_target: "json", action: "input->ai-judge-form#jsonChanged" } %>
        </div>
      </div>
    </div>


    <div class="row mb-3">
      <%= form.label :system_prompt, provider&.prompt_label || 'System prompt', class: 'col-sm-2 col-form-label', data: { ai_judge_form_target: 'systemPromptLabel' } %>
      <%= form.textarea :system_prompt, class: "form-control", rows: 6, data: { ai_judge_form_target: "systemPrompt", action: "input->ai-judge-form#updateProviderPanels" } %>
    </div>
    <div class="form-text" data-ai-judge-form-target="systemPromptHint" style="display:none"></div>
    <div class="alert alert-warning small" data-ai-judge-form-target="systemPromptWarning" style="display:none">
      This text is another provider's default, written for a different kind of model.
      <button type="button" class="btn btn-sm btn-outline-secondary" data-action="click->ai-judge-form#useDefaultPrompt">
        Use <span data-ai-judge-form-target="defaultPromptProvider"></span>'s default
      </button>
    </div>
    <hr>

    <!-- Step 2: Test & Refine -->
    <div class="mb-4">
      <h4><span class="badge bg-primary">2</span> Test &amp; Refine</h4>

      <div data-ai-judge-wizard-target="step2" style="display: none;">
        <p class="text-muted">Run the prompt against a real query/doc pair and see how the judge rates it. Edit the prompt above and run again as many times as you like before saving.</p>

        <div class="row gx-5">
          <div class="col-md-6">
            <h6>Query Doc Pair to Evaluate</h6>
            <div class="d-grid mb-2">
              <button type="button" class="btn btn-light" data-action="click->ai-judge-wizard#sampleQueryDocPair">Change Query Doc Pair</button>
            </div>

            <div>
              <label>Query text</label>
              <input type="text" class="form-control" data-ai-judge-wizard-target="queryText">
            </div>

            <div>
              <label>Doc ID</label>
              <input type="text" class="form-control" data-ai-judge-wizard-target="docId">
            </div>

            <div>
              <label>Information Need</label>
              <input type="text" class="form-control" data-ai-judge-wizard-target="informationNeed">
            </div>

            <div>
              <label>Document Fields</label> <small>JSON</small><br>
              <textarea class="form-control" data-ai-judge-wizard-target="documentFields"
                        data-controller="codemirror" data-codemirror-mode="json" data-codemirror-height="300"></textarea>
            </div>

            <div>
              <label>Options</label> <small>JSON</small><br>
              <textarea class="form-control" data-ai-judge-wizard-target="options"
                        data-controller="codemirror" data-codemirror-mode="json" data-codemirror-height="150"></textarea>
            </div>

            <div>
              <label>Notes</label><br>
              <textarea class="form-control" data-ai-judge-wizard-target="notes"></textarea>
            </div>

            <div>
              <label>Position</label>
              <input type="text" class="form-control" data-ai-judge-wizard-target="position">
            </div>
          </div>
          <div class="col-md-6">
            <h6>Rating Information</h6>
            <% unless scale.empty? %>
              <div class="mb-3">
                <div data-ai-judge-form-target="criteriaTable" style="display:<%= provider&.scale_as_criteria? ? 'block' : 'none' %>">
                  <h6>Criteria sent with the question — from <%= link_to @book.name, book_path(@book) %>'s scale</h6>
                  <table class="table table-sm table-borderless small w-auto"><tbody>
                    <% scale.values.zip(scale.criteria).each_with_index do |(value, criterion), level| %>
                      <tr><td>level <%= level %> → rating <strong><%= value %></strong></td><td><%= criterion %></td></tr>
                    <% end %>
                  </tbody></table>
                </div>
                <div data-ai-judge-form-target="criteriaProse" style="display:<%= provider&.scale_as_criteria? ? 'none' : 'block' %>">
                  <h6>Rating scale added to the prompt — from <%= link_to @book.name, book_path(@book) %>'s scale</h6>
                  <p class="small"><%= scale.describe %></p>
                </div>
              </div>
            <% end %>
            <div class="form-text" data-ai-judge-form-target="needsScaleNotice" style="display:<%= provider&.needs_scale? && scale.empty? ? 'block' : 'none' %>">
              This provider rates against a book's scale. Open this judge from a book with a scale on its Judgement Stats page (Refine Prompt).
            </div>
            <button type="button" class="btn btn-primary" <%= 'disabled' if provider&.needs_scale? && scale.empty? %> data-ai-judge-form-target="runPromptButton" data-ai-judge-wizard-target="runPromptButton" data-action="click->ai-judge-wizard#runPrompt">Run Prompt</button>

            <div data-ai-judge-wizard-target="loadingSpinner" style="display: none;" class="text-center my-4">
              <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
              <p class="mt-2">Evaluating with AI Judge...</p>
            </div>

            <div data-ai-judge-wizard-target="ratingInfo" style="display: none;">
              <span class="badge bg-warning text-dark" data-ai-judge-wizard-target="unrateable" style="display:none">Unrateable</span>
              <p>LLM Response: <span data-ai-judge-wizard-target="rating"></span></p>
              <p data-ai-judge-wizard-target="explanation"></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card-footer">
    <%= form.submit 'Save', class: 'btn btn-primary float-start' %>
    <%= link_to 'Back to AI Judges', ai_judges_path, class: "btn btn-outline-secondary float-end" %>
  </div>
</div>
