<%# locals: (ai_judge:, form:, book:, book_id:, submitted_options:) %>
<% option_defaults = LlmService::DEFAULT_OPTIONS.merge(llm_provider: 'openai', llm_api_version: '') %>
<div class="card" data-controller="ai-judge-form ai-judge-wizard"
     data-ai-judge-wizard-sample-url-value="<%= ai_judge_sample_query_doc_pair_path(ai_judge.persisted? ? ai_judge.id : 'new', book_id: book_id) %>"
     data-ai-judge-wizard-test-url-value="<%= ai_judge_test_prompt_path(ai_judge.persisted? ? ai_judge.id : 'new', book_id: book_id) %>"
     data-ai-judge-form-presets-value="<%= LlmProvider.presets.to_json %>"
     data-ai-judge-form-stock-prompts-value="<%= LlmProvider.stock_system_prompts.to_json %>"
     data-ai-judge-form-option-defaults-value="<%= option_defaults.to_json %>"
     data-ai-judge-form-has-scale-value="<%= !JudgeScale.for(book).empty? %>"
     data-ai-judge-wizard-existing-value="<%= ai_judge.persisted? %>" data-action="shown.bs.tab->ai-judge-form#syncTab">
  <div class="card-header">
    <h5 class="card-title"><i class="bi bi-robot"></i> AI Judge</h5>
  </div>
  <div class="card-body">
    <% if ai_judge.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(ai_judge.errors.count, "error") %> prohibited this ai_judge from being saved:</h2>

        <ul>
          <% ai_judge.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div data-ai-judge-wizard-target="status" class="alert" hidden></div>
    <% provider = LlmProvider.find(ai_judge.judge_options[:llm_provider]) %>
    <% scale = JudgeScale.for(book) %>
    <% images_supported = provider.nil? || provider.supports_images? %>
    <% specs = LlmProvider.option_field_specs %>
    <h4><span class="badge bg-primary">1</span> Configure AI Judge</h4>
    <%= render 'shared/team_picker', form: form, label: 'Teams to Share this AI Judge With', selected_ids: params.dig(:user, :team_ids), help_text: "Leave unchecked to keep this judge private. Team members can use and edit shared judges." %>
    <%= hidden_field_tag :book_id, book_id if book_id %>

    <div class="row mb-3">
      <%= form.label :name, class: 'col-sm-2 col-form-label' %>
      <div class="col-sm-4">
        <%= form.text_field :name, class: "form-control", data: { ai_judge_wizard_target: "name", action: "input->ai-judge-wizard#checkReveal" } %>
      </div>
    </div>

    <div class="row mb-3">
      <%= form.label :llm_key, class: 'col-sm-2 col-form-label' %>
      <div class="col-sm-10">
        <%= form.text_field :llm_key, class: "form-control" %>
        <div class="form-text">
          This is the key to access your LLM provider's API.
          See the selected provider’s notes for its key requirements.
        </div>
      </div>
    </div>

    <%= render "ai_judges/provider_options", ai_judge: ai_judge, form: form, option_defaults: option_defaults,
               images_supported: images_supported, specs: specs, submitted_options: submitted_options %>

    <div class="row mb-3">
      <%= form.label :system_prompt, provider&.prompt_label || 'System prompt', class: 'col-sm-2 col-form-label', data: { ai_judge_form_target: 'systemPromptLabel' } %>
      <%= form.textarea :system_prompt, class: "form-control", rows: 6, data: { ai_judge_form_target: "systemPrompt", action: "input->ai-judge-form#updateProviderPanels" } %>
    </div>
    <div class="form-text" data-ai-judge-form-target="systemPromptHint" hidden></div>
    <div class="alert alert-warning small" data-ai-judge-form-target="systemPromptWarning" hidden>
      This text is another provider's default, written for a different kind of model.
      <button type="button" class="btn btn-sm btn-outline-secondary" data-action="click->ai-judge-form#useDefaultPrompt">
        Use <span data-ai-judge-form-target="defaultPromptProvider"></span>'s default
      </button>
    </div>
    <hr>

    <%= render "ai_judges/prompt_testing", book: book, scale: scale, provider: provider %>
  </div>

  <div class="card-footer">
    <%= form.submit 'Save', class: 'btn btn-primary float-start' %>
    <%= link_to 'Back to AI Judges', ai_judges_path, class: "btn btn-outline-secondary float-end" %>
  </div>
</div>
