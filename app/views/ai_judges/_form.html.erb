<div class="card"
     data-controller="ai-judge-wizard"
     data-ai-judge-wizard-sample-url-value="<%= ai_judge_sample_query_doc_pair_path(ai_judge.persisted? ? ai_judge.id : 'new', book_id: @book_id) %>"
     data-ai-judge-wizard-test-url-value="<%= ai_judge_test_prompt_path(ai_judge.persisted? ? ai_judge.id : 'new', book_id: @book_id) %>"
     data-ai-judge-wizard-existing-value="<%= ai_judge.persisted? %>">
  <div class="card-header">
    <h5 class="mb-0"><i class="bi bi-robot"></i> AI Judge</h5>
  </div>
  <div class="card-body">
    <% if ai_judge.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(ai_judge.errors.count, "error") %> prohibited this ai_judge from being saved:</h2>

        <ul>
          <% ai_judge.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div data-ai-judge-wizard-target="status" class="alert" style="display: none;"></div>

    <!-- Step 1: Configure -->
    <div class="mb-4">
      <h4><span class="badge bg-primary">1</span> Configure AI Judge</h4>
      <p class="text-muted">Set up the judge's identity, credentials, and prompt.</p>

      <div class="row mb-3">
        <%= form.label :name, class: 'col-sm-2 col-form-label' %>
        <div class="col-sm-4">
          <%= form.text_field :name, class: "form-control",
                data: { ai_judge_wizard_target: "name", action: "input->ai-judge-wizard#checkReveal" } %>
        </div>
      </div>

      <div class="mb-3">
        <%= render 'shared/team_picker', form: form, label: 'Teams to Share this AI Judge With',
              help_text: "AI judges are usable by anyone on a team they're shared with. Leave unchecked to keep this judge private to you." %>
      </div>

      <div class="row mb-3">
        <%= form.label :llm_key, class: 'col-sm-2 col-form-label' %>
        <div class="col-sm-10">
          <%= form.text_field :llm_key, class: "form-control", data: { ai_judge_wizard_target: "llmKey" } %>
          <div class="form-text">
            This is the key to access your LLM provider's API. Leave it blank if
            your provider doesn't check one (e.g. a local Ollama setup).
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <ul class="nav nav-underline mb-3" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="pills-structured-fields-tab" data-bs-toggle="pill" data-bs-target="#pills-structured-fields" type="button" role="tab" aria-controls="pills-structured-fields" aria-selected="true" data-action="click->ai-judge-wizard#showStructuredTab">Structured Fields</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="pills-json-tab" data-bs-toggle="pill" data-bs-target="#pills-json" type="button" role="tab" aria-controls="pills-json" aria-selected="false" data-action="click->ai-judge-wizard#showJsonTab">JSON</button>
            </li>
          </ul>
          <div class="tab-content" id="pills-tabContent">
            <div class="tab-pane fade show active" id="pills-structured-fields" role="tabpanel" aria-labelledby="pills-structured-fields-tab" tabindex="0">

              <% sorted_judge_options = @ai_judge.judge_options.sort_by { |k, _| k.to_s == 'llm_provider' ? 0 : 1 } %>
              <% sorted_judge_options.each do |key, value| %>
                <div class="row mb-3">
                  <%= label_tag "judge_options[#{key}]", key.to_s.humanize.titleize, class: 'col-sm-5 col-form-label text-nowrap' %>
                  <div class="col-sm-7">
                    <% if key.to_s == 'llm_provider' %>
                      <%= select_tag "user[judge_options][llm_provider]",
                            options_for_select([
                              ['OpenAI',                          'openai'],
                              ['Azure OpenAI',                    'azure_openai'],
                              ['Azure AI Foundry',                'azure_ai_foundry'],
                              ['Azure AI Foundry (Serverless)',    'azure_ai_foundry_serverless'],
                              ['Azure AI Foundry (Anthropic)',     'azure_ai_foundry_anthropic'],
                              ['Anthropic',                       'anthropic'],
                              ['Google Gemini',                   'google_gemini'],
                              ['Ollama',                          'ollama'],
                            ], value.to_s),
                            id: 'judge_options_llm_provider',
                            class: 'form-select form-select-sm structured-field',
                            data: { ai_judge_wizard_target: "llmProvider structuredField", action: "change->ai-judge-wizard#updateProviderPreset" }
                      %>
                    <% else %>
                      <%= text_field_tag "user[judge_options][#{key}]", value,
                        id: "judge_options_#{key}",
                        class: 'form-control form-control-sm structured-field',
                        data: { ai_judge_wizard_target: "#{key.to_s.camelize(:lower)} structuredField" }
                      %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
            <div class="tab-pane fade" id="pills-json" role="tabpanel" aria-labelledby="pills-json-tab" tabindex="0">
              <div class="row mb-3">
                <div class="form-text">
                  This the raw JSON stored as <code>options</code> for the Judge.
                  Make sure you are editing under the <code>judge_options</code> key.
                </div>
                <%= form.text_area :options, value: format_json(@ai_judge.options),
                  class: 'form-control json-field', rows: 10, disabled: true,
                  data: { ai_judge_wizard_target: "jsonField" } %>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="fw-semibold mb-2">Model Configuration</div>
          <div data-ai-judge-wizard-target="providerHelp" class="alert alert-info small" style="display:none;">
          </div>
        </div>
      </div>

      <div class="row mb-3">
        <%= form.label :system_prompt, class: 'col-sm-2 col-form-label' %>
        <%= form.textarea :system_prompt, class: "form-control", rows: 6, data: { ai_judge_wizard_target: "systemPrompt" } %>
      </div>
    </div>

    <hr>

    <!-- Step 2: Test & Refine -->
    <div class="mb-4">
      <h4><span class="badge bg-primary">2</span> Test &amp; Refine</h4>

      <div data-ai-judge-wizard-target="step2" style="display: none;">
        <p class="text-muted">Run the prompt against a real query/doc pair and see how the judge rates it. Edit the prompt above and run again as many times as you like before saving.</p>

        <div class="row gx-5">
          <div class="col-md-6">
            <h6>Query Doc Pair to Evaluate</h6>
            <div class="d-grid mb-2">
              <button type="button" class="btn btn-light" data-action="click->ai-judge-wizard#sampleQueryDocPair">Change Query Doc Pair</button>
            </div>

            <div class="field">
              <label>Query text</label>
              <input type="text" class="form-control" data-ai-judge-wizard-target="queryText">
            </div>

            <div class="field">
              <label>Doc ID</label>
              <input type="text" class="form-control" data-ai-judge-wizard-target="docId">
            </div>

            <div class="field">
              <label>Information Need</label>
              <input type="text" class="form-control" data-ai-judge-wizard-target="informationNeed">
            </div>

            <div class="field">
              <label>Document Fields</label> <small>JSON</small><br>
              <textarea class="form-control" data-ai-judge-wizard-target="documentFields"
                        data-codemirror-mode="json" data-codemirror-height="300"></textarea>
            </div>

            <div class="field">
              <label>Options</label> <small>JSON</small><br>
              <textarea class="form-control" data-ai-judge-wizard-target="options"
                        data-codemirror-mode="json" data-codemirror-height="150"></textarea>
            </div>

            <div class="field">
              <label>Notes</label><br>
              <textarea class="form-control" data-ai-judge-wizard-target="notes"></textarea>
            </div>

            <div class="field">
              <label>Position</label>
              <input type="text" class="form-control" data-ai-judge-wizard-target="position">
            </div>
          </div>
          <div class="col-md-6">
            <h6>Rating Information</h6>
            <button type="button" class="btn btn-primary" data-ai-judge-wizard-target="runPromptButton" data-action="click->ai-judge-wizard#runPrompt">Run Prompt</button>

            <div data-ai-judge-wizard-target="loadingSpinner" style="display: none;" class="text-center my-4">
              <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
              <p class="mt-2">Evaluating with AI Judge...</p>
            </div>

            <div data-ai-judge-wizard-target="ratingInfo" style="display: none;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card-footer">
    <%= form.submit 'Save', class: 'btn btn-primary float-start' %>
    <%= link_to 'Back to AI Judges', ai_judges_path, class: "btn btn-outline-secondary float-end" %>
  </div>
</div>

<style>
.lint-marker {
  width: 16px;
  height: 16px;
  background-color: red;
  border-radius: 50%;
}

.lint-marker.error {
  background-color: red;
}
</style>
