<div class="container centered-form">
  <div class="row mb-3">
    <%= form_with url: @team ? team_ai_judges_path(@team) : ai_judges_path, model: @ai_judge, scope: :user do |form| %>
      <%= render "form", ai_judge: @ai_judge, form: form, book: @book, book_id: @book_id, scorer: @scorer,
                 scorer_id: @scorer_id, submitted_options: @submitted_options %>
    <% end %>
  </div>
</div>
