<% title = capture do %>
  Judgements for <i class="bi bi-book"></i> <%= book_title @book %>
<% end %>
<%= page_header title do %>
  <div class="btn-toolbar mb-2 mb-md-0">
    <div class="btn-group me-2">
      <%= link_to 'Bulk Judge', book_judge_bulk_path(@book), class: "btn btn-sm btn-primary" %>
    </div>
  </div>
<% end %>

<%= render 'books/tabs', book: @book %>

<div class="card">
  <div class="card-header">
    <%= render "shared/index_filters",
      url: book_judgements_path(@book), placeholder: "Filter by query, doc id, or explanation", search_width: 340,
      hidden_fields: { filtered: true },
      judge_options: @book.judges.map { |judge| [judge.fullname, judge.id] },
      checkboxes: [{ name: :compact, value: true, checked: @compact, label: 'Compact' },
                   { name: :unrateable, value: true, checked: params[:unrateable].present?, label: 'Unrateable' },
                   { name: :judge_later, value: true, checked: params[:judge_later].present?, label: 'Later' }] %>
  </div>
  
  <div class="card-body">
    <table class="table table-hover table-sm">
      <thead>
        <tr>
          <th>Query</th>
          <th>Query Doc ID</th>   
          <th>Doc ID</th>
          <th>ID</th>
          <% unless @compact %>
            <th>Document fields</th>
          <% end %>
          <th>Rating</th>
          <% unless @compact %>
            <th>Unrateable</th>
            <th>Judge Later</th>
          <% end %>
          <th>Rater</th>
          <% unless @compact %>
            <th>Explanation</th>
            <th>Created At</th>
            <th>Updated At</th>      
          <% end %>
    
        </tr>
      </thead>
  
      <tbody>
      <%
      last_query_doc_pair_id = nil
      table_row_style = nil #cycle('', 'table-primary')
      %>
      <% @judgements.each do |judgement| %>
          <% 
          if last_query_doc_pair_id != judgement.query_doc_pair_id
            table_row_style = cycle('table-active', '')
            last_query_doc_pair_id = judgement.query_doc_pair_id
          end
          %>
          <tr class="<%= table_row_style %>">
            <td>
              <%= judgement.query_doc_pair.query_text %>
            </td>            
            <td>
              <%= judgement.query_doc_pair.id %> 
            </td>
            <td>
              <%= judgement.query_doc_pair.doc_id %>
            </td>
            <td>
              <%= link_to judgement.id, edit_book_query_doc_pair_judgement_path(@book, judgement.query_doc_pair, judgement) %>
            </td>
            <% unless @compact %>
            <td>            
              <%= truncate(judgement.query_doc_pair.document_fields.to_json, length: 150) %>
            </td>
            <% end %> 
            <td>
              <%= judgement.rating %>
            </td>
            <% unless @compact %>
              <td>
                <%= judgement.unrateable? ? 'X' : '' %>
              </td>
              <td>
                <%= judgement.judge_later? ? 'X' : '' %>
              </td>
            <% end %>
            <td>
              <%= display_judge_name(judgement.user) %>
            </td>
            <% unless @compact %>
              <td>
                <%= judgement.explanation %>
              </td>
              <td>
                <%= judgement.created_at %>
              </td>
              <td>
                <%= judgement.updated_at %>
              </td>  
            <% end %>
          </tr>
      <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/index_pagination", pagy: @pagy %>
</div>
