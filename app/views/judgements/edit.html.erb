<turbo-frame id="query_doc_pair_card">
<h2 class="mt-3">Editing Judgement</h2>

<%= render 'form', book: @book, viewer: @current_user, judgement: @judgement, query_doc_pair: @judgement.query_doc_pair, url_for_form: book_query_doc_pair_judgement_path(@book, @judgement.query_doc_pair, @judgement) %>

<br>

<% if @previous_judgement %>
  <%= button_to 'Go Back to Previous Query/Doc Pair', edit_book_query_doc_pair_judgement_path(@book, @previous_judgement.query_doc_pair, @previous_judgement), method: :get, class: 'btn btn-sm btn-outline-secondary' %>
  <br>
<% end %>
<%= button_to 'Quit Judging', judge_overview_book_path(@book), method: :get, data: { turbo: false }, class: 'btn btn-sm btn-outline-secondary' %>

<br>

<%= button_to 'Unrate', book_judgement_path, method: :delete, data: { turbo: false }, class: 'btn btn-sm btn-outline-danger' %>

<br>
</turbo-frame>
