<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Quepid -- Relevant Search Solved</title>
    <%= favicon_link_tag asset_path "favicon.ico" %>
    <meta name="description" content="Tired of irrelevant search results? Use Quepid products & services to help improve the quality and relevancy of your search results.">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%= stylesheet_link_tag 'admin', media: 'all', 'data-turbo-track': 'reload' %>
    <%= csrf_meta_tags %>
    
    <%= javascript_importmap_tags 'application_modern' %>

  </head>
  <body class="d-flex flex-column min-vh-100" data-quepid-root-url="<%= quepid_root_url %>">
    <header>
      <%= render 'layouts/header' %>
    </header>

    <!-- Begin page content -->
    <%# Deliberately d-flex directly on container-fluid, not a nested .row: .row's
        "> *" rule forces width:100%/flex-shrink:0 on every direct child (assuming
        Bootstrap grid .col-* children), which fights a fixed-width sidebar +
        flex-grow content pane that isn't using grid columns. flex-grow-1 (on a
        flex-column body) lets this reach all the way down to the footer instead of
        only matching short page content - a child height:100% percentage wouldn't
        reliably resolve against that flexed height, so sidebar/main are direct
        flex children here rather than nested inside another block-level wrapper. %>
    <div class="container-fluid flex-grow-1 d-flex px-0">
      <%= render 'layouts/admin_sidebar' %>

      <main class="flex-grow-1 px-md-4 py-3" style="min-width: 0;">
        <%= yield %>
      </main>
    </div>

    <%= render 'layouts/footer' %>

  </body>
</html>
