<style>
/* position: sticky (not fixed) so the sidebar's box stays in normal flow —
 * its height matches the .row it's in (which stretches to match `main`'s
 * content height via flexbox's default align-items: stretch), instead of
 * always spanning the full viewport height regardless of page content.
 * A `fixed` sidebar with `bottom: 0` would otherwise sit next to the
 * footer at the bottom of short pages instead of ending above it, since
 * it's sized against the viewport rather than the actual content. */
.sidebar {
  position: sticky;
  top: 0;
  align-self: stretch;
  z-index: 99;
  padding: 0px 0 0;
  box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
}

@media (max-width: 767.98px) {
  .sidebar {
    top: 11.5rem;
    padding: 0;
  }
}


@media (min-width: 767.98px) {
  .navbar {
    top: 0;
    position: sticky;
    z-index: 999;
  }
}

.sidebar .nav-link {
  color: #333;
}

.sidebar .nav-link .feather {
  margin-right: 4px;
  color: #727272;
}

.sidebar .nav-link.active {
  color: #0d6efd;
}

.sidebar .nav-link:hover .feather,
.sidebar .nav-link.active .feather {
  color: inherit;
}

/* eric - this is the icon in the navbar placeholder */
.feather {
  width: 24px;
  height: 24px;
}
</style>
<div class="sidebar d-flex flex-column flex-shrink-0 bg-body-tertiary" style="width: 3.5rem;">
    <ul class="nav nav-pills flex-column mb-auto text-center">
      <%= render "layouts/sidebar_item", url: root_path, label: "Dashboard", icon: "bi-speedometer2",
                 active: make_active?({controller: 'home'}) %>
      <%= render "layouts/sidebar_item", url: cases_path, label: "Relevancy Cases", icon: "bi-briefcase",
                 active: make_active?({path: 'case'}), data: { turbo_prefetch: false } %>
      <%= render "layouts/sidebar_item", url: books_path, label: "Judgements", icon: "bi-book",
                 icon_label: "Judgement Books", active: make_active?({path: 'book'}) %>
      <%= render "layouts/sidebar_item", url: scorers_path, label: "Scorers", icon: "bi-list-task",
                 active: make_active?({path: 'scorers'}), data: { turbo_prefetch: false } %>
      <%= render "layouts/sidebar_item", url: "#{root_path}notebooks/lab/index.html", label: "Notebooks",
                 icon: "bi-journal-medical", active: false, icon_active: make_active?({path: 'case'}),
                 link_class: "nav-link py-3 border-bottom rounded-0",
                 target: "_blank", rel: "noopener noreferrer", data: { turbo: false } %>
      <%= render "layouts/sidebar_item", url: search_endpoints_path, label: "Search Endpoints", icon: "bi-send-fill",
                 active: make_active?({path: 'search_endpoint'}) %>
      <%= render "layouts/sidebar_item", url: ai_judges_path, label: "AI Judges", icon: "bi-robot",
                 active: make_active?({path: 'ai_judge'}), data: { turbo_prefetch: false } %>
      <% unless desktop_mode? %>
        <%= render "layouts/sidebar_item", url: teams_path, label: "Teams", icon: "bi-people-fill",
                   active: make_active?({path: 'teams'}), data: { turbo_prefetch: false } %>
      <% end %>
    </ul>
    <div class="dropdown border-top">
      <a href="#" class="d-flex align-items-center justify-content-center p-3 link-body-emphasis text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
        <%= image_tag current_user.avatar_url, size: '24x24', class: 'rounded-circle', alt:'Current user avatar' %>
      </a>
      <ul class="dropdown-menu shadow">
        <li><%= link_to "Create case...", case_new_path, class:'dropdown-item', data: { turbo: false } %></li>
        <li><%= link_to "Profile", profile_path, class:'dropdown-item' %></li>
        <li><hr class="dropdown-divider"></li>
        <li><%= button_to "Log out", logout_path, method: :delete, class: 'dropdown-item', form: { data: { turbo: false } } %></li>
      </ul>
    </div>
  </div>
