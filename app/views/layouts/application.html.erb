<% case_page = controller_name == "core" %>
<!DOCTYPE html>
<html lang="en">
<% if content_for?(:debug_info) %>
  <%= yield :debug_info %>
<% end %>
<head>
  <%= render 'layouts/head_common' %>
  <% if case_page %>
    <%= render 'layouts/case_head' %>
  <% else %>
  <%# Some legacy GET actions change state; defer speculative visits until those routes are audited. %>
  <meta name="turbo-prefetch" content="false">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <%= action_cable_meta_tag %>


<% if flash[:unfurl] %>
  <!-- We have unfurl -->

  <title>Quepid: Case <%= flash[:unfurl]["case_name"] %></title>

  <!-- facebook open graph tags -->
  <meta property="og:type" content="website">
  <% if flash[:unfurl]["id"] %>
    <meta property="og:url" content="<%= case_core_url(id: flash[:unfurl]["id"] ) %>">
  <% end %>
  <meta property="og:title" content="Case <%= flash[:unfurl]["case_name"] %>">
  <meta property="og:description" content="Case <%= flash[:unfurl]["case_name"] %> Description here.">
  <meta property="og:image" content="<%= image_url "quepid-icon.png" %>">

  <!-- twitter card tags additive with the og: tags -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:site" content="@quepid_search">
  <meta name="twitter:domain" value="<%= URI.parse(root_url).host %>">
  <meta name="twitter:title" value="Case <%= flash[:unfurl]["case_name"] %>">
  <meta name="twitter:description" value="Case <%= flash[:unfurl]["case_name"] %> Description here">
  <meta name="twitter:image" content="<%= image_url "quepid-icon.png" %>">
  <% if flash[:unfurl]["id"] %>
    <meta name="twitter:url" value="<%= case_core_url(id: flash[:unfurl]["id"] ) %>">
    <meta name="twitter:label1" value="Latest Try">
    <meta name="twitter:data1" value="<%= Case.find_by_id(flash[:unfurl]["id"]).tries.latest.try_number %>">
  <% end %>
<% else %>

  <title>Quepid -- Relevant Search Solved</title>

  <!-- facebook open graph tags -->
  <meta property="og:type" content="website">
  <meta name="twitter:site" content="@quepid_search">
  <meta property="og:url" content="<%= root_path %>">
  <meta property="og:title" content="Quepid -- Relevant Search Solved">
  <meta property="og:description" content="Tired of irrelevant search results? Use Quepid products & services to help improve the quality and relevancy of your search results.">
  <meta property="og:image" content="<%= image_url "quepid-icon.png" %>">

  <!-- twitter card tags additive with the og: tags -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:domain" value="<%= URI.parse(root_url).host %>">
  <meta name="twitter:title" value="Quepid -- Relevant Search Solved">
  <meta name="twitter:description" value="Tired of irrelevant search results? Use Quepid products & services to help improve the quality and relevancy of your search results.">
  <meta name="twitter:image" content="<%= image_url "quepid-icon.png" %>">
  <meta name="twitter:url" value="<%= root_url %>">
<% end %>

  <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
  <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>


  <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>

  <%= javascript_importmap_tags 'application' %>
  <%= debugbar_head  if defined? Debugbar %>

  <% end %>
</head>

<%
  body_attributes = if case_page
    { data: {
      controller:                          'snapshot-bridge core-bootstrap query-command-bridge',
      core_bootstrap_case_toolbar_outlet:  '#case-actions',
      core_bootstrap_case_no_value:        @case&.id || 0,
      # String.new drops html_safe so the JSON is attribute-escaped.
      core_bootstrap_initial_value:        String.new(render(partial: 'core/bootstrap', formats: [:json], locals: { kase: @case })),
      snapshot_bridge_snapshots_url_value: @case ? api_case_snapshots_path(@case) : '',
      # Preserve an explicitly requested missing try so core-bootstrap can report it.
      core_bootstrap_try_no_value:         params[:try_number].presence || @try&.try_number || '',
      quepid_root_url:                     quepid_root_url,
    } }
  else
    { class: 'd-flex flex-column min-vh-100',
      data:  { controller: 'page-cache', action: 'turbo:before-cache@document->page-cache#prepare', quepid_root_url: quepid_root_url } }
  end
%>
<body <%= tag.attributes(body_attributes) %>>

<% if case_page %>
  <%= render 'layouts/case_workspace', kase: @case %>
<% else %>
<%= render 'layouts/header', announcement: @announcement %>

<%# Continue the flex chain so the sidebar reaches the footer on short pages.
    Flex directly on the container, not a .row: .row's "> *" rule gives every
    child width:100%, which put main underneath the fixed-width sidebar below md. %>
<div class="container-fluid flex-shrink-0 flex-grow-1 d-flex ps-0">

  <% if @current_user  && !(controller_name == 'judgements' and ['new','edit'].any? params[:action]) %>
    <%= render(sidebar_partial) %>
  <% end %>

  <!-- Begin page content -->
  <main class="flex-grow-1 ps-3 px-md-5" style="min-width: 0;">
    <%= yield %>
  </main>
</div>

<%= render 'layouts/footer' %>
<%= render 'shared/confirm_modal' %>

<%= debugbar_body if defined? Debugbar %>
<% end %>
</body>
</html>
