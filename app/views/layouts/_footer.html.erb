<footer class="py-2 mt-auto bg-body-tertiary">
  <div class="container">
    <div class="row">
      <div class="col-md-12 text-center">
        <%= render 'shared/osc_copyright', link_class: nil, separator: nil, open_in_new_tab: true %>

        <% footer_items = [
          { html: "Quepid Version <code>#{Rails.application.config.quepid_version}</code>".html_safe },
          {
            url: Rails.application.config.terms_and_conditions_url,
            text: 'Terms & Conditions',
          },
          {
            url: Rails.application.config.privacy_url,
            text: 'Privacy Policy',
          },
          {
            url: Rails.application.config.cookies_url,
            text: 'Cookies Policy',
          },
          {
            url: oas_rails_path,
            text: 'API',
          },
        ] %>

        <% footer_items.each do |item| %>
          <% next if item[:html].blank? && item[:url].blank? %>
          &nbsp;&mdash;&nbsp;
          <% if item[:html] %>
            <small><%= item[:html] %></small>
          <% else %>
            <a href="<%= item[:url] %>" target="_blank" rel="noopener noreferrer"><%= item[:text] %></a>
          <% end %>
        <% end %>
      </div>

      <div class="col-md-12 text-center">
        <p class="mb-0">
          For community support and discussion please join us in the #Quepid channel on Relevancy Slack at
          <a href="http://www.opensourceconnections.com/slack" target="_blank" rel="noopener noreferrer">
            www.opensourceconnections.com/slack
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
