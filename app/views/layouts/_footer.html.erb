<footer class="py-2 mt-auto bg-body-tertiary">
  <div class="container">
    <div class="row">
      <div class="col-md-12 text-center">
        &copy; <%= Time.zone.now.year %>
        <%= link_to 'http://opensourceconnections.com', target: '_blank', rel: 'noopener noreferrer' do %>
          <%= image_tag "OSC-icon.png", width: 24, alt: "OpenSource Connections icon" %>
          OpenSource Connections, LLC
        <% end %>

        &nbsp;&mdash;&nbsp;
        <small>Quepid Version <code><%= Rails.application.config.quepid_version %></code></small>

        <% footer_links = [
          {
            url: Rails.application.config.terms_and_conditions_url,
            text: 'Terms & Conditions',
          },
          {
            url: Rails.application.config.privacy_url,
            text: 'Privacy Policy',
          },
          {
            url: Rails.application.config.cookies_url,
            text: 'Cookies Policy',
          },
          {
            url: oas_rails_path,
            text: 'API',
          },
        ] %>

        <% footer_links.each do |link| %>
          <% next if link[:url].blank? %>
          &nbsp;&mdash;&nbsp;
          <a href="<%= link[:url] %>" target="_blank" rel="noopener noreferrer"><%= link[:text] %></a>
        <% end %>
      </div>

      <div class="col-md-12 text-center">
        <p class="mb-0">
          For community support and discussion please join us in the #Quepid channel on Relevancy Slack at
          <a href="http://www.opensourceconnections.com/slack" target="_blank" rel="noopener noreferrer">
            www.opensourceconnections.com/slack
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
