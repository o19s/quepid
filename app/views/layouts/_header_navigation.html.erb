<%# Core frames use hard-navigation links; only core includes active counts,
    the wizard launcher, and case-derived book parameters. %>
<ul class="navbar-nav me-auto">
  <% %i[cases books].each do |section| %>
    <% cases_menu = section == :cases %>
    <% toggle_id = cases_menu ? 'dropdownCases' : 'dropdownBooks' %>
    <li class="nav-item dropdown">
      <%= tag.a href: '#', id: toggle_id, role: 'button', class: 'nav-link dropdown-toggle',
                data: { bs_toggle: 'dropdown' }, aria: { expanded: 'false' } do %>
        <span class="nav-label"><%= cases_menu ? 'Relevancy Cases' : 'Books' %></span>
        <% if case_page %><i class="bi bi-chevron-down"></i><% end %>
      <% end %>

      <%= tag.ul class: class_names('dropdown-menu', 'p-2': !case_page),
                 style: ('left: auto; width:250px;' unless case_page),
                 aria: { labelledby: toggle_id } do %>
        <li class="text-muted">
          <% recent_label = "RECENT #{section.to_s.upcase}" %>
          <%= case_page ? tag.strong(recent_label) : recent_label %>
        </li>
        <li><hr class="dropdown-divider"></li>

        <% dropdown_url = if cases_menu
             case_page ? dropdown_cases_core_path : dropdown_cases_path
           else
             case_page ? dropdown_books_core_path : dropdown_books_path
           end %>
        <turbo-frame id="dropdown_<%= section %>" src="<%= dropdown_url %>" loading="lazy">
        </turbo-frame>

        <li class="actions">
          <% if case_page %>
            <%= render 'layouts/header_core_actions', cases_menu: cases_menu, section: section, kase: kase %>
          <% else %>
            <%= render 'layouts/header_management_actions', cases_menu: cases_menu %>
          <% end %>
        </li>
      <% end %>
    </li>
  <% end %>

  <% unless desktop_mode? %>
    <li class="nav-item"><%= link_to "Teams", teams_path, class: "nav-link" %></li>
  <% end %>
  <li class="nav-item"><%= link_to "AI Judges", ai_judges_path, class: "nav-link" %></li>
  <li class="nav-item"><%= link_to "Scorers", scorers_path, class: "nav-link" %></li>
  <li class="nav-item"><a class="nav-link" href="<%= root_path %>notebooks/lab/index.html" target="_blank" rel="noopener noreferrer">Notebooks</a></li>
</ul>
