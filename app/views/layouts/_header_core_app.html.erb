<header id="header" class="navbar navbar-secondary navbar-expand-lg navbar-dark">
  <div class="container-fluid container-home">
    <%= link_to root_path, class: "navbar-brand", target: "_self" do %>
      Quepid
      <span class="hover"><%= image_tag 'tagline-sm.png', title: "Give your queries some love" %></span>
    <% end %>

    <% if current_user.present? %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#coreNavbarContent" aria-controls="coreNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="coreNavbarContent">
      <ul class="navbar-nav me-auto">
        <!--
          Begin case selector. Server-rendered (was Angular HeaderCtrl). Same interaction model
          (lazy-loaded Turbo Frame list, full-page link) as the Rails-page navbar's `dropdown/cases`
          frame (`_header.html.erb`), but with `dropdown#cases_core`/`cases_core.html.erb` as the
          core-specific twin: same list, links do a hard navigation (`turbo: false`) instead of a
          Turbo AJAX visit, since AJAX-swapping this page's body would leave Angular running against
          the old case - see config/routes.rb. The "(N active)" count and "Create a book"'s
          case-derived query params are core-only additions that Angular showed but the Rails-page
          navbar doesn't - see docs/todo/angularjs_removal_inventory.md.
        -->
        <li class="nav-item dropdown">
          <a href="#" role="button" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="nav-label">Relevancy Cases</span>
            <i class="bi bi-chevron-down"></i>
          </a>

          <ul class="dropdown-menu">
            <li class="text-muted">
              <strong>RECENT CASES</strong>
            </li>
            <li><hr class="dropdown-divider"></li>

            <turbo-frame id="dropdown_cases" src="<%= dropdown_cases_core_path %>" loading="lazy">
            </turbo-frame>

            <li class="actions">
              <a href="cases" class="btn btn-outline-secondary w-100" target="_self">
                View all cases
                <small class="text-muted">
                  (<%= current_user.cases_involved_with.not_archived.count %> active)
                </small>
              </a>

              <new-case button-text="'Create a case'"></new-case>
            </li>
          </ul>
        </li>
        <!-- End case selector -->
        <!-- Begin book selector -->
        <li class="nav-item dropdown">
          <a href="#" role="button" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="nav-label">Books</span>
            <i class="bi bi-chevron-down"></i>
          </a>

          <ul class="dropdown-menu">
            <li class="text-muted">
              <strong>RECENT BOOKS</strong>
            </li>
            <li><hr class="dropdown-divider"></li>

            <turbo-frame id="dropdown_books" src="<%= dropdown_books_core_path %>" loading="lazy">
            </turbo-frame>

            <li class="actions">
              <a href="books" class="btn btn-outline-secondary w-100" target="_self">
                View all books
                <small class="text-muted">
                  (<%= current_user.books_involved_with.count %> active)
                </small>
              </a>

              <% if kase.present? %>
                <%= link_to new_book_path(scorer_id: kase.scorer_id, team_ids: kase.teams.map(&:id), origin_case_id: kase.id), class: "btn btn-success w-100", target: "_self" do %>
                  <i class="bi bi-plus-lg"></i>
                  Create a book
                <% end %>
              <% else %>
                <%= link_to new_book_path, class: "btn btn-success w-100", target: "_self" do %>
                  <i class="bi bi-plus-lg"></i>
                  Create a book
                <% end %>
              <% end %>
            </li>
          </ul>
        </li>
        <!-- End book selector -->

        <li class="nav-item"><a class="nav-link" href="teams" target="_self">Teams</a></li>
        <li class="nav-item"><a class="nav-link" href="scorers" target="_self">Scorers</a></li>
        <li class="nav-item"><a class="nav-link" href="notebooks/lab/index.html" target="_blank" rel="noopener noreferrer">Notebooks</a></li>
      </ul>

      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" href='https://quepid-docs.dev.o19s.com/2/quepid' target="_blank" rel="noopener noreferrer">
            User Manual
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href='https://github.com/o19s/quepid/wiki' target="_blank" rel="noopener noreferrer">
            Wiki
          </a>
        </li>
      </ul>

      <ul class="navbar-nav">
        <!-- Begin account management dropdown -->
        <li class="nav-item dropdown">
          <a href="#" role="button" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <%= image_tag current_user.avatar_url, size: '24x24', class: 'rounded', title: 'Avatar image' %>
            <span data-display-name><%= current_user.display_name %> </span>
            <i class="bi bi-chevron-down"></i>
          </a>

          <ul class="dropdown-menu">
            <%= render 'shared/account_dropdown', divider: account_dropdown_divider(:separator) %>
          </ul>
        </li> <!-- End account management -->
      </ul>
      </div>
    <% end %>
  </div>
</header>
