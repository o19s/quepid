<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Quepid -- Relevant Search Solved</title>
<%= favicon_link_tag asset_path "favicon.ico" %>
<meta name="description" content="Tired of irrelevant search results? Use Quepid to help improve the quality and relevancy of your search results.">
<meta name="viewport" content="width=device-width">

<%= stylesheet_link_tag 'core', media: 'all' %>
<%= stylesheet_link_tag 'json-explorer', media: 'all' %>
<%= csrf_meta_tags %>
<%= javascript_importmap_tags 'vega_globals' %>
<%= javascript_import_module_tag 'bootstrap_globals' %>
<%= javascript_import_module_tag 'core_stimulus' %>

<base href="<%= ENV['RAILS_RELATIVE_URL_ROOT'] %>/">
</head>
<body data-controller="snapshot-bridge core-bootstrap query-command-bridge"
      data-core-bootstrap-case-no-value="<%= @case&.id || 0 %>"
      <%# Preserve an explicitly requested missing try so core-bootstrap can report it. %>
      data-core-bootstrap-try-no-value="<%= params[:try_number].presence || @try&.try_number || '' %>"
      data-core-bootstrap-communal-scorers-only-value="<%= Rails.application.config.communal_scorers_only %>"
      data-core-bootstrap-query-list-sortable-value="<%= Rails.application.config.query_list_sortable %>"
      data-quepid-root-url="<%= quepid_root_url %>"
      data-frog-report-refresh-url-template="<%= api_book_refresh_path(book_id: '__BOOK_ID__', case_id: '__CASE_ID__', create_missing_queries: 'false', process_in_background: '__BACKGROUND__') %>">
  <%= render 'layouts/header_core_app', kase: @case %>

  <div id="main-content">
    <%= yield %>
  </div>

  <%= render 'shared/share_case_core_modal' %>
  <%= render 'shared/delete_case_options_core_modal' %>
  <%= render 'shared/clone_case_core_modal' %>
  <%= render 'shared/export_case_core_modal' %>
  <%= render 'shared/pick_scorer_core_modal' %>
  <%= render 'shared/take_snapshot_core_modal' %>
  <%= render 'shared/judgements_core_modal' %>
  <%= render 'core/diff_modal', kase: @case %>
  <%= render 'shared/move_query_core_modal' %>
  <%= render 'shared/dynamic_modal_templates' %>

  <%= render 'layouts/footer_core_app' %>

  <%= javascript_include_tag 'jquery_bundle' %>
  <%= javascript_include_tag 'case_runtime' %>
  <%= javascript_include_tag 'core_vendor' %>
  <%= javascript_include_tag 'core_legacy' %>

</body>
</html>
