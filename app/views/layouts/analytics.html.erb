<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Quepid -- Relevant Search Solved</title>
    <%= favicon_link_tag asset_path "favicon.ico" %>
    <meta name="description" content="Tired of irrelevant search results? Use Quepid products & services to help improve the quality and relevancy of your search results.">
    <meta name="viewport" content="width=device-width">

    <%= stylesheet_link_tag 'application', media: 'all' %>
    <%= csrf_meta_tags %>
    <%= javascript_importmap_tags 'vega_globals' %>
    <%= javascript_include_tag 'analytics' %>
  </head>
  <body class="d-flex flex-column h-100">
    <header>
      <%= render 'layouts/header' %>
      <% if @case.public? %>
        <script>
          document.addEventListener('DOMContentLoaded', function() {
            new ClipboardJS('#public-url');
          });
        </script>
      <% end %>
      <% if @case.public? || @current_user %>
        <div class="container d-flex align-items-center gap-2 py-2">
          <% if @case.public? %>
            <h3 class="public-share mb-0">
              <a id="public-url" href="#" data-clipboard-text="<%= analytics_tries_visualization_path(@case.public_id) %>">
                <span class="badge bg-success">Public</span>
                <i
                  class="clipboard-icon bi bi-clipboard"
                  aria-hidden="true"
                  title="Copy public url to your clipboard"
                  alt="Copy public url to your clipboard"
                ></i>
              </a>
            </h3>
          <% end %>
          <% if @current_user %>
            <%= button_to (@case.public? ? 'Make Private' : 'Make public'), analytics_case_visibility_path(@case), method: :patch, class: 'btn btn-outline-warning btn-sm mb-0' %>
          <% end %>
        </div>
      <% end %>
    </header>

    <!-- Begin page content -->
    <main class="flex-shrink-0">
      <div class="container">
        <%= yield %>
      </div>
    </main>

    <%= render 'layouts/footer' %>

  </body>
</html>
