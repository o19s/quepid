<a href="<%= cases_menu ? cases_path : books_path %>" class="btn btn-outline-secondary w-100">
  View all <%= section %>
  <small class="text-muted">
    (<%= cases_menu ? current_user.cases_involved_with.not_archived.count : current_user.books_involved_with.count %> active)
  </small>
</a>

<% if cases_menu %>
  <button
    type="button"
    class="btn btn-success w-100"
    data-controller="wizard-launcher"
    data-action="click->wizard-launcher#newCase"
    data-wizard-launcher-create-url-value="<%= case_new_path.delete_prefix('/') %>"
  >
    <i class="bi bi-plus-lg"></i>
    Create a case
  </button>
<% else %>
  <% new_book_params = kase.present? ? { scorer_id: kase.scorer_id, team_ids: kase.teams.map(&:id), origin_case_id: kase.id } : {} %>
  <%= link_to new_book_path(new_book_params), class: "btn btn-success w-100" do %>
    <i class="bi bi-plus-lg"></i>
    Create a book
  <% end %>
<% end %>
