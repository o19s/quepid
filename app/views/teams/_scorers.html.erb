<%# locals: (filters:, pagy_scorers:, scorer_cases_counts:, scorers:, team:) %>
<%= render layout: 'teams/section',
           locals: { team: team, section: :scorers, title: 'Custom Scorers', filters: filters, pagy: pagy_scorers,
                     empty: scorers.empty?, placeholder: 'Filter scorers by name', search_label: 'Search scorers',
                     title_link: [ 'See communal scorers', scorers_path ] } do %>
  <table class="table table-sm table-hover">
    <thead>
      <tr>
        <th>Name</th>
        <th>Scale</th>
        <th>Owner</th>
        <th>Shared</th>
        <th class="text-end"></th>
      </tr>
    </thead>
    <tbody>
      <% scorers.each do |scorer| %>
        <tr>
          <td><%= link_to scorer.name, edit_scorer_path(scorer) %></td>
          <td><%= scorer.scale_list || '—' %></td>
          <td><%= scorer.owner&.fullname || '—' %></td>
          <td>
            <span class="badge rounded-pill bg-secondary"><%= scorer_cases_counts.fetch(scorer.id, 0) %> Cases</span>
            <span class="badge rounded-pill bg-secondary"><%= scorer.teams.length %> Teams</span>
          </td>
          <td class="text-end">
            <div class="btn-group btn-group-sm" role="group">
              <%= share_modal_button 'scorer', scorer, name: scorer.name, button_class: 'me-2',
                                     url: share_modal_path('scorer', scorer, team_id: team.id) %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
