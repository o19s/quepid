<%# locals: (book_cases_counts:, book_judgements_counts:, books:, filters:, pagy_books:, team:) %>
<%= render layout: 'teams/section',
           locals: { team: team, section: :books, title: 'Books', filters: filters, pagy: pagy_books, empty: books.empty?,
                     placeholder: 'Filter books by name', search_label: 'Search books',
                     archived_label: 'Archived Books' } do %>
  <table class="table table-sm table-hover">
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Number of ...</th>
        <th>Owner</th>
        <th>Shared</th>
        <th class="text-end"></th>
      </tr>
    </thead>
    <tbody>
      <% books.each do |book| %>
        <tr>
          <td><%= book.id %></td>
          <td><%= link_to book.name, book_path(book) %></td>
          <td>
            <span class="badge bg-primary rounded-pill"><%= book.query_doc_pairs_count %> Query/Doc Pairs</span>
            <span class="badge bg-primary rounded-pill"><%= book_judgements_counts.fetch(book.id, 0) %> Judgements</span>
          </td>
          <td><%= book.owner&.fullname || '—' %></td>
          <td>
            <span class="badge rounded-pill bg-secondary"><%= book_cases_counts.fetch(book.id, 0) %> Cases</span>
            <span class="badge rounded-pill bg-secondary"><%= book.teams.length %> Teams</span>
          </td>
          <td class="text-end">
            <div class="btn-group btn-group-sm" role="group">
              <%= share_modal_button 'book', book, name: book.name, button_class: 'me-2' %>

              <%= archive_toggle_button book, name: book.name, method: :patch,
                                        urls: { archive: archive_book_path(book), unarchive: unarchive_book_path(book) } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
