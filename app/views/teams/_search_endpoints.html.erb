<div class="card">
  <div class="card-body">
    <h5 class="card-title">
      Search Endpoints 
      <small class="text-muted ms-2">
        <%= link_to "See all search endpoints", search_endpoints_path, class: "text-decoration-none" %>
      </small>
    </h5>
    <div class="mb-3">
      <%= render layout: "shared/index_filters", locals: { url: team_path(@team), variant: :team, search_name: :search_endpoints_q, search_value: @search_endpoints_q, placeholder: "Filter search endpoints by name or URL", small: false, search_label: "Search search endpoints" } do %>
        <div class="col-auto form-check form-check-inline mb-0 ms-3 ms-md-4">
          <%= check_box_tag :search_endpoints_archived, '1', @search_endpoints_archived, class: 'form-check-input', id: 'search-endpoints-archived-checkbox', data: { controller: "auto-submit", action: "change->auto-submit#submit" } %>
          <%= label_tag 'search-endpoints-archived-checkbox', 'Archived Search Endpoints', class: 'form-check-label ms-2' %>
        </div>
        <%# Preserve other filters when submitting search endpoints form %>
        <% if @cases_q.present? %>
          <%= hidden_field_tag :cases_q, @cases_q %>
        <% end %>
        <% if @cases_archived %>
          <%= hidden_field_tag :cases_archived, '1' %>
        <% end %>
        <% if @books_q.present? %>
          <%= hidden_field_tag :books_q, @books_q %>
        <% end %>
        <% if @books_archived %>
          <%= hidden_field_tag :books_archived, '1' %>
        <% end %>
        <% if @scorers_q.present? %>
          <%= hidden_field_tag :scorers_q, @scorers_q %>
        <% end %>
      <% end %>
    </div>

    <div class="table-responsive">
      <table class="table table-sm table-hover">
        <thead>
          <tr>
            <th>Name</th>
            <th>Search Engine</th>
            <th>Endpoint URL</th>
            <th>API Method</th>
            <th>Owner</th>            
            <th>Shared</th>
            <th class="text-end"></th>
          </tr>
        </thead>
        <tbody>
          <% @search_endpoints.each do |search_endpoint| %>
            <tr>
              <td>
                <%= link_to search_endpoint.name.presence || search_endpoint.fullname, search_endpoint_path(search_endpoint) %>
              </td>
              <td>
                <span class="badge bg-secondary">
                  <% if search_endpoint.search_engine %>
                    <%= image_tag "#{search_endpoint.mapper_based_search_engine&.id || search_endpoint.search_engine}-icon.png", size:'16x16', class:'rounded-circle me-1' %>
                  <% end %>
                  <%= search_endpoint.mapper_based_search_engine&.name || search_endpoint.search_engine&.titleize || '—' %>
                </span>
              </td>
              <td>
                <small class="text-muted"><%= truncate(search_endpoint.endpoint_url, length: 50) %></small>
              </td>
              <td>
                <span class="badge bg-info text-dark"><%= search_endpoint.api_method || '—' %></span>
              </td>
              <td><%= search_endpoint.owner&.fullname || '—' %></td>  
              <td>
                <span class="badge rounded-pill bg-secondary"><%= @search_endpoint_cases_counts.fetch(search_endpoint.id, 0) %> Cases</span>
                <span class="badge rounded-pill bg-secondary"><%= search_endpoint.teams.length %> Teams</span>
              </td>            
              <td class="text-end">
                <div class="btn-group btn-group-sm" role="group">
                  <%= button_tag type: 'button',
                                 class: 'btn btn-link p-0 me-2',
                                 title: 'Share',
                                 'aria-label': 'Share',
                                 data: {
                                   bs_toggle: 'modal',
                                   bs_target: '#shareSearchEndpointModal',
                                   share_search_endpoint_id_value: search_endpoint.id,
                                   share_search_endpoint_name_value: search_endpoint.fullname,
                                   share_search_endpoint_url_value: share_modal_path('search_endpoint', search_endpoint)
                                 } do %>
                    <i class="bi bi-share" aria-hidden="true"></i>
                  <% end %>

                  <% if search_endpoint.archived? %>
                    <%= group_button_to unarchive_search_endpoint_team_path(@team, search_endpoint_id: search_endpoint.id),
                                        method: :post,
                                        button_class: "text-success p-0 me-3",
                                        title: "Unarchive search endpoint",
                                        aria: { label: "Unarchive search endpoint" },
                                        confirm: "Unarchive #{search_endpoint.fullname}?",
                                        confirm_style: "primary" do %>
                      <i class="bi-folder-check" aria-hidden="true"></i>
                      <span class="visually-hidden">Unarchive search endpoint</span>
                    <% end %>
                  <% else %>
                    <%= group_button_to archive_search_endpoint_team_path(@team, search_endpoint_id: search_endpoint.id),
                                        method: :post,
                                        button_class: "text-warning p-0 me-3",
                                        title: "Archive search endpoint",
                                        aria: { label: "Archive search endpoint" },
                                        confirm: "Archive #{search_endpoint.fullname}?" do %>
                      <i class="bi-folder-check" aria-hidden="true"></i>
                      <span class="visually-hidden">Archive search endpoint</span>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if (@search_endpoints || []).empty? %>
        <div class="text-center text-muted py-3">
          <p>No search endpoints found for this team.</p>
        </div>
      <% end %>

      <% if defined?(pagy_nav) && @pagy_search_endpoints %>
        <div class="mt-2">
          <%= pagy_nav(@pagy_search_endpoints) %>
        </div>
      <% end %>
    </div>
  </div>
</div>
