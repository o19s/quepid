<%# locals: (filters:, pagy_search_endpoints:, search_endpoint_cases_counts:, search_endpoints:, team:) %>
<%= render layout: 'teams/section',
           locals: { team: team, section: :search_endpoints, title: 'Search Endpoints', filters: filters,
                     pagy: pagy_search_endpoints, empty: search_endpoints.empty?,
                     placeholder: 'Filter search endpoints by name or URL', search_label: 'Search search endpoints',
                     archived_label: 'Archived Search Endpoints',
                     title_link: [ 'See all search endpoints', search_endpoints_path ] } do %>
  <table class="table table-sm table-hover">
    <thead>
      <tr>
        <th>Name</th>
        <th>Search Engine</th>
        <th>Endpoint URL</th>
        <th>API Method</th>
        <th>Owner</th>
        <th>Shared</th>
        <th class="text-end"></th>
      </tr>
    </thead>
    <tbody>
      <% search_endpoints.each do |search_endpoint| %>
        <tr>
          <td>
            <%= link_to search_endpoint.name.presence || search_endpoint.fullname, search_endpoint_path(search_endpoint) %>
          </td>
          <td>
            <span class="badge bg-secondary">
              <% if search_endpoint.search_engine %>
                <%= image_tag "#{search_endpoint.mapper_based_search_engine&.id || search_endpoint.search_engine}-icon.png", size:'16x16', class:'rounded-circle me-1' %>
              <% end %>
              <%= search_endpoint.mapper_based_search_engine&.name || search_endpoint.search_engine&.titleize || '—' %>
            </span>
          </td>
          <td>
            <small class="text-muted"><%= truncate(search_endpoint.endpoint_url, length: 50) %></small>
          </td>
          <td>
            <span class="badge bg-info text-dark"><%= search_endpoint.api_method || '—' %></span>
          </td>
          <td><%= search_endpoint.owner&.fullname || '—' %></td>
          <td>
            <span class="badge rounded-pill bg-secondary"><%= search_endpoint_cases_counts.fetch(search_endpoint.id, 0) %> Cases</span>
            <span class="badge rounded-pill bg-secondary"><%= search_endpoint.teams.length %> Teams</span>
          </td>
          <td class="text-end">
            <div class="btn-group btn-group-sm" role="group">
              <%= share_modal_button 'search_endpoint', search_endpoint, name: search_endpoint.fullname, button_class: 'me-2' %>

              <%= archive_toggle_button search_endpoint, name: search_endpoint.fullname,
                                        urls: { archive: archive_search_endpoint_team_path(team, search_endpoint_id: search_endpoint.id),
                                                unarchive: unarchive_search_endpoint_team_path(team, search_endpoint_id: search_endpoint.id) } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
