<%# locals: (cases:, filters:, last_scores:, pagy_cases:, ratings_counts:, team:) %>
<%= render layout: 'teams/section',
           locals: { team: team, section: :cases, title: 'Cases', filters: filters, pagy: pagy_cases, empty: cases.empty?,
                     placeholder: 'Filter by case name or id', search_label: 'Search', small: true,
                     archived_label: 'Archived Cases' } do %>
  <table class="table table-sm table-hover">
    <thead>
      <tr>
        <th>ID</th>
        <th>Case Title</th>
        <th>Last Try #</th>
        <th># of Queries</th>
        <th>Last Score</th>
        <th>Last Run On</th>
        <th>Last Run By</th>
        <th>Associated Judgements</th>
        <th>Owner</th>
        <th>Shared</th>
        <th class="text-end"></th>
      </tr>
    </thead>
    <tbody>
      <% cases.each do |kase| %>
        <% last_score = last_scores[kase.id] %>
        <tr>
          <td><%= kase.id %></td>
          <td><%= link_to kase.case_name, case_core_path(kase) %></td>
          <td><%= kase.last_try_number || (kase.tries.first&.try_number) %></td>
          <td><%= kase.respond_to?(:queries_count) ? kase.queries_count : kase.queries.size %></td>
          <td>
            <% if last_score.present? %>
              <%= number_with_precision(last_score.score || 0, precision: 3) %>
            <% else %>
              Never Run
            <% end %>
          </td>
          <td>
            <% if last_score.present? && last_score.updated_at.present? %>
              <%= l(last_score.updated_at, format: :short) %>
            <% else %>
              —
            <% end %>
          </td>
          <td>
            <% if last_score.present? %>
              <%= last_score.user&.fullname || 'System' %>
            <% else %>
              —
            <% end %>
          </td>
          <td><%= ratings_counts.fetch(kase.id, 0) %></td>
          <td><%= kase.owner&.fullname || '—' %></td>
          <td>
            <span class="badge rounded-pill bg-secondary"><%= kase.teams.length %> Teams</span>
          </td>
          <td class="text-end">
            <div class="btn-group btn-group-sm" role="group">
              <%= share_modal_button 'case', kase, name: kase.case_name, button_class: 'me-2' %>

              <%= archive_toggle_button kase, name: kase.case_name,
                                        urls: { archive: archive_case_team_path(team, case_id: kase.id),
                                                unarchive: unarchive_case_team_path(team, case_id: kase.id) } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
