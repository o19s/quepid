<%= page_header "Teams" do %>
  <div class="btn-toolbar mb-2 mb-md-0">
    <div class="btn-group me-2">
      <%= link_to '+ Add New', new_team_path, class: 'btn btn-success' %>
    </div>
  </div>
<% end %>

<div class="card">
  <div class="card-header">
    <%= render "shared/index_filters",
      url: teams_path, placeholder: "Filter by name",
      checkboxes: [{ name: :member, value: true, checked: params[:member].present?, label: 'My Teams' }] %>
  </div>

  <div class="card-body">
    <div class="table-responsive">
    <table class="table table-hover table-sm">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th class="text-center">Members</th>
          <th class="text-center">Cases</th>
        </tr>
      </thead>
      <tbody>
        <% @teams.each do |team| %>
          <tr>
            <td><%= team.id %></td>
            <td><%= link_to team.name, team_path(team) %></td>
            <td class="text-center"><%= team.members.count %></td>
            <td class="text-center"><%= team.cases.count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
  <%= render "shared/index_pagination", pagy: @pagy %>
</div>
