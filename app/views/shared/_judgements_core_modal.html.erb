<%# Core case toolbar — judgements / book link modal. Mirrors AngularJS
    judgements/_modal.html. Populate-from-case still bridges to Angular
    queriesSvc via `judgements:populate-book`. %>
<% modal_footer = capture do %>
  <div class="d-flex gap-2 me-auto">
    <a class="btn btn-primary" target="_self"
       data-judgements-core-target="createBookLink actionButton">
      <i class="bi bi-plus" style="color: #FFF"></i>
      Create a book
    </a>

    <a class="btn btn-outline-secondary d-none" target="_self"
       data-judgements-core-target="judgeLink actionButton">
      <i class="bi bi-book-fill"></i>
      Judge Documents!
    </a>
  </div>
  <button type="button" class="btn btn-success d-none"
          data-judgements-core-target="saveButton"
          data-action="click->judgements-core#save">
    Save
  </button>
  <div class="d-none" data-judgements-core-target="progress">
    Dealing with judgements (this can take a minute or so)
  </div>
<% end %>

<% modal_body = capture do %>
  <div class="d-none" data-judgements-core-target="loading">
    <p>
      Loading your teams, this will be quick I promise!
      <i class="bi bi-arrow-repeat spintime"></i>
    </p>
  </div>
  <p>
    Explicit Judgements created by humans and <i class="bi bi-robot"></i> LLMs are a good way to start measuring your search quality.
  </p>
  <p>
    Quepid organizes Judgements in a <strong>Book</strong> that consists of query and document pairs for human evaluation.
  </p>
  <p>
    <strong>Select a Book below</strong> and configure how data syncs between your Case and Book.
    <a href="https://quepid-docs.dev.o19s.com/2/quepid/64/thinking-about-cases-and-books-of-judgements" target="_blank" rel="noopener noreferrer">
      Learn more <i class="bi bi-box-arrow-up-right"></i>
    </a>
  </p>

  <div class="alert alert-info text-center d-none" role="alert" data-judgements-core-target="noTeams">
    <p>
      Judgements are meant to be shared with a team, so either
      <a href="#" data-action="click->judgements-core#goToTeamsPage">create a new team</a>
      or
      <a href="#" data-action="click->judgements-core#openShareCase">share case</a> first.
    </p>
  </div>

  <div class="text-center d-none" data-judgements-core-target="noBooks">
    <p>
      You have not created any Books of Judgements yet, so go ahead and create a new Book!
    </p>

    <a class="btn btn-primary btn-lg" target="_self"
       data-judgements-core-target="createBookEmptyLink">
      <i class="bi bi-plus-lg"></i>
      Create a book
    </a>
  </div>

  <div class="d-none" data-judgements-core-target="bookPicker">
    <div>
      <label>Select a Book of Judgements
        <i class="bi bi-question-circle-fill" tabindex="0" role="button" aria-label="Help"
           data-controller="bs-popover" data-bs-popover-trigger-value="mouseenter"
           data-bs-popover-placement-value="right"
           data-bs-popover-content-value="All the Books related to all the Teams this Case has been shared with are listed below.  If you don't see the Book you want, check that you shared the Case with the right Team."></i>
      </label>

      <ul class="list-group" data-judgements-core-target="bookList"></ul>
    </div>
  </div>

  <div class="alert alert-info d-none mt-3" data-judgements-core-target="selectHint">
    <i class="bi bi-info-circle-fill"></i> Select a book above to configure sync settings.
  </div>

  <div class="d-none" data-judgements-core-target="integration">
    <hr>
    <h4>Case Integration</h4>

    <div class="card">
      <div class="card-body">
        <div class="alert alert-info" role="alert">
          <strong>About Book-Case Synchronization:</strong> Books and Cases can share data bi-directionally.
          Your Case provides query/doc pairs to judge, while Book judgements flow back as ratings.
          <a href="https://quepid-docs.dev.o19s.com/2/quepid/64/thinking-about-cases-and-books-of-judgements" target="_out">
            Learn more <i class="bi bi-arrow-up-right-circle"></i>
          </a>
        </div>
        <div class="row">
          <div class="col-sm-8">
            <label>
              <input type="checkbox" data-judgements-core-target="autoPopulateBookPairs"
                     data-action="change->judgements-core#toggleAutoPopulateBookPairs">
              Case <i class="bi bi-arrow-right"></i> Book: Query/Doc Pairs
              <i class="bi bi-question-circle-fill" tabindex="0" role="button" aria-label="Help"
                 data-controller="bs-popover" data-bs-popover-trigger-value="mouseenter"
                 data-bs-popover-placement-value="right"
                 data-bs-popover-content-value="When enabled, new query/doc pairs are automatically sent to the Book whenever searches run in this Case."></i>
            </label>
            <p class="text-muted small">
              <strong>On:</strong> New query/doc pairs automatically added to Book when Case runs.<br>
              <strong>Off:</strong> Manually trigger updates to the Book when needed.
            </p>
          </div>
          <div class="col-sm-4 text-end">
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-judgements-core-target="actionButton"
                    data-action="click->judgements-core#manualPopulateBook">
              <i class="bi bi-box-arrow-up"></i> Populate Now
            </button>
          </div>
        </div>

        <hr class="my-2">

        <div class="row">
          <div class="col-sm-8">
            <label>
              <input type="checkbox" data-judgements-core-target="autoPopulateCaseJudgements"
                     data-action="change->judgements-core#toggleAutoPopulateCaseJudgements">
              Case <i class="bi bi-arrow-left"></i> Book: Judgement Ratings
              <i class="bi bi-question-circle-fill" tabindex="0" role="button" aria-label="Help"
                 data-controller="bs-popover" data-bs-popover-trigger-value="mouseenter"
                 data-bs-popover-placement-value="right"
                 data-bs-popover-content-value="When enabled, Case ratings are updated as judgements are made in the Book."></i>
            </label>
            <p class="text-muted small">
              <strong>On:</strong> Case ratings update immediately as judgements are made.<br>
              <strong>Off:</strong> Manually import judgements when ready to test.
            </p>
          </div>
          <div class="col-sm-4 text-end">
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-judgements-core-target="actionButton"
                    data-action="click->judgements-core#manualRefreshRatings">
              <i class="bi bi-box-arrow-in-down"></i> Refresh Ratings
            </button>
          </div>
        </div>
        <hr class="my-2">

        <div class="row">
          <div class="col-sm-8">
            <label>
              Case <i class="bi bi-arrow-left"></i> Book: Sync missing queries from Book to Case
              <i class="bi bi-question-circle-fill" tabindex="0" role="button" aria-label="Help"
                 data-controller="bs-popover" data-bs-popover-trigger-value="mouseenter"
                 data-bs-popover-placement-value="right"
                 data-bs-popover-content-value="Create queries in this Case that exist in the Book but don't currently exist in the Case."></i>
            </label>
            <p class="text-muted small">Case <i class="bi bi-arrow-left"></i> Book: add queries that exist in Book but not in Case.</p>
          </div>
          <div class="col-sm-4 text-end">
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-judgements-core-target="actionButton"
                    data-action="click->judgements-core#manualSyncQueries">
              <i class="bi bi-plus"></i> Sync Queries
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="text-danger d-none" data-judgements-core-target="error"></div>
<% end %>

<%= render "shared/modal_shell", id: "judgementsModal", title: "Judgements",
                                 dialog_class: "modal-lg",
                                 data: {
                                   controller: "judgements-core",
                                   judgements_core_case_url_template_value: api_case_path(case_id: "__CASE_ID__"),
                                   judgements_core_team_books_url_template_value: api_team_books_path(team_id: "__TEAM_ID__"),
                                   judgements_core_refresh_url_template_value: api_book_refresh_path(book_id: "__BOOK_ID__", case_id: "__CASE_ID__", create_missing_queries: "__CREATE_MISSING__", process_in_background: "__BACKGROUND__"),
                                   judgements_core_new_book_url_template_value: "books/new?scorer_id=__SCORER_ID__&origin_case_id=__CASE_ID__",
                                   judgements_core_judge_url_template_value: "books/__BOOK_ID__/judge"
                                 },
                                 title_data: { judgements_core_target: "title" },
                                 footer: modal_footer,
                                 body: modal_body %>
