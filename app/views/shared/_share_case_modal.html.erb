<%# Cases index / teams — `<select>`, form POST, redirect %>
<% modal_footer = capture do %>
  <a href="<%= new_team_path %>" class="btn btn-primary me-auto">+ Create a team</a>
  <button type="submit" form="share-case-form" id="share-case-submit" class="btn btn-success" disabled data-share-case-target="submitButton">Share with team</button>
  <button type="submit" form="unshare-case-form" id="unshare-case-submit" class="btn btn-success" disabled data-share-case-target="unshareButton">Unshare from team</button>
<% end %>

<% modal_body = capture do %>
  <%= form_with url: share_case_teams_path, method: :post, local: true, html: { id: 'share-case-form', class: 'mb-3' } do %>
    <%= hidden_field_tag :case_id, '', id: 'share-case-id', data: { share_case_target: 'recordId' } %>

    <p class="h5">Select a team to share this case with:</p>
    <div class="mb-3">
      <%= select_tag :team_id,
                     options_for_select([['Select a team', '']]),
                     class: 'form-select',
                     id: 'share-case-team',
                     required: true,
                     data: {
                       share_case_target: 'teamSelect',
                       action: 'change->share-case#toggleSubmit'
                     } %>
    </div>
  <% end %>

  <hr>
  <p class="h5">Already shared with:</p>
  <div id="share-case-shared-list" class="list-group mt-2" data-share-case-target="sharedList"></div>

  <%= form_with url: unshare_case_teams_path, method: :post, local: true, html: { id: 'unshare-case-form', class: 'mt-3' } do %>
    <%= hidden_field_tag :case_id, '', id: 'unshare-case-id', data: { share_case_target: 'unshareRecordId' } %>
    <%= hidden_field_tag :team_id, '', id: 'unshare-case-team', data: { share_case_target: 'unshareTeamId' } %>
  <% end %>
<% end %>

<%= render "shared/modal_shell", id: "shareCaseModal", title: "Share Case",
                                 dialog_class: "modal-lg",
                                 data: { controller: "share-case" },
                                 title_data: { share_case_target: "title" },
                                 footer: modal_footer,
                                 body: modal_body %>
