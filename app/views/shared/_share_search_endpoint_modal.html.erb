<% modal_footer = capture do %>
  <a href="<%= new_team_path %>" class="btn btn-primary me-auto">+ Create a team</a>
  <button type="submit" form="share-search-endpoint-form" id="share-search-endpoint-submit" class="btn btn-success" disabled data-share-search-endpoint-target="submitButton">Share with team</button>
  <button type="submit" form="unshare-search-endpoint-form" id="unshare-search-endpoint-submit" class="btn btn-success" disabled data-share-search-endpoint-target="unshareButton">Unshare from team</button>
<% end %>

<% modal_body = capture do %>
  <%= form_with url: share_search_endpoint_teams_path, method: :post, local: true, html: { id: 'share-search-endpoint-form', class: 'mb-3' } do %>
    <%= hidden_field_tag :search_endpoint_id, '', id: 'share-search-endpoint-id', data: { share_search_endpoint_target: 'recordId' } %>

    <p class="h5">Select a team to share this search endpoint with:</p>
    <div class="mb-3">
      <%= select_tag :team_id,
                     options_for_select([['Select a team', '']]),
                     class: 'form-select',
                     id: 'share-search-endpoint-team',
                     required: true,
                     data: {
                       share_search_endpoint_target: 'teamSelect',
                       action: 'change->share-search-endpoint#toggleSubmit'
                     } %>
    </div>
  <% end %>

  <hr>
  <p class="h5">Already shared with:</p>
  <div id="share-search-endpoint-shared-list" class="list-group mt-2" data-share-search-endpoint-target="sharedList"></div>

  <%= form_with url: unshare_search_endpoint_teams_path, method: :post, local: true, html: { id: 'unshare-search-endpoint-form', class: 'mt-3' } do %>
    <%= hidden_field_tag :search_endpoint_id, '', id: 'unshare-search-endpoint-id', data: { share_search_endpoint_target: 'unshareRecordId' } %>
    <%= hidden_field_tag :team_id, '', id: 'unshare-search-endpoint-team', data: { share_search_endpoint_target: 'unshareTeamId' } %>
  <% end %>
<% end %>

<%= render "shared/modal_shell", id: "shareSearchEndpointModal", title: "Share Search Endpoint",
                                 dialog_class: "modal-lg",
                                 data: { controller: "share-search-endpoint" },
                                 title_data: { share_search_endpoint_target: "title" },
                                 footer: modal_footer,
                                 body: modal_body %>
