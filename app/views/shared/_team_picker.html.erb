<%# locals: (form:, label:, help_text:) %>
<%= form.label :teams, label, class: 'form-label' %>
<% if current_user.teams.any? %>
  <%= form.collection_check_boxes(:team_ids, current_user.teams, :id, :name) do |b| %>
    <div class="collection-check-box">
      <%= b.check_box %>
      <%= b.label %>
    </div>
  <% end %>
  <div class="form-text"><%= help_text %></div>
<% else %>
  <div class="text-center py-3 border rounded">
    <p class="mb-3">No teams to share with? Why not go ahead and create a new team!</p>
    <%= link_to new_team_path, class: 'btn btn-primary' do %>
      <i class="bi bi-plus-lg" aria-hidden="true"></i> Create a team
    <% end %>
  </div>
<% end %>
