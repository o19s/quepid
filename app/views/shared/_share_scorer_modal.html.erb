<% modal_footer = capture do %>
  <a href="<%= new_team_path %>" class="btn btn-primary me-auto">+ Create a team</a>
  <button type="submit" form="share-scorer-form" id="share-scorer-submit" class="btn btn-success" disabled data-share-scorer-target="submitButton">Share with team</button>
  <button type="submit" form="unshare-scorer-form" id="unshare-scorer-submit" class="btn btn-success" disabled data-share-scorer-target="unshareButton">Unshare from team</button>
<% end %>

<% modal_body = capture do %>
  <%= form_with url: share_scorers_path, method: :post, local: true, html: { id: 'share-scorer-form', class: 'mb-3' } do %>
    <%= hidden_field_tag :scorer_id, '', id: 'share-scorer-id', data: { share_scorer_target: 'recordId' } %>

    <p class="h5">Select a team to share this scorer with:</p>
    <div class="mb-3">
      <%= select_tag :team_id,
                     options_for_select([['Select a team', '']]),
                     class: 'form-select',
                     id: 'share-scorer-team',
                     required: true,
                     data: {
                       share_scorer_target: 'teamSelect',
                       action: 'change->share-scorer#toggleSubmit'
                     } %>
    </div>
  <% end %>

  <hr>
  <p class="h5">Already shared with:</p>
  <div id="share-scorer-shared-list" class="list-group mt-2" data-share-scorer-target="sharedList"></div>

  <%= form_with url: unshare_scorers_path, method: :post, local: true, html: { id: 'unshare-scorer-form', class: 'mt-3' } do %>
    <%= hidden_field_tag :scorer_id, '', id: 'unshare-scorer-id', data: { share_scorer_target: 'unshareRecordId' } %>
    <%= hidden_field_tag :team_id, '', id: 'unshare-scorer-team', data: { share_scorer_target: 'unshareTeamId' } %>
  <% end %>
<% end %>

<%= render "shared/modal_shell", id: "shareScorerModal", title: "Share Scorer",
                                 dialog_class: "modal-lg",
                                 data: { controller: "share-scorer" },
                                 title_data: { share_scorer_target: "title" },
                                 footer: modal_footer,
                                 body: modal_body %>
