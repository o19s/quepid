<%= page_header "Cases" do %>
  <div class="btn-toolbar mb-2 mb-md-0">
    <div class="btn-group me-2">
      <%= button_tag type: 'button',
                     class: 'btn btn-sm btn-outline-secondary',
                     data: {
                       bs_toggle: 'modal',
                       bs_target: '#importCaseModal'
                     } do %>
        Import Case from JSON
      <% end %>

      <%= button_tag type: 'button',
                     class: 'btn btn-sm btn-outline-secondary',
                     data: {
                       bs_toggle: 'modal',
                       bs_target: '#importSnapshotModal'
                     } do %>
        Import Snapshots from CSV
      <% end %>
    </div>
  </div>
<% end %>
Cases are a group of queries that you are evaluating and experimenting with.

<p id="notice"><%= notice %></p>

<% if @cases.empty? && @filter_q.blank? && @filter_team_id.blank? && !@archived %>
  Create your first case by clicking on Relevancy Cases &gt; Create a case in the navigation bar above.
  <br>
<% end %>

<div class="card">
  <div class="card-header">
    <%= render "shared/index_filters",
      url: cases_path, placeholder: "Filter by case name or id", search_icon: "bi-search",
      checkboxes: [{ name: :archived, value: '1', checked: @archived, label: 'Archived' }],
      team_options: current_user.teams.map { |team| [team.name, team.id] }, team_label: true %>
  </div>
  
  <div class="card-body">
    <div class="table-responsive">
    <table class="table table-hover table-sm">
      <thead>
        <tr>
          <th>ID</th>
          <th>Case Title</th>
          <th>Last Try #</th>
          <th># of Queries</th>
          <th>Last Score</th>
          <th>Last Run On</th>
          <th>Last Run By</th>
          <th>Associated Judgements</th>
          <th>Teams</th>
          <th>Owner</th>
          <th class="text-end"></th>
        </tr>
      </thead>
  
      <tbody>      
        <% @cases.each do |kase| %>
          <% last_score = @last_scores[kase.id] %>
          <tr>
            <td><%= kase.id %></td>
            <td><%= link_to kase.case_name, case_core_path(kase) %></td>
            <td><%= kase.last_try_number || (kase.tries.first&.try_number) %></td>
            <td><%= kase.respond_to?(:queries_count) ? kase.queries_count : kase.queries.size %></td>
            <td>
              <% if last_score.present? %>
                <%= number_with_precision(last_score.score || 0, precision: 3) %>
              <% else %>
                Never Run
              <% end %>
            </td>
            <td>
              <% if last_score.present? && last_score.updated_at.present? %>
                <%= l(last_score.updated_at, format: :short) %>
              <% else %>
                —
              <% end %>
            </td>
            <td>
              <% if last_score.present? %>
                <%= last_score.user&.fullname || 'System' %>
              <% else %>
                —
              <% end %>
              <% if kase.nightly? %>
                <i class="bi bi-repeat float-end"></i>
              <% end %>
            </td>
            <td>
              <% ratings_count = @ratings_counts.fetch(kase.id, 0) %>
              <% if ratings_count > 0 %>
                <span class="badge bg-primary rounded-pill"><%= ratings_count %></span>
              <% else %>
                —
              <% end %>
            </td>
            
            <td>
              <% if kase.teams.any? %>
                <%= safe_join(kase.teams.map { |t| link_to t.name, team_path(t) }, ', ') %>
              <% else %>
                —
              <% end %>
            </td>
            <td><%= kase.owner&.fullname || '—' %></td>
            <td class="text-end text-nowrap">
              <%= button_tag type: 'button',
                             class: 'btn btn-link p-0 me-2',
                             title: 'Share',
                             'aria-label': 'Share',
                             data: {
                               bs_toggle: 'modal',
                               bs_target: '#shareCaseModal',
                               share_case_id_value: kase.id,
                               share_case_name_value: kase.case_name,
                               share_case_url_value: share_modal_path('case', kase)
                             } do %>
                <i class="bi bi-share" aria-hidden="true"></i>
              <% end %>

              <% if kase.archived? %>
                <%= button_to unarchive_case_path(kase),
                              method: :post,
                              class: "btn btn-link text-success p-0",
                              title: "Unarchive case",
                              aria: { label: "Unarchive case" },
                              form: { class: "d-inline", data: { turbo_confirm: "Unarchive #{kase.case_name}?", turbo_confirm_style: "primary" } } do %>
                  <i class="bi-folder-check" aria-hidden="true"></i>
                  <span class="visually-hidden">Unarchive case</span>
                <% end %>
              <% else %>
                <%= button_to archive_case_path(kase),
                              method: :post,
                              class: "btn btn-link text-warning p-0",
                              title: "Archive case",
                              aria: { label: "Archive case" },
                              form: { class: "d-inline", data: { turbo_confirm: "Archive #{kase.case_name}?" } } do %>
                  <i class="bi-folder-check" aria-hidden="true"></i>
                  <span class="visually-hidden">Archive case</span>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
  <%= render "shared/index_pagination", pagy: @pagy %>
</div>

<%= render 'shared/share_case_modal' %>
<%= render 'shared/import_case_modal' %>
<%= render 'shared/import_snapshot_modal' %>
