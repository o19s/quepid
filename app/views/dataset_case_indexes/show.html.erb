<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
  <h1><i class="bi bi-database" aria-hidden="true"></i> Initiate indexing</h1>
  <div class="btn-toolbar mb-2 mb-md-0">
    <%= link_to 'Back to Dataset Cases', dataset_cases_path, class: 'btn btn-sm btn-outline-secondary' %>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <table class="table table-sm mb-0">
      <tbody>
        <tr><th scope="row" class="w-25">Case</th><td><%= link_to @kase.case_name, case_core_path(@kase) %></td></tr>
        <tr><th scope="row">Dataset</th><td><%= @entry&.name || @link.dataset.key %></td></tr>
        <tr>
          <th scope="row">Search endpoint</th>
          <td><%= link_to @endpoint.fullname, search_endpoint_path(@endpoint) %> <span class="text-muted">(<%= SearchEngine.label(@endpoint.search_engine) %>)</span></td>
        </tr>
        <% if @definition %>
          <tr><th scope="row">Index</th><td><code><%= @proposed.index_name %></code>, named by the endpoint's address when it names one<%= ', and you can change it below' if @proposed.applicable? %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @unsupported %>
  <div class="alert alert-warning" role="alert">
    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> <%= @unsupported %>
    Index definitions are made for <%= DatasetIndex::BUILDERS.values.map { |builder| builder::LABEL }.to_sentence %> endpoints.
  </div>
<% else %>
  <% if @definition.applicable? %>
    <%# The definition is a form: the user may edit the name and the JSON before agreeing. %>
    <%= form_with url: dataset_case_index_path(@link), method: :post, data: { turbo: false, controller: 'json-editor',
                                                                              json_editor_original_value: @proposed.text,
                                                                              json_editor_original_name_value: @proposed.index_name } do %>
      <%= hidden_field_tag :search_endpoint_id, @endpoint.id %>
      <div class="card mb-3">
        <div class="card-header">The index definition for <%= @definition.label %>: edit it if you want to change it</div>
        <div class="card-body">
          <% if @definition.note.present? %>
            <p class="text-muted small"><%= @definition.note %></p>
          <% end %>
          <div class="mb-3">
            <%= label_tag :index_name, 'Index name', class: 'form-label' %>
            <%= text_field_tag :index_name, @edited_name || @proposed.index_name, class: 'form-control font-monospace', required: true,
                               data: { json_editor_target: 'name' } %>
          </div>
          <%= label_tag :definition, 'Definition (JSON)', class: 'form-label' %>
          <%= text_area_tag :definition, @edited_text || @proposed.text, rows: 24, spellcheck: false, class: 'form-control font-monospace',
                            style: 'font-size: .85rem;', data: { json_editor_target: 'input', action: 'input->json-editor#check' } %>
          <div class="d-flex justify-content-between align-items-center mt-2">
            <span class="small" data-json-editor-target="status" aria-live="polite"></span>
            <span>
              <button type="button" class="btn btn-sm btn-outline-secondary" data-action="json-editor#format">Format</button>
              <button type="button" class="btn btn-sm btn-outline-secondary" data-action="json-editor#reset">Back to the proposed definition</button>
            </span>
          </div>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-body">
          <p class="mb-2">
            Create this index on <strong><%= @endpoint.fullname %></strong>? Quepid will send the definition above to the endpoint,
            and then <%= @kase.case_name %> will search it. No documents are indexed yet.
          </p>
          <%= button_tag "Create the index", type: 'submit', class: 'btn btn-primary', data: { json_editor_target: 'submit',
                                                                                           turbo_confirm: "Create the #{@definition.label} index on #{@endpoint.fullname} with this definition?" } %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="card mb-3">
      <div class="card-header">The index definition for <%= @definition.label %></div>
      <div class="card-body">
        <% if @definition.note.present? %>
          <p class="text-muted small"><%= @definition.note %></p>
        <% end %>
        <pre class="bg-body-tertiary border rounded p-3 mb-0" style="max-height: 28rem; overflow: auto;"><code><%= @definition.text %></code></pre>
        <p class="mt-3 mb-0 text-muted">Quepid cannot create this index itself, so there is nothing to apply: use the definition above in <%= @definition.label %>.</p>
      </div>
    </div>
  <% end %>

  <% if @entry&.mapper %>
    <div class="card mb-3">
      <div class="card-header">Where the documents' fields come from</div>
      <div class="card-body">
        <p class="small text-muted">
          Every dataset's documents are turned into the same shape, the canonical dataset index schema, before they are indexed.
          For <%= @entry.name %>, the fields are filled in like this; fields that are not listed are left out, and source fields
          that are not used are dropped.
        </p>
        <table class="table table-sm mb-0">
          <thead><tr><th>Field</th><th>Filled in from</th></tr></thead>
          <tbody>
            <% CanonicalDatasetIndexSchema::FIELDS.each do |field| %>
              <% how = @entry.mapper.describe.to_h[field.name] %>
              <tr>
                <td><code><%= field.name %></code> <span class="text-muted small"><%= field.description %></span></td>
                <td><%= 'id' == field.name ? "the document's own id" : (how ? sanitize(how.gsub(/`([^`]+)`/, '<code>\\1</code>')) : raw('<span class="text-muted">not available in this dataset</span>')) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
<% end %>

<div class="card">
  <div class="card-body">
    <p class="mb-2">Already indexed there? Point <%= @kase.case_name %> at <strong><%= @endpoint.fullname %></strong> without creating anything.</p>
    <%= button_to 'Only use this endpoint', endpoint_dataset_case_path(@link), method: :post, params: { search_endpoint_id: @endpoint.id },
                  class: 'btn btn-sm btn-outline-secondary', form: { class: 'd-inline', data: { turbo: false } } %>
  </div>
</div>
