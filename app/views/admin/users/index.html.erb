<%= page_header "Users" do %>
  <div class="btn-toolbar mb-2 mb-md-0">
    <div class="btn-group me-2">
      <%= link_to 'New User', new_admin_user_path, class: "btn btn-sm btn-outline-secondary" %>
      <%= link_to 'Export', admin_users_path( shallow: true, format: :csv), class: "btn btn-sm btn-outline-secondary" %>
      <%= link_to 'Export JSON', admin_users_path( shallow: true, format: :json), class: "btn btn-sm btn-outline-secondary" %>
    </div>
  </div>
<% end %>


<p id="notice"><%= notice %></p>
<% if @users.empty? %>
  <div class="alert alert-primary" role="alert">
    Create your first user by clicking on the New User button above.
  </div>
<% end %>

<div class="card">
  <div class="card-header">   
    <%= search_form_for @q, url: admin_users_path do |f| %>
      <div class="mb-0 d-flex fs-6 ">

        <div class="input-group">
          <%= f.search_field :name_or_email_cont,
              class: 'form-control form-control-sm',
              placeholder: 'Filter by email or name',
              id: 'q'
          %>
          <%= button_tag type: 'submit', class: 'btn btn-sm btn-outline-secondary', id: 'button-addon2' do %>
            <i class="bi bi-search-heart"></i>
          <% end %>
        </div>



      </div>
    <% end %>
  </div>
  
  <div class="card-body">
    <div class="table-responsive">
    <table class="table table-hover table-sm">
      <thead>
        <tr>
          <th><%= sort_link(@q, :email, 'Username') %></th>
          <th><%= sort_link(@q, :name, 'Name') %></th>
          <th><%= sort_link(@q, :agreed_time, 'Signed Up') %></th>
          <th><%= sort_link(@q, :email_marketing, 'Marketing') %></th>
          <th><%= sort_link(@q, :num_logins, 'Number of Logins') %></th>
          <th><%= sort_link(@q, :administrator, 'Administrator?') %></th>
          <th colspan="2"></th>
        </tr>
      </thead>
  
      <tbody>      
        <% @users.each do |user| %>
          <tr>
            <td>
              <%= user.email %>
              <% if user.locked? %>
                <i class="bi bi-lock-fill"></i>
              <% end %>
            </td>
            <td><%= user.name %></td>
            <td>
              <%= user.agreed_time %>
              <% if user.agreed_time %>
                (<%= time_ago_in_words user.agreed_time %> ago)
              <% end %>
            </td>
            <td><%= user.email_marketing %></td>
            <td><%= user.num_logins %></td>
            <td><%= user.administrator? %></td>
            <td><%= link_to 'Show', admin_user_path(user) %></td>
            <td><%= link_to 'Edit', edit_admin_user_path(user) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
  <div class="card-footer d-flex justify-content-center">
    <%== @pagy.series_nav(:bootstrap) %>
  </div>
</div>
