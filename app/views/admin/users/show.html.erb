<% title = capture do %>
  <%= image_tag @user.avatar_url(:big), size:'96x96', class:'rounded', alt: '' unless @user.ai_judge? %>
  <%= @user.display_name %>
<% end %>
<%= page_header title do %>
  <div class="btn-toolbar mb-2 mb-md-0">
    <div class="btn-group me-2">
      <%= link_to 'Edit', edit_admin_user_path(@user), class: "btn btn-sm btn-outline-primary " %>
      <%= link_to "Back", admin_users_path, class: "btn btn-sm btn-outline-secondary" %>
      <%= button_to (@user.locked? ? 'Unlock' : 'Lock'), admin_user_lock_path(@user), method: :patch, class: 'btn btn-outline-warning btn-sm' %>

    </div>
  </div>
<% end %>

<div class="card">
  <div class="card-body">
    <p id="notice"><%= notice %></p>


    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">Email</label>
      <div class="col-sm-10">
        <p><%= @user.email %></p>
      </div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">Name</label>
      <div class="col-sm-10">
        <p><%= @user.name || 'N/A' %></p>
      </div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">Company</label>
      <div class="col-sm-10">
        <p><%= @user.company %></p>
      </div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">Signed Up</label>
      <div class="col-sm-10">
        <p>
          <%= @user.agreed_time %>
          <% if @user.agreed_time %>
            (<%= time_ago_in_words @user.agreed_time %> ago)
          <% end %>
        </p>
      </div>
    </div>
    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">Created by Invite?</label>
      <div class="col-sm-10">
        <p><%= @user.created_by_invite? %></p>
      </div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">Email Marketing</label>
      <div class="col-sm-10">
        <p><%= @user.email_marketing %></p>
      </div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">Number of Logins</label>
      <div class="col-sm-10">
        <p><%= @user.num_logins %></p>
      </div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">Is Administrator?</label>
      <div class="col-sm-10">
        <p><%= @user.administrator %></p>
      </div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">Locked?</label>
      <div class="col-sm-10">
        <p><%= @user.locked? %></p>
      </div>
    </div>
  </div>
</div>

<hr>


<div class="card">
  <div class="card-header">
    <h2>Pulse</h2>
  </div>

  <div class="card-body">
    <% if @user.pending_invite? %>
      <div class="alert alert-info" role="alert">This user hasn't accepted the invite to join Quepid, therefore no usage data is available.</div>
    <% else %>


      <%= render "admin/users/activity_chart", heading: "Cases viewed", id: "cases-viewed",
                 url: (url_for admin_user_pulse_path @user, params: {data: 'metadata'}), label: "cases viewed" %>

      <%= render "admin/users/activity_chart", heading: "Cases scored", id: "cases-scored",
                 url: (url_for admin_user_pulse_path @user, params: {data: 'scores'}), label: "cases scored" %>

      <%= render "admin/users/activity_chart", heading: "Cases created", id: "cases-created",
                 url: (url_for admin_user_pulse_path @user, params: {data: 'cases-created'}), label: "cases created" %>

      <%= render "admin/users/activity_chart", heading: "Queries created", id: "queries-created",
                 url: (url_for admin_user_pulse_path @user, params: {data: 'queries-created'}), label: "queries created" %>

      <%= render "admin/users/activity_chart", heading: "Books created", id: "books-created",
                 url: (url_for admin_user_pulse_path @user, params: {data: 'books-created'}), label: "books created" %>

      <%= render "admin/users/activity_chart", heading: "Judgements created", id: "judgements-created",
                 url: (url_for admin_user_pulse_path @user, params: {data: 'judgements-created'}), label: "judgements created" %>
    <% end %>
  </div>
</div>
