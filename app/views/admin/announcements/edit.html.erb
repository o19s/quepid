<%= page_header "Edit Quepid Announcement" do %>
  <div class="btn-toolbar mb-2 mb-md-0">
    <div class="btn-group me-2">
      <%= button_to "Delete", admin_announcement_path(@announcement), method: :delete, class: 'btn btn-sm btn-outline-danger', form: { data: { turbo_confirm: 'Are you sure you want to delete this Announcement?' } } %>
      <%= link_to 'Back to Quepid Announcements', admin_announcements_path, method: :get, class:'btn btn-sm btn-outline-secondary' %>
    </div>
  </div>
<% end %>

<%= form_for [:admin, @announcement] do |form| %>
  <%= render "shared/error_messages", record: @announcement, subject: "announcement" %>

  <div class="card">
    <div class="card-body">
      <%= render "fields", form: form %>
      <br>
    
      <div class="actions">
        <%= form.submit "Update", class: 'btn btn-sm btn-primary' %>
      </div>
    </div>
  </div>
<% end %>
