<%= page_header "Search Endpoints" do %>
  <div class="btn-toolbar mb-2 mb-md-0">
    <div class="btn-group me-2">
      <%= link_to 'New Search Endpoint', new_search_endpoint_path, class: "btn btn-sm btn-outline-secondary" %>
      <%= link_to new_mapper_wizard_path, class: "btn btn-sm btn-outline-info" do %>
        <i class="bi bi-stars"></i> New SearchAPI with Mapper Wizard
      <% end %>
    </div>
  </div>
<% end %>

Search Endpoints represents a search engine (or API!) that is receiving queries and responding with results.


<p id="notice"><%= notice %></p>

<% if @search_endpoints.empty? && params[:q].blank? && params[:owned].blank? && params[:team_id].blank? && !@archived %>
  Create your first search endpoint by clicking on the New Search Endpoint button above.
  <br>
<% end %>

  <div class="card">
    <div class="card-header">
      <%= render "shared/index_filters",
      url: search_endpoints_path, placeholder: "Filter by name or url",
        checkboxes: [{ name: :owned, value: true, checked: params[:owned].present?, label: 'Mine' },
                     { name: :archived, value: true, checked: params[:archived].present?, label: 'Archived' }],
        team_options: @current_user.teams.map { |team| [team.name, team.id] }, team_label: true %>
    </div>
    
    <div class="card-body">
      <div class="table-responsive">
      <table class="table table-hover table-sm">
        <thead>
          <tr>
            <th>Name</th>
            <th>Search Engine</th>
            <th>Endpoint Url</th>
            <th class="text-end"></th>
          </tr>
        </thead>
    
        <tbody>      
          <% @search_endpoints.each do |search_endpoint| %>
            <tr>
              <td><%= link_to search_endpoint.fullname, search_endpoint_path(search_endpoint) %></td>
              <td>
                <% if search_endpoint.search_engine %>
                  <%= image_tag "#{search_endpoint.mapper_based_search_engine&.id || search_endpoint.search_engine}-icon.png", size:'32x32', class:'rounded-circle' %>
                <% end %>
                <%= search_endpoint.mapper_based_search_engine&.name || search_endpoint.search_engine %>
              </td>
              <td><%= search_endpoint.endpoint_url %> </td>
              <td class="text-end">
                <%= button_tag type: 'button',
                               class: 'btn btn-link p-0',
                               title: 'Share',
                               'aria-label': 'Share',
                               data: {
                                 bs_toggle: 'modal',
                                 bs_target: '#shareSearchEndpointModal',
                                 share_search_endpoint_id_value: search_endpoint.id,
                                 share_search_endpoint_name_value: search_endpoint.fullname,
                                 share_search_endpoint_all_teams_json_value: @current_user.teams.select(:id, :name).order(:name).to_json,
                                 share_search_endpoint_shared_teams_json_value: search_endpoint.teams.select(:id, :name).to_json
                               } do %>
                  <i class="bi bi-share" aria-hidden="true"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      </div>
    </div>
    <%= render "shared/index_pagination", pagy: @pagy %>
  </div>

<%= render 'shared/share_search_endpoint_modal' %>
