<%= page_header "Search Endpoint #{@search_endpoint.fullname}" do %>
  <div class="btn-toolbar mb-2 mb-md-0">
    <div class="btn-group me-2">
      <%= link_to 'Edit', edit_search_endpoint_path(@search_endpoint), class: "btn btn-sm btn-outline-primary " %>
      <%= link_to 'Clone', clone_search_endpoint_path(@search_endpoint), data: { turbo: false }, class: "btn btn-sm btn-outline-secondary" %>
      <% if @search_endpoint.search_engine == 'searchapi' && @search_endpoint.mapper_based_search_engine_id.blank? %>
        <%= link_to mapper_wizard_path(@search_endpoint), class: "btn btn-sm btn-outline-info" do %>
          <i class="bi bi-stars"></i> Mapper Wizard
        <% end %>
      <% end %>
    </div>
    <%= link_to "Back", search_endpoints_path, class: "btn btn-sm btn-outline-secondary" %>
  </div>
<% end %>

<% unless @search_endpoint.team_shareable? %>
  <div class="alert alert-info" role="note">
    <strong>Static File endpoints belong to a case.</strong>
    Their imported search results are stored in a snapshot of that case.
    Sharing the endpoint would not give teammates access to the case or its snapshot,
    so Static File endpoints cannot be shared separately. Share the case with your team instead.
    To use the same data in another case, import the file into that case again.
  </div>
<% end %>

<div class="card">
  <div class="card-body">
    <%= render @search_endpoint %>
  </div>
</div>
