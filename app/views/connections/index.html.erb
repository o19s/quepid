<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
  <h1><i class="bi bi-plug-fill" aria-hidden="true"></i> Connections</h1>
  <div class="btn-toolbar mb-2 mb-md-0">
    <%= page_create_button 'Create Connection', new_connection_path %>
  </div>
</div>

<div class="alert alert-info" role="alert">
  <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
  A Connection is how Quepid reaches an external service and signs in to it: the URL and the key. Enter a key once here
  and it can be shared with your teams without being shown to anyone. Connections are owned by a user and shared with
  teams, like search endpoints. Only the owner can change one.
</div>

<div class="card">
  <div class="card-body">
    <% if @connections.any? %>
      <div class="table-responsive">
        <table class="table table-sm table-hover">
          <thead>
            <tr>
              <th>Name</th>
              <th>Service</th>
              <th>URL</th>
              <th>Authentication</th>
              <th>Owner</th>
              <th>Teams</th>
              <th>Used by</th>
              <th class="text-end"></th>
            </tr>
          </thead>
          <tbody>
            <% @connections.each do |connection| %>
              <tr>
                <td>
                  <%= link_to connection.name, connection_path(connection) %>
                  <% if connection.archived %>
                    <span class="badge bg-secondary">Archived</span>
                  <% end %>
                </td>
                <td><%= connection.service_definition&.label || connection.service %></td>
                <td><code class="text-break"><%= connection.base_url %></code></td>
                <td>
                  <%= Connection::AUTH_SCHEME_LABELS[connection.auth_scheme] %>
                  <% if connection.secret.present? %>
                    <i class="bi bi-key-fill text-muted" title="A secret is saved" aria-label="A secret is saved"></i>
                  <% end %>
                </td>
                <td>
                  <% if connection.instance_wide? %>
                    <span class="badge bg-info text-dark">Everyone</span>
                  <% elsif connection.owner == current_user %>
                    <span class="badge bg-secondary">You</span>
                  <% else %>
                    <%= connection.owner.fullname %>
                  <% end %>
                </td>
                <td>
                  <% if connection.teams.any? %>
                    <%= connection.teams.map(&:name).to_sentence %>
                  <% else %>
                    <span class="text-muted">&mdash;</span>
                  <% end %>
                </td>
                <td>
                  <% count = @embedder_counts.fetch(connection.id, 0) %>
                  <% if count.positive? %>
                    <%= pluralize(count, 'embedder') %>
                  <% else %>
                    <span class="text-muted">&mdash;</span>
                  <% end %>
                </td>
                <td class="text-end">
                  <% if connection.manageable_by?(current_user) %>
                    <div class="btn-group btn-group-sm" role="group">
                      <%= link_to edit_connection_path(connection), class: 'btn btn-link p-0 me-2', title: 'Edit', 'aria-label': 'Edit' do %>
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                      <% end %>
                      <%= group_button_to connection_path(connection),
                                          method: :delete,
                                          button_class: "text-danger p-0",
                                          title: "Delete",
                                          aria: { label: "Delete" },
                                          confirm: "Delete connection #{connection.name}?" do %>
                        <i class="bi bi-x-circle" aria-hidden="true"></i>
                      <% end %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-muted mb-0">
        You don't have any connections yet. <%= link_to 'Create one', new_connection_path %> to keep the URL and key
        of a service in one place.
      </p>
    <% end %>
  </div>
</div>
