<%# Static shells cloned by queries_list_controller.js for each query row. Keep
    this partial free of ERB tags: the Vitest specs load it verbatim. The
    controller fills each `data-slot` with per-query values and URLs (from the
    url-template values on the list); nothing else in a clone is touched. %>
<template data-queries-list-target="rowTemplate">
  <div data-controller="query-row" data-slot="row">
    <div class="result-header" data-query-row-target="header">
      <div class="results-score qscore-query-badge" data-controller="qscore-query" data-slot="score">
        <span class="scorable-score" data-qscore-query-target="value"></span>
      </div>
      <div data-query-row-target="diffScores" data-slot="diffScores"></div>
      <h2 class="results-title" data-action="click->query-row#toggle">
        <span data-controller="bs-tooltip" data-query-row-target="query" data-slot="label" data-bs-tooltip-delay-value="1000" data-bs-tooltip-placement-value="right">
          <img class="img-thumbnail query-thumbnail d-none" data-query-row-target="image" alt="">
          <span data-query-row-target="text">&nbsp;</span>
        </span>
      </h2>
      <span class="float-end total-results">
        <span data-query-row-target="resultCount" data-controller="count-up" data-slot="resultCount"></span>
        <small class="text-muted" data-query-row-target="resultLabel"></small>
      </span>
      <i class="error-warning bi bi-exclamation-triangle-fill ms-2" role="img" aria-label="Query failed" title="Query failed"></i>
      <span class="float-end d-none" style="margin-right: 20px;" title="Hop to it!  There are unrated results!" data-controller="query-unrated-badge" data-slot="unratedBadge">
        <div class="icon-container"><i class="frog-icon">🐸</i><div class="notification-bubble" data-query-unrated-badge-target="count"></div></div>
      </span>
      <span class="float-end d-none" style="margin-right: 20px;" title="Querqy Strikes Again!" data-query-row-target="querqy"><i class="querqy-icon"></i></span>
      <i class="toggleSign bi" data-query-row-target="toggle" data-action="click->query-row#toggle"></i>
    </div>
    <div data-query-row-target="expanded"></div>
  </div>
</template>

<template data-queries-list-target="searchResultsTemplate">
  <div data-controller="search-results" data-action="rating-popover:rate->search-results#handleRating rating-popover:reset->search-results#handleRating query-row:toggle->search-results#handleQueryToggle search-result:show-document->search-results#handleShowDocument query-notes:close->search-results#closeNotes">
    <div data-search-results-target="content" class="sub-results container-fluid d-none">
      <div data-search-results-target="scoreAll">
        <div class="col-ratings query-rating">
          <strong>Score All</strong>
          <div class="ratings" data-slot="scoreAllRating"></div>
        </div>
      </div>

      <div class="btn-toolbar" role="toolbar">
        <div class="btn-group me-2">
          <button type="button" class="btn btn-outline-secondary btn-sm" title="Copy query" aria-label="Copy query" data-action="click->search-results#copyQuery">
            <i class="bi bi-copy" aria-hidden="true"></i>
          </button>
        </div>
        <div class="btn-group me-2">
          <button class="btn btn-outline-secondary btn-sm" data-action="click->search-results#toggleNotes">Toggle Notes</button>
        </div>
        <div class="btn-group me-2">
          <div data-controller="query-explain" data-query-explain-queries-list-outlet="#query-container" data-slot="explain"><button type="button" class="btn btn-outline-secondary btn-sm" data-action="query-explain#requestOpen">Explain Query</button></div>
        </div>
        <div class="d-flex">
          <div class="btn-group me-2">
            <button class="btn btn-outline-secondary btn-sm" data-controller="missing-documents" data-action="click->missing-documents#open" data-slot="missingDocuments">Missing Documents</button>
          </div>
          <div class="btn-group me-2">
            <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#queryOptionsModal">Set Options</button>
          </div>
        </div>
        <div class="btn-group">
          <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#moveQueryModal">Move Query</button>
          <button class="btn btn-danger btn-sm" data-controller="query-delete" data-query-delete-query-command-bridge-outlet="body" data-action="click->query-delete#remove" data-slot="delete">Delete Query</button>
        </div>
      </div>

      <div class="notes-box d-none" data-search-results-target="notesBox">
        <div class="notes-content" data-controller="query-notes" data-action="query-notes:open->query-notes#load" data-slot="notes">
          <form data-action="submit->query-notes#save">
            <div class="row mb-3"><label class="col-sm-2 col-form-label text-sm-end" data-slot="informationNeedLabel">Information Need</label><div class="col-sm-10"><input type="text" data-query-notes-target="informationNeed" class="form-control" placeholder="Info Need:" data-slot="informationNeedField"></div></div>
            <div class="row mb-3"><label class="col-sm-2 col-form-label text-sm-end" data-slot="notesLabel">Notes on this Query</label><div class="col-sm-10"><textarea data-query-notes-target="notes" class="form-control" data-slot="notesField"></textarea></div></div>
            <div class="row mb-3"><div class="offset-sm-2 col-sm-10"><button type="submit" class="btn btn-primary">Save</button></div></div>
          </form>
        </div>
      </div>

      <div data-search-results-target="diffResults"></div>
      <div data-search-results-target="error" class="alert alert-danger d-none" role="alert"></div>

      <div data-search-results-target="results"></div>
      <div data-search-results-target="footer" class="row results-pane-footer d-none">
        <button type="button" class="btn btn-link p-0 results-pane-toggle" aria-label="Close the results pane" data-action="click->search-results#collapse" data-controller="bs-popover" data-bs-popover-content-value="Close the results pane">
          <i class="bi bi-caret-up-fill" aria-hidden="true"></i>
        </button>
        <button type="button" class="btn btn-outline-secondary d-none" data-search-results-target="nextPage" data-action="click->search-results#paginate">Peek at the next page of results</button>
        <div data-search-results-target="browseTool"></div>
        <div data-search-results-target="depthNote" class="alert alert-warning mb-0 d-none" role="alert"><strong>Note:</strong> Only the top <span data-search-results-target="depthValue"></span> results are used in the scoring calculations.</div>
        <div data-search-results-target="ratedNote" class="alert alert-warning mb-0 d-none" role="alert"><strong>Note:</strong> You are only viewing documents that have been rated</div>
      </div>
    </div>
  </div>
</template>

<template data-queries-list-target="paginationTemplate">
  <nav aria-label="Query pages">
    <div class="d-flex align-items-center gap-2">
      <button type="button" class="btn btn-outline-secondary btn-sm" data-slot="previous" data-action="click->queries-list#changePage" data-queries-list-direction-param="previous">Previous</button>
      <span data-slot="summary"></span>
      <button type="button" class="btn btn-outline-secondary btn-sm" data-slot="next" data-action="click->queries-list#changePage" data-queries-list-direction-param="next">Next</button>
    </div>
  </nav>
</template>

<template data-queries-list-target="diffScoreTemplate">
  <div class="results-score diff-score qscore-query-badge" data-controller="diff-score" data-slot="diffScore">
    <span class="scorable-score" data-diff-score-target="value"></span>
  </div>
</template>

<%# Cloned by search_result_controller.js for each document, by id because each
    result is its own controller; it fills the `data-slot`s. These rows nest inside
    the expanded-query shell above, so keep slot names distinct from its slots. %>
<template id="search-result-template">
  <div class="row">
    <div class="col-md-10" style="position: relative">
      <div class="col-ratings"><div class="ratings" data-slot="ratings"></div></div>
      <div class="col-summary d-flex">
        <div class="result-thumb-col flex-shrink-0 text-center me-2 d-none" data-slot="thumbColumn"><img class="img-thumbnail result-thumbnail" data-slot="thumb"></div>
        <div class="result-image-col flex-shrink-0 text-center me-2 d-none" data-slot="imageColumn"><img class="img-thumbnail result-image" data-slot="image"></div>
        <ul class="subfields flex-grow-1" data-slot="fields"></ul>
      </div>
    </div>
    <div class="col-md-2" data-slot="matchExplainColumn"><div class="stacked-chart-container" data-controller="match-explain" data-slot="matchExplain"></div></div>
  </div>
</template>
