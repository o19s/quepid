<ul data-book-catalog>
  <li class="list-group-item"
      data-judgements-core-target="item"
      data-judgements-core-book-id-param=""
      data-action="click->judgements-core#selectBook"><em>None (disconnect from any book)</em></li>
  <% @books.each do |book| %>
    <li class="list-group-item"
        data-judgements-core-target="item"
        data-judgements-core-book-id-param="<%= book.id %>"
        data-action="click->judgements-core#selectBook"><span data-slot="name"><%= book.name %></span><a
        href="<%= book_path(book, script_name: '').delete_prefix('/') %>"
        target="_self" class="btn btn-outline-secondary btn-sm float-end"
        title="Open this book in a new page" data-slot="view"
        data-action="click->judgements-core#viewBook"><i class="bi bi-eye-fill"></i> View</a></li>
  <% end %>
</ul>
