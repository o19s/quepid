<%# locals: () %>
<div class="settings-tab" data-tune-relevance-target="panel" data-tune-panel="curator" hidden>
  <div class="rerunnable-settings-tab">
    <p data-tune-relevance-target="staticKnobsMessage" hidden>With a Static search endpoint there are no tuning knobs to play with ;-(.</p>
    <h4>Tuning Knobs</h4>
    <p class="form-text">Add and remove knobs by editing your query. Wrap a variable name in <code>##</code>, for example <code>title^##titleBoost##</code>, to create a tuning knob.</p>
    <div data-tune-relevance-target="curatorVars"></div>
    <template data-tune-relevance-target="curatorVarTemplate"><div class="slider-wrap"><label class="mb-0"></label><input type="number" class="form-control form-control-sm" min="0" max="10000000000" data-action="input->tune-relevance#updateCuratorVariable" autocomplete="off"></div></template>
  </div>
</div>
