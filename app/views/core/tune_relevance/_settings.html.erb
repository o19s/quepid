<%# locals: () %>
<%# Inline neighbours (header text and icon, checkbox and label) stay adjacent to preserve their spacing. %>
<div class="settings-tab" data-tune-relevance-target="panel" data-tune-panel="engineSettings" hidden>
  <div class="rerunnable-settings-tab">
    <%# tune-relevance supplies href before showing these endpoint links. %>
    <div>
      <div class="dev-header" data-action="click->tune-relevance#toggleSection" data-tune-relevance-section-param="endpoint">Endpoint Details <i class="bi bi-dash-circle-fill"></i></div>
      <div class="dev-body" data-tune-relevance-target="sectionBody" data-section-body="endpoint">
        <p class="alert alert-warning" data-tune-relevance-target="endpointArchived" hidden><i class="bi bi-exclamation-triangle"></i> This search endpoint has been archived. Consider switching to an active endpoint.</p>
        <p>Name: <span data-tune-relevance-target="endpointName"></span></p>
        <p><img data-tune-relevance-target="endpointIcon" width="32" alt=""> &nbsp; <span data-tune-relevance-target="endpointUrl"></span></p>
        <p><a data-tune-relevance-target="endpointMoreLink" target="_self" hidden>More</a></p> <%# herb:disable html-anchor-require-href %>
        <p><a data-tune-relevance-target="troubleshootingLink" target="_blank" rel="noopener noreferrer" hidden>Troubleshooting <span data-tune-relevance-target="troubleshootingEngine"></span> and Quepid <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a></p> <%# herb:disable html-anchor-require-href %>
      </div>
    </div>
    <div>
      <div class="dev-header" data-action="click->tune-relevance#toggleSection" data-tune-relevance-section-param="fields">Displayed Fields <i class="bi bi-dash-circle-fill"></i></div>
      <div class="dev-body" data-tune-relevance-target="sectionBody" data-section-body="fields">
        <input class="form-control" data-tune-relevance-target="fieldSpec">
        <p class="alert alert-warning mt-2" data-tune-relevance-target="esTemplateWarning" hidden>When using ES/OS Query Templates, make sure that either your template includes the fields above in its source field filter section (<code>_source</code> declaration) or does not restrict the fields returned via <code>_source</code> at all.</p>
      </div>
    </div>
    <div>
      <div class="dev-header" data-action="click->tune-relevance#toggleSection" data-tune-relevance-section-param="rows">Number of Results to Show <i class="bi bi-dash-circle-fill"></i></div>
      <div class="dev-setting-attribute" data-tune-relevance-target="sectionBody" data-section-body="rows">
        <input class="form-control" min="1" max="100" type="number" data-tune-relevance-target="numberOfRows" autocomplete="off">
      </div>
    </div>
    <div data-tune-relevance-target="escapeSetting">
      <div class="dev-header" data-action="click->tune-relevance#toggleSection" data-tune-relevance-section-param="escape">Escape Queries <i class="bi bi-plus-circle-fill"></i></div>
      <div class="dev-body form-check d-none" data-tune-relevance-target="sectionBody" data-section-body="escape"><input type="checkbox" id="escape-queries-checkbox" class="form-check-input" data-tune-relevance-target="escapeQuery"><label class="form-check-label" for="escape-queries-checkbox">Escape Queries</label></div>
    </div>
    <div>
      <div class="dev-header" data-action="click->tune-relevance#toggleSection" data-tune-relevance-section-param="nightly">Evaluate Nightly? <i class="bi bi-plus-circle-fill"></i></div>
      <div class="dev-body form-check d-none" data-tune-relevance-target="sectionBody" data-section-body="nightly"><input type="checkbox" id="evaluate-nightly-checkbox" class="form-check-input" data-tune-relevance-target="nightly action" data-action="change->tune-relevance#updateNightly"><label class="form-check-label" for="evaluate-nightly-checkbox">Evaluate Case Nightly <i class="bi bi-repeat"></i></label>
        <button type="button" class="btn btn-primary form-control mt-2" data-tune-relevance-target="runEvaluation action" data-action="click->tune-relevance#runEvaluation">Rerun My Searches Now in the Background!</button>
      </div>
    </div>
    <div>
      <div class="dev-header" data-action="click->tune-relevance#toggleSection" data-tune-relevance-section-param="search">Search Endpoints <i class="bi bi-plus-circle-fill"></i></div>
      <div class="dev-body d-none" data-tune-relevance-target="sectionBody" data-section-body="search">
        <p class="text-muted" data-tune-relevance-target="endpointEmpty" hidden>No search endpoints found. Create or share an endpoint to use it here.</p>
        <select class="form-select" data-tune-relevance-target="endpointSelect" data-action="change->tune-relevance#updateEndpoint"><option>Select endpoint</option></select>
        <div class="text-center my-2" data-tune-relevance-target="endpointChooser">OR</div>
        <input type="text" class="form-control" placeholder="Select endpoint to use" data-tune-relevance-target="endpointSearch" data-action="input->tune-relevance#filterEndpoints" autocomplete="off">
        <div class="list-group mt-1" data-tune-relevance-target="endpointSuggestions"></div>
        <p class="text-muted mt-1" data-tune-relevance-target="endpointNoResults" hidden>No matching search endpoints found.</p>
      </div>
    </div>
  </div>
</div>
