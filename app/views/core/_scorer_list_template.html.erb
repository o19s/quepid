<div data-scorer-catalog>
  <% { communal: @communal_scorers, custom: @user_scorers }.each do |kind, scorers| %>
    <ul data-catalog-list="<%= kind %>">
      <% scorers.each do |scorer| %>
        <li class="list-group-item"
            data-pick-scorer-core-target="item"
            data-pick-scorer-core-scorer-id-param="<%= scorer.id %>"
            data-scorer-json="<%= render(partial: "api/v1/scorers/#{kind == :communal ? 'communal_scorer' : 'scorer'}", formats: [:json], locals: { scorer: scorer }) %>"
            data-action="click->pick-scorer-core#selectScorer"><%= scorer.name %></li>
      <% end %>
    </ul>
  <% end %>
</div>
