<div id="dev-settings" data-bs-theme="dark" data-controller="tune-relevance">
  <ul class="nav nav-tabs" role="tablist">
    <li class="nav-item"><button type="button" class="nav-link" data-tune-tab="developer" aria-selected="true">Query</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-tune-tab="curator" aria-selected="false">Tuning Knobs</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-tune-tab="engineSettings" aria-selected="false">Settings</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-tune-tab="history" aria-selected="false">History</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-tune-tab="annotations" aria-selected="false">Annotations</button></li>
  </ul>

  <div id="queryParamsCanvas">
    <div class="settings-tab query-sandbox" data-tune-panel="developer">
      <p data-tune-relevance-target="staticEngineMessage" hidden>With a Static search endpoint there are no query settings to play with ;-(.</p>
      <div class="rerunnable-settings-tab" id="query-params-editor">
        <div class="d-flex justify-content-between align-items-center"><h4 class="mb-0">Query Sandbox:</h4><a href="http://quepidapp.com/docs/#tuning" class="query-help" target="_blank" rel="noopener noreferrer"><i class="bi bi-question-circle-fill" aria-hidden="true"></i></a></div>
        <p class="alert alert-warning" data-tune-relevance-target="queryWarning" hidden></p>
        <textarea id="tune-query-params" class="d-none" data-tune-relevance-target="queryEditor"></textarea>
      </div>
    </div>

    <div class="settings-tab" data-tune-panel="curator" hidden>
      <div class="rerunnable-settings-tab"><p data-tune-relevance-target="staticKnobsMessage" hidden>With a Static search endpoint there are no tuning knobs to play with ;-(.</p><h4>Tuning Knobs</h4><p class="form-text tip">Add and remove knobs from here by editing your query.</p><div data-tune-relevance-target="curatorVars"></div></div>
    </div>

    <div class="settings-tab" data-tune-panel="engineSettings" hidden>
      <div class="rerunnable-settings-tab">
        <div class="setting-div"><div class="dev-header" data-section="endpoint">Endpoint Details <i class="bi bi-dash-circle-fill"></i></div><div class="dev-body" data-section-body="endpoint"><p class="alert alert-warning" data-tune-relevance-target="endpointArchived" hidden><i class="bi bi-exclamation-triangle"></i> This search endpoint has been archived. Consider switching to an active endpoint.</p><p>Name: <span data-tune-relevance-target="endpointName"></span></p><p><img data-tune-relevance-target="endpointIcon" width="32" alt=""> &nbsp; <span data-tune-relevance-target="endpointUrl"></span></p><p><a data-tune-relevance-target="troubleshootingLink" target="_blank" rel="noopener noreferrer">Troubleshooting and Quepid <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a></p></div></div>
        <div class="setting-div"><div class="dev-header" data-section="fields">Displayed Fields <i class="bi bi-dash-circle-fill"></i></div><div class="dev-body" data-section-body="fields"><input class="form-control" data-tune-relevance-target="fieldSpec"><p class="alert alert-warning mt-2" data-tune-relevance-target="esTemplateWarning" hidden>When using ES/OS Query Templates, make sure that either your template includes the fields above in its source field filter section (<code>_source</code> declaration) or does not restrict the fields returned via <code>_source</code> at all.</p></div></div>
        <div class="setting-div"><div class="dev-header" data-section="rows">Number of Results to Show <i class="bi bi-dash-circle-fill"></i></div><div class="dev-setting-attribute" data-section-body="rows"><input class="form-control" min="1" max="100" type="number" data-tune-relevance-target="numberOfRows"></div></div>
        <div class="setting-div" data-tune-relevance-target="escapeSetting"><div class="dev-header" data-section="escape">Escape Queries <i class="bi bi-dash-circle-fill"></i></div><div class="dev-body form-check" data-section-body="escape"><input type="checkbox" id="escape-queries-checkbox" class="form-check-input" data-tune-relevance-target="escapeQuery"><label class="form-check-label" for="escape-queries-checkbox">Escape Queries</label></div></div>
        <div class="setting-div"><div class="dev-header" data-section="nightly">Evaluate Nightly? <i class="bi bi-dash-circle-fill"></i></div><div class="dev-body form-check" data-section-body="nightly"><input type="checkbox" id="evaluate-nightly-checkbox" class="form-check-input" data-tune-relevance-target="nightly" data-tune-action="nightly"><label class="form-check-label" for="evaluate-nightly-checkbox">Evaluate Case Nightly <i class="bi bi-repeat"></i></label><button type="button" class="btn btn-primary form-control mt-2" data-tune-relevance-target="runEvaluation" data-tune-action="run-evaluation">Rerun My Searches in the Background!</button></div></div>
        <div class="setting-div"><div class="dev-header" data-section="search">Search Endpoints <i class="bi bi-dash-circle-fill"></i></div><div class="dev-body" data-section-body="search"><p class="text-muted" data-tune-relevance-target="endpointEmpty" hidden>No search endpoints found. Create or share an endpoint to use it here.</p><select class="form-select" data-tune-relevance-target="endpointSelect"><option>Select endpoint</option></select><div class="text-center my-2" data-tune-relevance-target="endpointChooser">OR</div><input type="text" class="form-control" placeholder="Select endpoint to use" data-tune-relevance-target="endpointSearch"><div class="list-group mt-1" data-tune-relevance-target="endpointSuggestions"></div><p class="text-muted mt-1" data-tune-relevance-target="endpointNoResults" hidden>No matching search endpoints found.</p></div></div>
      </div>
    </div>

    <div class="settings-tab" data-tune-panel="history" hidden><div class="container-fluid"><p><a href="analytics/tries_visualization/<%= @case.id %>" target="_self">Visualize your tries</a> | <a href="cases/<%= @case.id %>/scores" target="_self">Check Scores</a> | <a href="cases/<%= @case.id %>/ratings" target="_self">Check Ratings</a></p><p>To switch back to a previous try, click on the try listing.</p><ul class="history-list" data-tune-relevance-target="historyList"></ul></div></div>

    <div class="settings-tab" data-tune-panel="annotations" hidden style="height: 100%;"><div id="annotations"><p>Annotations are like snapshots for scores. Create a new annotation to save the current case score along with a message to help you remember what the state of the case is at this moment.</p><strong>Why?</strong><p>You might have made changes that are invisible to Quepid and want to capture that information with the corresponding score.</p><p><a href="#annotations-list">Scroll down to view list of annotations</a></p><div class="mb-3"><label for="annotation-message">Message:</label><textarea id="annotation-message" class="form-control" rows="3" data-annotations-target="message"></textarea></div><div class="mb-3"><button class="btn btn-success" data-annotations-target="createButton" data-action="click->annotations#create">Create</button></div><div id="annotations-list" class="annotations"><h3>Existing Annotations</h3><p class="text-muted d-none" data-annotations-target="empty">No annotations yet.</p><ul data-annotations-target="list"></ul></div><div class="modal fade" tabindex="-1" aria-labelledby="editAnnotationModalLabel" aria-hidden="true" data-annotations-target="editModal"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="editAnnotationModalLabel">Edit Annotation</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><form><div class="modal-body"><label for="edit-annotation-message">New Message:</label><textarea id="edit-annotation-message" class="form-control" rows="3" data-annotations-target="editMessage"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary" data-annotations-target="editSave">Update</button></div></form></div></div></div></div></div>
  </div>

  <div data-tune-relevance-target="tlsWarning" class="alert alert-warning" hidden><a class="btn btn-primary form-control" data-tune-relevance-target="tlsReloadLink"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Reload Quepid in <code data-tune-relevance-target="tlsProtocol"></code> Protocol</a></div>
  <button type="button" class="btn btn-primary form-control" data-tune-action="save">Rerun My Searches!</button>

  <div class="modal fade" tabindex="-1" aria-labelledby="tuneTryDetailsLabel" aria-hidden="true" data-tune-relevance-target="tryModal">
    <div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h4 class="modal-title" id="tuneTryDetailsLabel" data-tune-relevance-target="tryTitle"></h4><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Dismiss"></button></div><div class="modal-body"><form class="d-flex flex-wrap align-items-center gap-2 mb-3" data-tune-relevance-target="tryRenameForm" hidden><label for="tune-try-name">Name:</label><input id="tune-try-name" type="text" class="form-control" data-tune-relevance-target="tryNameInput"><button type="submit" class="btn btn-sm btn-primary">Rename</button></form><div class="row"><div class="col-sm-3">Arguments</div><div class="col-sm-9"><pre><code data-tune-relevance-target="tryQueryParams"></code></pre></div></div><div class="row"><div class="col-sm-3">Search Endpoint</div><div class="col-sm-9"><a data-tune-relevance-target="tryEndpointLink" target="_self"></a> -- <a data-tune-relevance-target="tryBrowseLink" target="_blank" rel="noopener noreferrer">Browse Search Endpoint</a></div></div><div class="row"><div class="col-sm-3">Displayed Fields</div><div class="col-sm-9"><span data-tune-relevance-target="tryFieldSpec"></span></div></div><div class="row pt-3"><h4>Variables</h4></div><div data-tune-relevance-target="tryVariables"></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-tune-relevance-target="tryRenameAction" data-try-action="rename">Rename</button><button type="button" class="btn btn-outline-secondary" data-try-action="duplicate">Duplicate</button><button type="button" class="btn btn-danger" data-tune-relevance-target="tryDelete" data-try-action="delete">Delete</button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Dismiss</button></div></div></div>
  </div>
</div>
