<div
  class="results"
  id="query-container"
  data-controller="queries-list query-lifecycle"
  data-queries-list-query-list-sortable-value="<%= Rails.application.config.query_list_sortable %>"
  data-queries-list-position-url-value="api/cases/<%= kase.id %>/queries"
  data-query-lifecycle-case-id-value="<%= kase.id %>">
  <div class="row">
    <div class="col-sm-12 mb-3">
      <form
        class="d-flex align-items-center vertically-centered gap-2 float-start mb-2"
        data-controller="add-query"
        data-add-query-can-add-queries-value="true"
        data-add-query-placeholder-value="Add a query to this case"
        data-action="submit->add-query#submit">
        <div class="input-group">
          <input id="add-query" class="form-control" data-add-query-target="input"
            type="text" data-action="input->add-query#input">
          <input id="add-query-submit" class="btn btn-success" data-add-query-target="submit"
            type="submit" value="Add query">
        </div>
        <i class="spinner d-none" data-add-query-target="spinner"></i>
      </form>

      <ul class="list-inline d-flex justify-content-end flex-wrap mb-0 float-end">
        <li class="list-inline-item" data-queries-list-target="ratedLabel">
          <input type="checkbox" class="align-top" data-queries-list-target="ratedCheckbox" data-action="change->queries-list#toggleShowOnlyRated" />
          <a href="" data-action="click->queries-list#toggleShowOnlyRated">Show only rated</a>
        </li>

        <li class="list-inline-item text-muted"><span class="text-muted"> | </span></li>

        <li class="list-inline-item">
          <a data-action="click->queries-list#collapseAll" href="">Collapse all</a>
        </li>

        <li class="list-inline-item text-muted"><span class="text-muted"> | </span></li>

        <li class="list-inline-item">
          <span class="text-muted">Sort &nbsp;</span>
          <ul class="list-inline" style="display:inline" role="group" aria-label="sort">
            <li class="list-inline-item" data-queries-list-target="sortLink manualSortLink" data-sort-field="default">
              <a data-action="click->queries-list#sort" data-sort-field="default">Manual <i class="bi d-none" data-queries-list-target="sortIcon" data-sort-field="default" aria-hidden="true"></i></a>
            </li>
            <li class="list-inline-item d-none" data-queries-list-target="manualHelp">
              Manual
              <i class="bi bi-exclamation-circle-fill" tabindex="0" role="button" aria-label="Help" data-controller="bs-popover" data-bs-popover-trigger-value="mouseenter" data-bs-popover-placement-value="right" data-bs-popover-content-value="Manual sorting has been disabled by your administrator due to the bug https://github.com/o19s/quepid/issues/272."></i>
            </li>
            <li class="list-inline-item"><a data-queries-list-target="sortLink" data-sort-field="query" data-action="click->queries-list#sort">Name <i class="bi d-none" data-queries-list-target="sortIcon" data-sort-field="query" aria-hidden="true"></i></a></li>
            <li class="list-inline-item"><a data-queries-list-target="sortLink" data-sort-field="modified" data-action="click->queries-list#sort">Modified <i class="bi d-none" data-queries-list-target="sortIcon" data-sort-field="modified" aria-hidden="true"></i></a></li>
            <li class="list-inline-item"><a data-queries-list-target="sortLink" data-sort-field="score" data-action="click->queries-list#sort">Score <i class="bi d-none" data-queries-list-target="sortIcon" data-sort-field="score" aria-hidden="true"></i></a></li>
            <li class="list-inline-item"><a data-queries-list-target="sortLink" data-sort-field="error" data-action="click->queries-list#sort">Errors <i class="bi d-none" data-queries-list-target="sortIcon" data-sort-field="error" aria-hidden="true"></i></a></li>
          </ul>
        </li>
      </ul>

      <div class="clearfix"></div>
      <div class="d-flex flex-row-reverse flex-wrap">
        <div class="pe-3">Number of Queries: <span data-queries-list-target="count">0</span></div>
        <div class="pe-3"><input type="search" data-queries-list-target="filter" data-action="input->queries-list#filter" placeholder="Filter Queries" aria-label="filter queries" class="form-control form-control-sm" id="queries-filter" /></div>
        <div class="pe-3">
          <button type="button" class="btn btn-link p-0 frog-report-trigger" data-controller="frog-report" data-action="click->frog-report#open">
            <span class="frog-icon" aria-hidden="true">🐸</span><span>Report</span>
          </button>
        </div>
      </div>

      <div class="alert alert-info search-feedback d-none" role="alert" data-queries-list-target="bootstrapFeedback"><i class="bi bi-arrow-repeat spintime"></i> Bootstrapping Queries</div>
      <div class="alert alert-info search-feedback d-none" role="alert" data-queries-list-target="searchFeedback"><i class="bi bi-arrow-repeat spintime"></i> Updating Queries: <span data-queries-list-target="batchPosition">0</span> / <span data-queries-list-target="batchSize">0</span> <small class="text-muted">If the counter stalls, do a hard refresh of Quepid.</small></div>
      <ul class="results-list-element" data-queries-list-target="list"></ul>
    </div>
  </div>
  <div class="row"><div class="col-md-11"><div data-queries-list-target="pagination"></div></div></div>
</div>
