<%# Inline parts stay adjacent to preserve the annotation text spacing. %>
<li id="<%= dom_id(annotation) %>" class="annotation" data-annotation-id="<%= annotation.id %>">
  <div class="dropdown float-end">
    <button type="button" class="dropdown-toggle p-0 border-0 bg-transparent" data-bs-toggle="dropdown" aria-expanded="false"
            aria-label="Annotation actions"><i class="bi bi-list" aria-hidden="true"></i></button>
    <ul class="dropdown-menu">
      <li><button type="button" class="dropdown-item" data-action="click->annotations#openEdit"
                  data-annotation-id="<%= annotation.id %>"><i class="bi bi-pencil-fill"></i> Edit</button></li>
      <li><button type="button" class="dropdown-item text-danger" data-action="click->annotations#delete"
                  data-annotation-id="<%= annotation.id %>"><i class="bi bi-trash-fill"></i> Delete</button></li>
    </ul>
  </div>
  <em class="annotations-time"><time data-controller="relative-time" datetime="<%= annotation.created_at.iso8601(3) %>"></time> - </em><% if annotation.user&.display_name && !annotation.user.display_name.empty? %><span class="annotation-source">by <%= annotation.user.display_name %></span><% end %><% if annotation.source && !annotation.source.empty? %><span class="annotation-source">by <%= annotation.source %></span><% end %>
  <div><span>Try No: <%= annotation.score.try&.try_number || annotation.score.try_id %></span><i class="bi bi-circle-fill"></i><span class="annotation-score"> Score: <%= number_with_precision(annotation.score.score, precision: 2, delimiter: ',', separator: '.') unless annotation.score.score.nil? %></span></div>
  <div class="annotation-message"><%= annotation.message %></div>
</li>
