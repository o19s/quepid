<%= book_page_header @book, prefix: 'Bulk Judgements for' do %>
  <div class="btn-toolbar mb-2 mb-md-0">
    <div class="btn-group me-2">
      <%= link_to 'Back to Judge Overview', judge_overview_book_path(@book), class: "btn btn-sm btn-outline-secondary" %>
    </div>
  </div>
<% end %>

<div class="card">
  <div class="card-header">
    <%= render 'filters', book: @book, query_text: @query_text, only_unrated: @only_unrated,
                          available_positions: @available_positions, rank_depth: @rank_depth,
                          show_explanations: @show_explanations %>
  </div>

  <div class="card-body">
    <% if @grouped_query_doc_pairs.any? %>
      <%= render 'summary', book: @book, only_unrated: @only_unrated, total_count: @total_count,
                           rank_depth: @rank_depth, total_queries: @total_queries, pagy: @pagy %>

      <div data-controller="bulk-judgement"
           data-bulk-judgement-save-url-value="<%= book_judge_bulk_save_path(@book).delete_prefix('/') %>"
           data-bulk-judgement-delete-url-value="<%= book_judge_bulk_delete_path(@book).delete_prefix('/') %>">
        <template data-bulk-judgement-target="resetButtonTemplate"><%= render "reset_button" %></template>

        <% rating_buttons = generate_rating_buttons(@book) %>
        <% offset = @pagy.offset %>
        <% @grouped_query_doc_pairs.each do |query_text, query_doc_pairs| %>
          <%= render 'query_group', query_text:, query_doc_pairs:, offset:, rating_buttons:,
                                judgements: @judgements, show_explanations: @show_explanations %>
          <% offset += query_doc_pairs.size %>
        <% end %>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="d-flex justify-content-center mt-4">
          <%== @pagy.series_nav(:bootstrap) %>
        </div>
      <% end %>
    <% else %>
      <%= render 'no_results', book: @book, query_text: @query_text, only_unrated: @only_unrated,
                              rank_depth: @rank_depth, show_explanations: @show_explanations %>
    <% end %>
  </div>
</div>
