<%# locals: (user:, active_error_section:) %>
<div class="row mb-3">
  <hr>
  <%= form_with(model: user, url: account_path, method: :delete,
                data: { turbo_confirm: 'Are you sure you want to delete your account?' }) do |f| %>

    <h2 class="text-danger">
      Danger Zone
    </h2>
    <% if :danger_zone == active_error_section %>
      <%= render "shared/error_messages", record: user, subject: "", id: "error_explanation_danger_zone" %>
    <% end %>

    <p class="form-text">
      This will remove you from any existing teams, and delete any cases that you are the owner and only member of, as well as associated
      snapshots and all ratings that have been made.
    </p>

    <%= f.submit 'Delete your account', class: 'btn btn-primary' %>

  <% end %>
</div>
