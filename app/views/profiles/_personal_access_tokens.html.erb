<%# locals: (user:) %>
<div class="row mb-3">
  <hr>

  <h2>
    Personal Access Tokens
  </h2>

  <p class="form-text">
    These tokens, sometimes called a Bearer Token, allow you to access Quepid's <%= link_to 'APIs', oas_rails_path %>. Treat these like you would your password!
    <br>
    For example: <code>curl -H "Authorization: Bearer YOUR_TOKEN" <%= link_to api_user_url(user), api_user_url(user) %></code> to look at your own details.
  </p>
  <% if flash[:api_key_token] %>
    <div class="alert alert-warning" role="alert">
      Your new token is <code id="new-api-key-token"><%= flash[:api_key_token] %></code>.
      Copy it now: Quepid only stores a digest of it, so it can't show it to you again.
    </div>
  <% end %>
  <table class="table table-hover table-sm mt-3">
    <thead>
      <tr>
        <th>Api Key Id</th>
        <th>Created</th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <% user.api_keys.each do |api_key| %>
        <tr>
          <td><%= api_key.id %></td>
          <td><%= l api_key.created_at, format: :long %></td>
          <td><%= button_to 'Destroy', api_key_path(api_key),class: "btn btn-sm btn-outline-danger", method: :delete, form: { data: { turbo_confirm: 'Are you sure you want to delete this personal access token?' } } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="my-3">
    <%= button_to 'Generate new Token', api_keys_path, method: :post, class: 'btn btn-primary' %>
  </div>

</div>
