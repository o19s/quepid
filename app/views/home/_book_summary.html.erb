<div class="col-12 col-md-6 mb-4 mb-lg-0 col-lg-3">
  <div class="card h-100">
    <h5 class="card-header">
      <i class="bi bi-book me-1" aria-hidden="true"></i>
      <%= link_to book.name, book_path(book), data: { turbo_prefetch: false } %>
    </h5>

    <div class="card-body">
      <turbo-frame id="book_frame_<%= book.id %>" src="<%= home_book_summary_detail_path(book) %>" loading="eager">
        <h5 class="card-title placeholder-glow" aria-hidden="true"><span class="placeholder col-11"></span></h5>
        <p class="card-text placeholder-glow">
          <span class="placeholder col-11"></span>
        </p>
      </turbo-frame>

      <span id="notification-book-<%= book.id %>">
      </span>

      <%= link_to 'Judge', book_judge_path(book), data: { turbo_prefetch: false }, class: 'btn btn-sm btn-primary', role: 'button' %>
    </div>
  </div>
</div>
