<% turbo_page_requires_reload if turbo_frame_request_id == "query_doc_pair_card" %>
<%= turbo_stream_from(current_user, :notifications) %>
<%= turbo_stream_from(@book.judgements_broadcast_channel) %>
<%= turbo_stream_from(current_user, @book, :judgements) %>


<%= turbo_frame_tag "modal" %>

<%= book_page_header @book do %>
  <div class="btn-toolbar mb-2 mb-md-0">
    <div class="btn-group me-2">
      <% if @book.archived? %>
        <%= button_to 'Unarchive', unarchive_book_path(@book), method: :patch,
                    class: "btn btn-sm btn-outline-success",
                    form: { data: { turbo_confirm: "Are you sure you want to unarchive this book?", turbo_confirm_style: "primary" } } %>
      <% else %>
        <%= button_to 'Archive', archive_book_path(@book), method: :patch,
                    class: "btn btn-sm btn-outline-warning",
                    form: { data: { turbo_confirm: "Are you sure you want to archive this book?" } } %>
      <% end %>
    </div>
  </div>
<% end %>
<p class="text-muted mt-2">
  Books organize the query/doc pairs needed for evaluating search queries.
  This book has <%= pluralize(@book.queries_count, 'query') %> and <%= pluralize(@book.query_doc_pairs.count, 'query/doc pair') %>.
</p>

<%= render 'kraken_unleashed', book: @book if @kraken_unleashed %>

<% available_ai_judges = available_ai_judges_for_book(@book, current_user).to_a %>
<% if @book.ai_judges.present? %>
  <div class="mb-2">
    <i class="bi bi-robot"></i>
    We have <%= @book.ai_judges.count == 1 ? 'an' : 'some' %> AI <%= @book.ai_judges.count == 1 ? 'Judge' : 'Judges' %>
    <i><%= @book.ai_judges.map(&:name).to_sentence %></i> helping us rate documents.
  </div>
<% elsif available_ai_judges.any? %>
  <div class="alert alert-info mb-3" role="alert">
    <h6><i class="bi bi-robot"></i> AI Judges Available</h6>
    <p class="mb-2">
      You have AI judges available that could help rate documents automatically: <strong><%= available_ai_judges.pluck(:name).to_sentence %></strong>
    </p>
    <%= link_to 'Add AI Judge to this Book', edit_book_path(@book), class: 'btn btn-sm btn-outline-primary' %>
  </div>
<% end %>

<%# ── Status alerts ────────────────────────────────────────────────────────── %>
<% if @book.import_file.attached? %>
  <div class="alert alert-warning" role="alert">
    <i class="bi bi-arrow-clockwise"></i> Import in progress — <%= @book.query_doc_pairs.count %> pairs loaded so far.
    <%= link_to book_path(@book), class: 'alert-link' do %><i class="bi bi-arrow-clockwise"></i> Refresh<% end %>
  </div>
<% end %>
<% if @book.populate_job.present? %>
  <div class="alert alert-info" role="alert">
    <i class="bi bi-gear-wide-connected"></i> Populating book from case — <%= @book.query_doc_pairs.count %> pairs so far.
    <%= link_to book_path(@book), class: 'alert-link' do %><i class="bi bi-arrow-clockwise"></i> Refresh<% end %>
  </div>
<% end %>
<% if @count_of_anonymous_book_judgements > 0 %>
  <div class="alert alert-warning" role="alert">
    <i class="bi bi-person-exclamation"></i> <%= @count_of_anonymous_book_judgements %> anonymous judgements could be mapped to a user.
  </div>
<% end %>

<%= render "books/coverage_summary", total_pairs: @total_pairs, coverage_pct: @coverage_pct,
           complete_count: @complete_count, zero_judgement_count: @zero_judgement_count,
           partial_count: @partial_count, cases: @cases %>

<%= render "books/judge_activity_card", book: @book, judge_activity: @judge_activity,
           available_ai_judges: available_ai_judges %>

<div class="row">
  <%# ── Case management ────────────────────────────────────────────────────── %>
  <div class="col-md-6">
    <div class="card mb-4 h-100">
      <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-briefcase"></i> Linked Cases</h5>
      </div>
      <div id="linked-cases-list" class="d-flex flex-column flex-grow-1">
        <%= render 'books/linked_cases_list', book: @book, cases: @cases %>
      </div>
    </div>
  </div>

  <%# ── Book metadata ──────────────────────────────────────────────────────── %>
  <div class="col-md-6">
    <%= render "books/settings_summary", book: @book %>
  </div>
</div>

<%= render partial: 'unleash_modal', collection: @book.ai_judges, as: :ai_judge, locals: { book: @book } %>
<% ai_judges_for_modals = (@book.ai_judges + @judge_activity.to_a.map { |r| r[:judge] }.select(&:ai_judge?)).uniq %>
<%= render partial: 'judging_modal', collection: ai_judges_for_modals, as: :ai_judge, locals: { book: @book } %>
