<%# locals: (book:, cases:) %>
<% if cases.any? %>
  <div class="card-body">
    <div class="d-inline-flex align-items-stretch">
      <div>
        <% cases.each do |kase| %>
          <div class="d-flex align-items-center justify-content-between py-2 <%= 'border-bottom' unless kase == cases.last %>">
            <div>
              <%= link_to_core_case case_title(kase), kase, kase.last_try_number %>
              <div class="text-muted small">Updated <%= time_ago_in_words(kase.updated_at) %> ago</div>
            </div>
            <div class="fs-4 mx-3" id="case-sync-icon-<%= kase.id %>">
              <% sends_pairs = kase.auto_populate_book_pairs? %>
              <% receives_ratings = kase.auto_populate_case_judgements? %>
              <% populating_book = PopulateBookJob.actively_populating?(book, kase) %>
              <% syncing_case = UpdateCaseJob.actively_syncing?(book, kase) || UpdateCaseRatingsJob.actively_syncing?(book, kase) %>
              <% if sends_pairs && receives_ratings %>
                <i class="bi bi-arrow-left-right text-success <%= 'icon-pulse' if populating_book || syncing_case %>" title="Sends query/doc pairs to book and receives judgement ratings back"></i>
              <% elsif sends_pairs %>
                <i class="bi bi-arrow-right text-success <%= 'icon-pulse' if populating_book %>" title="Sends query/doc pairs to book"></i>
              <% elsif receives_ratings %>
                <i class="bi bi-arrow-left text-success <%= 'icon-pulse' if syncing_case %>" title="Receives judgement ratings from book"></i>
              <% else %>
                <i class="bi bi-circle text-muted" title="Linked, but no automatic sync"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="d-flex align-items-center justify-content-center border-start ps-4 ms-3">
        <div class="text-center text-nowrap">
          <i class="bi bi-book fs-2 text-body"></i>
          <div class="fw-semibold"><%= book_title book %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="card-footer text-muted small">
    <i class="bi bi-arrow-right"></i> Sends pairs &nbsp;|&nbsp;
    <i class="bi bi-arrow-left"></i> Receives ratings &nbsp;|&nbsp;
    <i class="bi bi-arrow-left-right"></i> Both &nbsp;|&nbsp;
    <i class="bi bi-circle"></i> Linked, no auto-sync
  </div>
<% else %>
  <div class="card-body text-muted">
    No cases linked. Link a case via <a href="<%= edit_book_path(book) %>">Settings</a> or create a book directly from a case.
  </div>
<% end %>
