<%# locals: (judge_activity:, book:, flashing_judge_id: nil) %>
<% if judge_activity.any? %>
  <% judge_activity.each do |row| %>
    <%= render 'books/judge_activity_row', row: row, flash_active: row[:judge].id == flashing_judge_id, book: book %>
  <% end %>
<% else %>
  <tr id="judge-activity-empty">
    <td colspan="4"><%= render 'shared/empty_state', message: 'No judging activity yet.' %></td>
  </tr>
<% end %>
