<%= turbo_stream_from(:notifications) %>

<% title = capture do %>
  <i class="bi bi-book"></i> Books <%= "(Archived)" if params[:archived] == 'true' %>
<% end %>
<%= page_header title do %>
  <div class="btn-toolbar mb-2 mb-md-0">
    <div class="btn-group me-2">
      <% if params[:archived] == 'true' %>
        <%= link_to 'View Active Books', books_path, class: "btn btn-sm btn-outline-primary" %>
      <% else %>
        <%= link_to 'New Book', new_book_path, class: "btn btn-sm btn-outline-primary" %>
        <%= link_to 'Import Book', new_books_import_path, class: "btn btn-sm btn-outline-secondary" %>
        <%= link_to 'View Archived Books', books_path(archived: true), class: "btn btn-sm btn-outline-warning" %>
      <% end %>
    </div>
  </div>
<% end %>


<p id="notice"><%= notice %></p>
<% if params[:archived] != 'true' && @books.empty? && params[:q].blank? && params[:team_id].blank? %>
  <div class="alert alert-primary" role="alert">
    Create your first book by clicking on the New Book button above.
  </div>
<% end %>

<div class="card">
  <div class="card-header">
    <%= form_tag(books_path, { method: :get }) do %>
      <%= hidden_field_tag :archived, params[:archived] if params[:archived] %>
      <div class="mb-0 d-flex flex-wrap align-items-center gap-3 fs-6">

        <!-- Search input with fixed width -->
        <div class="input-group" style="max-width: 300px;">
          <%= text_field_tag :q, params[:q],
              class: 'form-control form-control-sm',
              placeholder: 'Filter by book name or team name',
              id: 'q'
          %>
          <%= button_tag type: 'submit', class: 'btn btn-sm btn-outline-secondary' do %>
            <i class="bi bi-search-heart"></i>
          <% end %>
        </div>

        <!-- Team dropdown -->
        <%= select_tag :team_id,
            options_for_select(
              [['All', '']] + @current_user.teams.map { |j| [j.name, j.id] },
              params[:team_id]
            ),
            class: 'form-select form-select-sm',
            style: 'width: auto; min-width: 140px;',
            id: 'team_id',
            onchange: 'this.form.submit()'
        %>

      </div>
    <% end %>
  </div>
  
  <div class="card-body">
    <table class="table table-hover table-sm">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Teams</th>
          <th>Scale</th>
          <th>Status</th>
          <th class="text-end"></th>
        </tr>
      </thead>
  
      <tbody>      
        <%= render partial: "book", collection: @books, as: :book %> 
      </tbody>
    </table>
  </div>
  <div class="card-footer d-flex justify-content-center">
    <%== @pagy.series_nav(:bootstrap) %>
  </div>
</div>

<%= render 'shared/share_book_modal' %>
