<% title = capture do %>
  <i class="bi bi-book"></i> Create a Book
<% end %>
<%= page_header title do %>
  <div class="btn-toolbar mb-2 mb-md-0">
    <div class="btn-group me-2">
      <%= link_to 'Back to Books', books_path, class: "btn btn-sm btn-outline-secondary" %>
    </div>
  </div>
<% end %>

<%= render 'form', book: @book %>
