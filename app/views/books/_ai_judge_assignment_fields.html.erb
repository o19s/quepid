<%# locals: (form:, book:, ai_judges:) %>
<div class="mb-3">
  <i class="bi bi-robot"></i>
  <%= form.label :teams, "AI Judges Assigned to this Book", class: 'form-label' %>
  <%= form.collection_check_boxes(:ai_judge_ids, ai_judges, :id, :name) do |b| %>
    <div>
      <%= b.check_box %>
      <%= b.label %>
      <% if b.object.escalates_to %>
        <small class="text-muted ms-1" title="Pairs this judge can't rate are handed on, in every book it judges">
          <i class="bi bi-arrow-right" aria-hidden="true"></i>
          <%= link_to "wakes #{b.object.escalates_to.name} when unsure",
                "#{edit_ai_judge_path(b.object, book_id: book.id)}#escalation-field" %>
        </small>
      <% end %>
      <% if b.object.on_call? %>
        <span class="badge text-bg-info ms-1" title="Woken by <%= b.object.escalated_from_names %>; no need to assign it here">
          <i class="bi bi-moon-stars" aria-hidden="true"></i> On call
        </span>
      <% end %>
      <div class="form-check form-switch ms-4">
        <%= check_box_tag 'book[auto_run_ai_judge_ids][]', b.value,
              book.books_ai_judges.any? { |assignment| assignment.user_id == b.value && assignment.auto_run? },
              id: "auto_run_#{b.value}", class: 'form-check-input' %>
        <%= label_tag "auto_run_#{b.value}", 'Auto-run on new pairs', class: 'form-check-label' %>
      </div>
    </div>
  <% end %>
  <%= hidden_field_tag 'book[auto_run_ai_judge_ids][]', '' %>
  <div class="form-text">
    You can have multiple AI judges creating ratings. Only AI judges you own, or that are shared with one of your teams, are available here - regardless of which teams you choose to share this book with above.
    <br/><i class="bi bi-repeat"></i> <strong>Auto-run:</strong> automatically queue this judge whenever new query/doc pairs are added to the book.
    <br/><i class="bi bi-arrow-right"></i> <strong>Wakes … when unsure:</strong> pairs this judge can't rate are handed to that judge once its run ends. The woken judge is <strong>on call</strong> and doesn't need to be assigned here; set who wakes whom on the AI judge's own page.
    <% if book.new_record? && ai_judges.empty? %>
      <br/>Please create the book first and then use <b>Settings</b> to add AI judges.
    <% end %>
  </div>
</div>
