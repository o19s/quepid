<%# locals: (row:, flash_active: false, book: nil) %>
<% is_ai_judge = row[:judge].ai_judge? %>
<% can_refine = is_ai_judge && row[:refinable] == true %>
<% icon_btn_style = 'font-size:0.7rem; width:1.6rem; height:1.6rem; padding:0; ' \
                    'display:inline-flex; align-items:center; justify-content:center;' %>
<td id="judge-status-<%= row[:judge].id %>" data-actively-judging="<%= row[:actively_judging] %>">
  <% if is_ai_judge %>
    <i class="bi bi-robot <%= row[:actively_judging] ? 'text-primary' : 'text-secondary' %> <%= 'judge-icon-flash' if flash_active %>"
       id="judge-icon-<%= row[:judge].id %>"></i>
  <% else %>
    <%= avatar_tag row[:judge], size: 18, classes: (flash_active ? 'judge-icon-flash' : '') %>
  <% end %>
  <%= row[:judge].fullname %>
  <% if is_ai_judge && row[:auto_run] %>
    <i class="bi bi-repeat text-muted" title="Auto-runs when new query/doc pairs are added"></i>
  <% end %>
  <% if row[:on_call] %>
    <span class="badge text-bg-info" title="Sleeps until a judge on this book escalates a pair to it">
      <i class="bi bi-moon-stars" aria-hidden="true"></i> On call
    </span>
  <% end %>
  <% if is_ai_judge %>
    <span class="d-inline-flex align-items-center gap-1 ms-1">
      <% if row[:actively_judging] %>
        <button class="btn btn-primary btn-sm"
                data-bs-toggle="modal"
                data-bs-target="#judging-modal-<%= row[:judge].id %>"
                style="<%= icon_btn_style %>"
                title="Click to see what's being judged">
          <span class="spinner-grow" style="width:1em; height:1em;" role="status" aria-hidden="true"></span>
        </button>
        <%= render 'books/cancel_judging_button', book: book, judge: row[:judge],
              css_class: 'btn btn-outline-danger btn-sm',
              style: icon_btn_style,
              icon: 'bi-x-circle', title: 'Cancel judging' %>
      <% elsif !row[:on_call] %>
        <button type="button"
                class="btn btn-outline-success btn-sm"
                style="<%= icon_btn_style %>"
                title="Judge documents"
                data-bs-toggle="modal"
                data-bs-target="#unleash_modal_<%= row[:judge].id %>">
          <i class="bi bi-play-fill"></i>
        </button>
      <% end %>
      <% if can_refine %>
        <%= link_to edit_ai_judge_path(row[:judge], book_id: book.id),
              class: 'btn btn-outline-secondary btn-sm',
              style: icon_btn_style,
              title: 'Refine Prompt' do %>
          <i class="bi bi-sliders"></i>
        <% end %>
      <% end %>
    </span>
    <% if row[:wakes] %>
      <div class="small text-muted ms-4" title="Pairs this judge can't rate are handed on">
        <i class="bi bi-arrow-return-right" aria-hidden="true"></i> wakes <%= row[:wakes] %> when unsure
      </div>
    <% end %>
  <% end %>
  <% if book %>
    <span class="d-inline-flex align-items-center gap-1 ms-1">
      <% if row[:count].positive? %>
        <%= button_to delete_ratings_by_assignee_book_path(book, user_id: row[:judge].id),
              method: :delete,
              form_class: 'd-inline',
              class: 'btn btn-outline-danger btn-sm',
              style: icon_btn_style,
              title: 'Delete this judge\'s judgements from this book',
              form: { data: { turbo_confirm: "Delete all #{row[:count]} judgements by #{row[:judge].fullname} from this book?" } } do %>
          <i class="bi bi-eraser"></i>
        <% end %>
      <% end %>
      <% if row[:assigned] %>
        <%= button_to remove_ai_judge_book_path(book, ai_judge_id: row[:judge].id),
              method: :delete,
              form_class: 'd-inline',
              class: 'btn btn-outline-danger btn-sm',
              style: icon_btn_style,
              title: 'Remove this judge from the book (keeps its judgements)',
              form: { data: { turbo_confirm: "Remove #{row[:judge].fullname} from this book? Its judgements are kept." } } do %>
          <i class="bi bi-person-x"></i>
        <% end %>
      <% end %>
    </span>
  <% end %>
</td>
