<%# locals: (book:, judges:, references:, samples:, preselected_judge_id: nil) %>
<div class="modal fade" id="new_calibration_modal" tabindex="-1" aria-labelledby="new_calibration_modal_label" aria-hidden="true"
     data-controller="calibration-dialog"
     data-calibration-dialog-min-value="<%= CalibrationSample::MIN_SIZE %>"
     data-calibration-dialog-max-value="<%= CalibrationSample::MAX_SIZE %>"
     data-calibration-dialog-open-value="<%= preselected_judge_id.present? %>">
  <div class="modal-dialog modal-lg">
    <%= form_with url: book_calibrations_path(book), scope: :calibration, class: 'modal-content',
                  data: { calibration_dialog_target: 'form' } do %>
      <div class="modal-header">
        <h5 class="modal-title" id="new_calibration_modal_label"><i class="bi bi-bullseye" aria-hidden="true"></i> New calibration</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row mb-3">
          <label for="calibration_judge_id" class="col-sm-4 col-form-label">Judge to calibrate</label>
          <div class="col-sm-8">
            <select id="calibration_judge_id" name="calibration[judge_id]" class="form-select"
                    data-calibration-dialog-target="judge" data-action="change->calibration-dialog#update">
              <option value="">Choose an AI judge…</option>
              <% judges.each do |judge| %>
                <option value="<%= judge.id %>" data-name="<%= judge.name %>"
                        <%= 'selected' if judge.id == preselected_judge_id %>>
                  <%= judge.name %><%= " (#{judge.judge_options[:llm_model]})" if judge.judge_options[:llm_model].present? %>
                </option>
              <% end %>
            </select>
            <div class="form-text">Any AI judge you can see, whether or not it's assigned to this book.</div>
          </div>
        </div>

        <div class="row mb-3">
          <label for="calibration_reference_id" class="col-sm-4 col-form-label">Compare against</label>
          <div class="col-sm-8">
            <select id="calibration_reference_id" name="calibration[reference_id]" class="form-select"
                    data-calibration-dialog-target="reference" data-action="change->calibration-dialog#update">
              <option value="">Choose a judge who has rated pairs…</option>
              <% references.each do |reference| %>
                <% judge = reference[:judge] %>
                <%# AI judges go by the name the judge list above uses, not fullname's titlecase. %>
                <% name = judge.ai_judge? ? judge.name : judge.fullname %>
                <option value="<%= judge.id %>" data-name="<%= name %>" data-eligible-pairs="<%= reference[:eligible_pairs] %>">
                  <%= name %> (<%= judge.ai_judge? ? 'AI' : 'human' %>) — <%= pluralize(reference[:eligible_pairs], 'pair') %>
                </option>
              <% end %>
            </select>
            <div class="form-text" data-calibration-dialog-target="referenceHint">
              <% if references.empty? %>
                Nobody has rated pairs on this book's scale yet, so there's nothing to compare against.
              <% else %>
                The sample is drawn at random from the pairs this judge rated on the book's scale.
              <% end %>
            </div>
          </div>
        </div>

        <div class="row mb-3">
          <label for="calibration_sample_size" class="col-sm-4 col-form-label">Sample size</label>
          <div class="col-sm-8">
            <input type="number" id="calibration_sample_size" name="calibration[sample_size]" class="form-control"
                   value="<%= CalibrationSample::DEFAULT_SIZE %>"
                   min="<%= CalibrationSample::MIN_SIZE %>" max="<%= CalibrationSample::MAX_SIZE %>"
                   data-calibration-dialog-target="sampleSize" data-action="input->calibration-dialog#update">
            <div class="form-text" data-calibration-dialog-target="sampleHint">
              Between <%= CalibrationSample::MIN_SIZE %> and <%= CalibrationSample::MAX_SIZE %> pairs.
            </div>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-sm-4 col-form-label pt-0">Pairs</div>
          <div class="col-sm-8">
            <div class="form-check">
              <input class="form-check-input" type="radio" name="calibration[pairs]" id="calibration_pairs_new" value="new" checked
                     data-calibration-dialog-target="pairsNew" data-action="change->calibration-dialog#update">
              <label class="form-check-label" for="calibration_pairs_new">New random sample</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="calibration[pairs]" id="calibration_pairs_same" value="same"
                     <%= 'disabled' if samples.empty? %>
                     data-calibration-dialog-target="pairsSame" data-action="change->calibration-dialog#update">
              <label class="form-check-label <%= 'text-muted' if samples.empty? %>" for="calibration_pairs_same">
                Same pairs as an earlier calibration<%= ' — none on this book yet' if samples.empty? %>
              </label>
            </div>
            <% if samples.any? %>
              <select name="calibration[sample_id]" class="form-select mt-2" aria-label="Earlier calibration's pairs" disabled
                      data-calibration-dialog-target="sample" data-action="change->calibration-dialog#update">
                <option value="">Choose whose pairs to reuse…</option>
                <% samples.each do |sample| %>
                  <% reference_name = sample.reference.ai_judge? ? sample.reference.name : sample.reference.fullname %>
                  <option value="<%= sample.id %>" data-reference-id="<%= sample.reference_id %>"
                          data-reference-name="<%= reference_name %>" data-size="<%= sample.size %>">
                    <% calibrated = sample.runs.map { |sample_run| sample_run.judge.name }.uniq %>
                    <%= pluralize(sample.size, 'pair') %> rated by <%= reference_name %><% if calibrated.any? %> · calibrated <%= calibrated.to_sentence %><% end %> · <%= time_ago_in_words(sample.created_at) %> ago
                  </option>
                <% end %>
              </select>
            <% end %>
          </div>
        </div>

        <div class="alert alert-warning d-none" role="alert" data-calibration-dialog-target="problem"></div>
      </div>
      <div class="modal-footer justify-content-between">
        <span class="text-muted" data-calibration-dialog-target="summary"></span>
        <button type="submit" class="btn btn-primary" disabled data-calibration-dialog-target="submitButton">Start</button>
      </div>
    <% end %>
  </div>
</div>
