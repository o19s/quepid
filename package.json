{
  "name": "quepid",
  "repository": {
    "type": "git",
    "url": "https://github.com/o19s/quepid.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@rails/actioncable": "8.1.301",
    "@rails/activestorage": "8.1.301",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.10.3",
    "clipboard": "^2.0.11",
    "esbuild": "^0.28.0",
    "file-saver": "^2.0.5",
    "local-time": "^3.0.0",
    "sortablejs": "^1.15.6",
    "splainer-search": "3.3.0",
    "tether-shepherd": "latest",
    "urijs": "^1.19.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.49.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^22.0.0",
    "chokidar": "5.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "happy-dom": "^20.0.10",
    "prettier": "^3.6.2",
    "purgecss": "^8.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^4.0.0"
  },
  "resolutions": {},
  "scripts": {
    "build:core-case": "node esbuild.config.js core-case",
    "build:core-vendor": "node esbuild.config.js core-vendor",
    "build:core": "yarn build:core-case && yarn build:core-vendor",
    "build:analytics": "node esbuild.config.js analytics",
    "build:css": "node build_css.js",
    "build:css:watch": "node build_css.js --watch",
    "audit:css": "node audit_css.js",
    "audit:css:host": "mkdir -p tmp/css-audit-host && CSS_AUDIT_DIR=tmp/css-audit-host node audit_css.js",
    "lint:css": "stylelint \"app/assets/stylesheets/**/*.css\"",
    "lint:js": "eslint app/javascript test/javascript scripts config/javascript_lint_scope.mjs eslint.config.mjs stryker.config.mjs build_css.js audit_css.js esbuild.config.js vitest.config.js lib db/scorers db/mapper_based_search_engines",
    "format:js": "node scripts/javascript_lint.mjs write",
    "format:js:check": "node scripts/javascript_lint.mjs check",
    "build": "yarn build:css && yarn build:core && yarn build:analytics",
    "test": "yarn test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test --config test/playwright/playwright.config.ts",
    "test:e2e:update-baselines": "playwright test --config test/playwright/playwright.config.ts --update-snapshots",
    "test:e2e:ui": "playwright test --config test/playwright/playwright.config.ts --ui",
    "screenshots:view": "node test/playwright/screenshot-viewer-server.mjs"
  }
}
