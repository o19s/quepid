{
  "name": "quepid",
  "repository": {
    "type": "git",
    "url": "https://github.com/o19s/quepid.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@rails/actioncable": "8.1.301",
    "@rails/activestorage": "8.1.301",
    "ace-builds": "^1.43.4",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.10.3",
    "clipboard": "^2.0.11",
    "esbuild": "^0.28.0",
    "file-saver": "^2.0.5",
    "jquery": "^3.7.1",
    "local-time": "^3.0.0",
    "sortablejs": "^1.15.6",
    "splainer-search": "3.3.0",
    "tether-shepherd": "latest",
    "urijs": "^1.19.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.49.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^22.0.0",
    "chokidar": "5.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "happy-dom": "^20.0.10",
    "prettier": "^3.6.2",
    "purgecss": "^8.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^4.0.0"
  },
  "resolutions": {},
  "scripts": {
    "build:jquery": "esbuild app/javascript/jquery_bundle.js --bundle --sourcemap --format=iife --platform=browser --outdir=app/assets/builds --public-path=/assets",
    "build:case-runtime": "esbuild app/javascript/case_runtime.js --bundle --sourcemap --format=iife --platform=browser --outdir=app/assets/builds --public-path=/assets --alias:utils=./app/javascript/utils --alias:api=./app/javascript/api",
    "build:core-vendor": "esbuild app/javascript/core_vendor.js --bundle --sourcemap --format=iife --outdir=app/assets/builds --public-path=/assets --loader:.css=css --loader:.png=dataurl --loader:.svg=dataurl --loader:.woff=dataurl --loader:.woff2=dataurl --loader:.ttf=dataurl --loader:.eot=dataurl --external:jquery --alias:utils=./app/javascript/utils --alias:api=./app/javascript/api",
    "build:core-legacy": "node build_core_legacy.js",
    "build:core-legacy:watch": "node build_core_legacy.js --watch",
    "build:core": "yarn build:case-runtime && yarn build:core-vendor && yarn build:core-legacy",
    "build:analytics": "esbuild app/javascript/analytics.js --bundle --sourcemap --format=iife --outdir=app/assets/builds --public-path=/assets",
    "build:css": "node build_css.js",
    "build:css:watch": "node build_css.js --watch",
    "audit:css": "node audit_css.js",
    "audit:css:host": "mkdir -p tmp/css-audit-host && CSS_AUDIT_DIR=tmp/css-audit-host node audit_css.js",
    "lint:css": "stylelint \"app/assets/stylesheets/**/*.css\"",
    "lint:js": "eslint app/javascript",
    "lint:js:legacy": "eslint \"app/assets/javascripts/**/*.js\"",
    "format:js": "node scripts/javascript_lint.mjs write",
    "format:js:check": "node scripts/javascript_lint.mjs check",
    "format:js:legacy:check": "prettier --check \"app/assets/javascripts/**/*.js\"",
    "build": "yarn build:css && yarn build:jquery && yarn build:core && yarn build:analytics",
    "test": "yarn test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test --config test/playwright/playwright.config.ts",
    "test:e2e:update-baselines": "playwright test --config test/playwright/playwright.config.ts --update-snapshots",
    "test:e2e:ui": "playwright test --config test/playwright/playwright.config.ts --ui",
    "screenshots:view": "node test/playwright/screenshot-viewer-server.mjs"
  }
}
