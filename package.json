{
  "name": "quepid",
  "repository": {
    "type": "git",
    "url": "https://github.com/o19s/quepid.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@floating-ui/dom": "^1.8.0",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@rails/actioncable": "8.1.400",
    "@rails/activestorage": "8.1.400",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.10.3",
    "esbuild": "^0.28.0",
    "local-time": "^3.0.0",
    "shepherd.js": "^15.3.0",
    "sortablejs": "^1.15.6",
    "splainer-search": "3.3.0",
    "tom-select": "^2.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.0",
    "@herb-tools/linter": "^0.11.0",
    "@playwright/test": "^1.49.0",
    "@stryker-mutator/core": "https://github.com/davidshq/stryker-js/releases/download/crash-recovery-v10.0.0-3/stryker-mutator-core-10.0.0.tgz",
    "@stryker-mutator/vitest-runner": "https://github.com/davidshq/stryker-js/releases/download/crash-recovery-v10.0.0-3/stryker-mutator-vitest-runner-10.0.0.tgz",
    "@types/node": "^24.0.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "chokidar": "5.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "fast-check": "^4.10.2",
    "globals": "^17.0.0",
    "happy-dom": "^20.0.10",
    "pixelmatch": "^8.0.0",
    "prettier": "^3.6.2",
    "purgecss": "^8.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "resolutions": {
    "@stryker-mutator/api": "https://github.com/davidshq/stryker-js/releases/download/crash-recovery-v10.0.0-3/stryker-mutator-api-10.0.0.tgz"
  },
  "scripts": {
    "build:core-case": "node esbuild.config.js core-case",
    "build:core": "yarn build:core-case",
    "build:css": "node build_css.js",
    "build:css:watch": "node build_css.js --watch",
    "audit:css": "node audit_css.js",
    "audit:css:host": "mkdir -p tmp/css-audit-host && CSS_AUDIT_DIR=tmp/css-audit-host node audit_css.js",
    "lint:css": "stylelint \"app/assets/stylesheets/**/*.css\"",
    "format:css": "prettier --write \"app/assets/stylesheets/**/*.css\"",
    "format:css:check": "prettier --check \"app/assets/stylesheets/**/*.css\"",
    "fix:css": "stylelint --fix \"app/assets/stylesheets/**/*.css\"; status=$?; prettier --write \"app/assets/stylesheets/**/*.css\" && exit $status",
    "lint:erb": "herb-lint",
    "lint:js": "eslint app/javascript test/javascript test/playwright scripts config/javascript_lint_scope.mjs eslint.config.mjs stryker.config.mjs build_css.js audit_css.js esbuild.config.js vitest.config.js lib db/scorers db/mapper_based_search_engines",
    "format:js": "node scripts/javascript_lint.mjs write",
    "format:js:check": "node scripts/javascript_lint.mjs check",
    "build": "yarn build:css && yarn build:core",
    "test": "yarn test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:mutation": "stryker run",
    "test:mutation:compat": "yarn test:mutation test/mutation/vitest_compat.config.mjs",
    "test:mutation:nightly": "yarn test:mutation test/mutation/nightly.config.mjs",
    "typecheck:e2e": "tsc -p test/playwright/tsconfig.json",
    "test:e2e": "playwright test --config test/playwright/playwright.config.ts",
    "test:e2e:update-baselines": "playwright test --config test/playwright/playwright.config.ts --update-snapshots",
    "test:e2e:ui": "playwright test --config test/playwright/playwright.config.ts --ui",
    "screenshots:view": "node test/playwright/screenshot-viewer-server.mjs",
    "screenshots:record": "node test/playwright/record-screenshot.mjs",
    "screenshots:status": "node test/playwright/screenshot-status.mjs",
    "test:visual": "playwright test --config test/playwright/visual.config.ts",
    "test:visual:update": "playwright test --config test/playwright/visual.config.ts --update-snapshots",
    "test:visual:report": "playwright show-report test/playwright/test-results/visual-report",
    "test:perf": "playwright test --config test/playwright/perf.config.ts"
  }
}
