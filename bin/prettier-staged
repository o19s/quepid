#!/usr/bin/env bash
# Check Prettier on staged app/javascript api/utils (see config/javascript_lint_scope.mjs).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PRETTIER="./node_modules/.bin/prettier"

if [[ $# -eq 0 ]]; then
  exit 0
fi

cd "$ROOT"

files=()
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  files+=("$file")
done < <(node scripts/filter_javascript_prettier_paths.mjs "$@")

if [[ ${#files[@]} -eq 0 ]]; then
  exit 0
fi

if docker info >/dev/null 2>&1; then
  exec bin/docker r "$PRETTIER" --check "${files[@]}"
fi

if [[ ! -x "$ROOT/node_modules/.bin/prettier" ]]; then
  echo "prettier not found; run: yarn install (or bin/docker r yarn install)" >&2
  exit 1
fi

exec "$ROOT/node_modules/.bin/prettier" --check "${files[@]}"
