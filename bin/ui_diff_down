#!/usr/bin/env bash
set -euo pipefail

# Manually stops the permanent diff-baseline instance started by bin/ui_diff_up. Not part of a
# normal comparison: the instance is meant to stay up between checks. By default the worktree is
# left in place (so the next ui_diff_up against the same base ref is fast); pass
# --remove-worktree to also delete it.

APP_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$APP_ROOT"

STATE_DIR="$APP_ROOT/tmp/ui_diff"
CONTAINER_NAME="quepid_app_ui_diff"
WORKTREE_DIR="$(dirname "$APP_ROOT")/quepid-ui-diff-worktree"

REMOVE_WORKTREE=0
[ "${1:-}" = "--remove-worktree" ] && REMOVE_WORKTREE=1

echo "==> Stopping $CONTAINER_NAME"
docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
rm -f "$STATE_DIR/current"

if [ "$REMOVE_WORKTREE" = "1" ] && [ -d "$WORKTREE_DIR" ]; then
  echo "==> Removing worktree $WORKTREE_DIR"
  git worktree remove --force "$WORKTREE_DIR" || rm -rf "$WORKTREE_DIR"
fi

echo "==> Done"
