#!/usr/bin/env ruby
# frozen_string_literal: true

# Reports which docs/manual-testing/*.md scenarios are due for a re-run, by cross-referencing
# docs/manual-testing/tracking.yml against git + on-disk state. Plain Ruby + git, no Rails boot,
# no Docker needed, so it's fast enough to run before/after any change.
#
# A scenario is DUE when any of:
#   - it has never been run (last_run: null)
#   - a file under its `paths` changed after last_run - committed or not
#     ("code changed since last verified")
#   - last_run is older than policy.default_max_age_days ("stale by pure time")
#
# Content first: docs/manual-testing/verified_sources.yml records a hash of each scenario's files
# as verified (`--record`, run right after updating last_run). A recorded file counts as changed
# only when its content differs, ignoring whitespace-only edits, so merges, rebases, checkouts and
# reformatting don't make it due. A record older than last_run is out of date and ignored. Files
# without a recorded hash (no record yet, or newly added to `paths`) fall back to timestamps:
#
# Dirty files use their on-disk modification time. Clean files use the earlier of their
# modification time and last commit time, computed per file. A normal commit preserves mtime,
# so code tested after editing stays current when committed. An old commit also prevents a
# checkout's refreshed mtime from marking already verified code due.
# Fresh clones/rebases can still conservatively report DUE. Preserved/backdated mtimes can
# hide edits, as with the dirty-file check; timestamps are a heuristic, not content identity.
# Keep last_run as the actual test time.
#
# `last_run` should be a full UTC timestamp (YYYY-MM-DDTHH:MM:SSZ), compared at full precision -
# not truncated to a date - so two events on the same calendar day (e.g. a verification pass and a
# later same-day edit) compare correctly. Older bare-date entries (YYYY-MM-DD, no time) are treated
# as the END of that UTC day, preserving the same-day-doesn't-count-as-stale behavior those entries
# were originally written under - reinterpreting ~100+ pre-existing entries under a stricter
# same-day rule would itself cause a wave of unnecessary reruns, the opposite of this tool's
# purpose. New entries should use full timestamps so this guesswork doesn't apply to them.
#
# Usage:
#   bin/manual_test_status                 # full report, grouped by part
#   bin/manual_test_status --due-only       # only scenarios needing attention
#   bin/manual_test_status --part 07        # limit to one part
#   bin/manual_test_status --paths-for 3.2  # show the exact files tracked for one scenario
#   bin/manual_test_status --base origin/x  # compare untracked-change report against another base
#   bin/manual_test_status --record 4.6,4.7 # record verified file contents after a pass
#
# The full report also lists app/, config/ and lib/ files changed on this branch (since the
# merge-base with --base, default origin/main) or in the working tree that no scenario's `paths`
# names. A change there makes nothing due, so treat it as unknown risk, not as safe. Files listed
# in docs/manual-testing/untracked_ignore.yml are left out.

require 'yaml'
require 'date'
require 'time'
require 'optparse'
require 'open3'
require 'set'
require 'digest'

ROOT = File.expand_path('..', __dir__)
TRACKING_FILE = File.join(ROOT, 'docs/manual-testing/tracking.yml')
UNTRACKED_IGNORE_FILE = File.join(ROOT, 'docs/manual-testing/untracked_ignore.yml')
VERIFIED_FILE = File.join(ROOT, 'docs/manual-testing/verified_sources.yml')

options = { due_only: false, part: nil, paths_for: nil, base: 'origin/main', record: nil }
OptionParser.new do |opts|
  opts.banner = 'Usage: bin/manual_test_status [options]'
  opts.on('--due-only', 'Only print scenarios that need a rerun') { options[:due_only] = true }
  opts.on('--part PART', 'Limit to one part, e.g. 07') { |v| options[:part] = v }
  opts.on('--paths-for SCENARIO', 'Print tracked paths for one scenario id, e.g. 3.2') { |v| options[:paths_for] = v }
  opts.on('--base REF', 'Base ref for the untracked-change report (default origin/main)') { |v| options[:base] = v }
  opts.on('--record IDS', Array, 'Record current file contents as verified, e.g. 4.6,4.7') { |v| options[:record] = v }
end.parse!

unless File.exist?(TRACKING_FILE)
  warn "No tracking file at #{TRACKING_FILE}"
  exit 1
end

data = YAML.safe_load(File.read(TRACKING_FILE), permitted_classes: [Date, Time], aliases: true)
default_max_age = (data['policy'] || {})['default_max_age_days'] || 90

# Cache one lookup per unique path list so we don't re-stat/re-shell-out per scenario.
last_change_cache = {}

# A `paths` entry may be a single file or a directory (trailing slash, e.g. "app/jobs/") - walk
# directories recursively so a change to any file under them counts.
def files_under(root, path)
  full = File.join(root, path)
  return [full] if File.file?(full)
  return [] unless File.directory?(full)

  Dir.glob(File.join(full, '**', '*')).select { |f| File.file?(f) }
end

# git status --porcelain lines are "XY path" or "XY old -> new" for renames; either way the
# current on-disk path is the last whitespace-separated field after the two-char status code.
# An untracked directory reports as a single "?? dir/" line rather than one line per file inside
# it, so route each path through `files_under` to expand that case the same way a `paths:` entry
# naming a directory already gets expanded.
def dirty_files_for(root)
  out, status = Open3.capture2('git', '-C', root, 'status', '--porcelain')
  return Set.new unless status.success?

  out.lines.flat_map { |line| files_under(root, line[3..].to_s.strip.split(' -> ').last) }.to_set
end

def last_change_for(paths, root, cache, dirty_files)
  return nil if paths.nil? || paths.empty?

  key = paths.sort.join('|')
  return cache[key] if cache.key?(key)

  files = paths.flat_map { |p| files_under(root, p) }.uniq
  if files.empty?
    cache[key] = nil
    return nil
  end

  times = files.map do |file|
    file_key = [:file, file]
    next cache[file_key] if cache.key?(file_key)

    modified_at = File.mtime(file).utc
    if dirty_files.include?(file)
      cache[file_key] = modified_at
    else
      cmd = ['git', '-C', root, 'log', '-1', '--format=%cI', '--', file]
      out, status = Open3.capture2(*cmd)
      committed_at = if status.success? && !out.strip.empty?
                       Time.iso8601(out.strip).utc
                     end
      cache[file_key] = committed_at ? [modified_at, committed_at].min : modified_at
    end
  end

  cache[key] = times.max
end

# Bare YYYY-MM-DD entries (recorded before full-timestamp last_run was required) become the END of
# that UTC day, not the start — preserving the old date-vs-date behavior these entries were written
# under (same-day code change does NOT count as "after"). Reinterpreting ~128 pre-existing entries
# under a stricter same-day rule they were never written against would itself cause a wave of
# unnecessary reruns, which is exactly what this tool exists to avoid. Full-timestamp entries (the
# new convention, going forward) aren't affected by this and compare at true precision.
def normalize_last_run(value)
  return nil unless value

  case value
  when Time then value
  when Date then Time.utc(value.year, value.month, value.day, 23, 59, 59)
  else Time.parse(value.to_s)
  end
end

def days_since(time)
  # Both sides must be the same zone — Date.today is system-local, which can disagree with a
  # UTC-derived last_run by a day right around either zone's midnight.
  (Time.now.utc.to_date - time.to_date).to_i
end

dirty_files = dirty_files_for(ROOT)

def tracked_by?(file, tracked_paths)
  tracked_paths.any? { |p| file == p || file.start_with?("#{p.chomp('/')}/") }
end

# Whitespace-insensitive content identity: reformatting and re-indenting aren't a change.
def content_hash(bytes)
  Digest::SHA256.hexdigest(bytes.b.gsub(/\s+/n, ' ').strip)[0, 16]
end

def scenario_files(root, paths)
  (paths || []).flat_map { |p| files_under(root, p) }.uniq.map { |f| f.delete_prefix("#{root}/") }.sort
end

def write_records(records)
  sorted = records.sort_by { |id, _| [id.split('.').map(&:to_i), id] }.to_h
  File.write(VERIFIED_FILE, <<~HEADER + sorted.to_yaml.delete_prefix("---\n"))
    # Generated by bin/manual_test_status --record; don't edit by hand.
    # Per scenario: when its files were recorded as verified, and a whitespace-insensitive
    # content hash of each file under its `paths` at that time. `backfilled_from` entries were
    # seeded once from git history. On a merge conflict, keep each scenario's block with the
    # later recorded_at; don't merge hashes by hand.
  HEADER
end

verified = File.exist?(VERIFIED_FILE) ? YAML.safe_load_file(VERIFIED_FILE, permitted_classes: [Time]) || {} : {}
scenarios = (data['parts'] || {}).values.flat_map { |p| (p['scenarios'] || {}).to_a }.to_h
record_time = ->(record) { Time.parse(record['recorded_at'].to_s).utc }

if options[:record]
  options[:record].each do |id|
    s = scenarios[id] or abort("No scenario #{id} found")
    last_run = normalize_last_run(s['last_run'])
    # Recording blesses the files as they are now, so only do it for the pass just run.
    if last_run.nil? || Time.now.utc - last_run > 24 * 3600
      abort("Scenario #{id}: set last_run to this pass's time before recording (last_run is #{s['last_run'].inspect})")
    end
    changed = last_change_for(s['paths'], ROOT, last_change_cache, dirty_files)
    if changed && changed > last_run
      abort("Scenario #{id}: its files changed after last_run (#{changed.strftime('%Y-%m-%d %H:%M UTC')}); " \
            'verify again before recording')
    end
    files = scenario_files(ROOT, s['paths'])
    abort("Scenario #{id}: its paths match no existing files") if files.empty?
    verified[id] = {
      'recorded_at' => Time.now.utc.iso8601,
      'files' => files.to_h { |f| [f, content_hash(File.binread(File.join(ROOT, f)))] }
    }
  end
  write_records(verified)
  puts "Recorded #{options[:record].join(', ')} in #{VERIFIED_FILE.delete_prefix("#{ROOT}/")}"
  exit 0
end

current_hashes = Hash.new { |h, f| h[f] = content_hash(File.binread(File.join(ROOT, f))) }

rows = []
(data['parts'] || {}).each do |part_id, part|
  next if options[:part] && options[:part] != part_id

  (part['scenarios'] || {}).each do |scenario_id, s|
    next if options[:paths_for] && options[:paths_for] != scenario_id

    last_run = normalize_last_run(s['last_run'])
    record = verified[scenario_id]
    content_changed = []
    if record && last_run && record_time.call(record) >= last_run
      files = scenario_files(ROOT, s['paths'])
      recorded = record['files'] || {}
      content_changed = files.select { |f| recorded.key?(f) && recorded[f] != current_hashes[f] } +
                        recorded.keys.reject { |f| files.include?(f) || !tracked_by?(f, s['paths'] || []) }
      code_changed = last_change_for(files - recorded.keys, ROOT, last_change_cache, dirty_files)
    else
      code_changed = last_change_for(s['paths'], ROOT, last_change_cache, dirty_files)
    end

    reasons = []
    reasons << 'never run' if last_run.nil?
    if content_changed.any?
      shown = content_changed.first(3).map { |f| File.basename(f) }.join(', ')
      more = content_changed.size > 3 ? " +#{content_changed.size - 3} more" : ''
      reasons << "content changed: #{shown}#{more}"
    end
    if last_run && code_changed && code_changed > last_run
      reasons << "file changed #{code_changed.strftime('%Y-%m-%d %H:%M UTC')} " \
                 "(after last_run #{last_run.getutc.strftime('%Y-%m-%d %H:%M UTC')})"
    end
    if last_run && days_since(last_run) > default_max_age
      reasons << "stale (#{days_since(last_run)}d > #{default_max_age}d)"
    end

    rows << {
      part: part_id,
      file: part['file'],
      id: scenario_id,
      title: s['title'],
      last_run: last_run,
      result: s['result'],
      due: !reasons.empty?,
      reasons: reasons,
      paths: s['paths'] || []
    }
  end
end

if options[:paths_for]
  row = rows.first
  if row
    puts "#{row[:id]} #{row[:title]}"
    row[:paths].each { |p| puts "  #{p}" }
  else
    warn "No scenario #{options[:paths_for]} found"
  end
  exit 0
end

def natural_sort_key(scenario_id)
  # "10.6a" -> [10, 6, "a"], "4.2" -> [4, 2, ""] — sorts numeric parts numerically.
  scenario_id.to_s.split('.').map do |segment|
    match = segment.match(/\A(\d+)([a-z]*)\z/)
    match ? [match[1].to_i, match[2]] : [0, segment]
  end
end

rows.sort_by! { |r| [r[:part], natural_sort_key(r[:id])] }
due_count = rows.count { |r| r[:due] }

current_part = nil
rows.each do |r|
  next if options[:due_only] && !r[:due]

  if r[:part] != current_part
    puts
    puts "== Part #{r[:part]} (#{r[:file]}) =="
    current_part = r[:part]
  end

  status = if r[:due]
             "DUE  — #{r[:reasons].join('; ')}"
           else
             "ok   — last run #{r[:last_run].getutc.strftime('%Y-%m-%d %H:%M UTC')} (#{r[:result]})"
           end
  printf("  %-6s %-55s %s\n", r[:id], r[:title][0, 55], status)
end

puts
puts "#{due_count} / #{rows.size} scenarios due for a rerun (never run, code changed since last_run, or stale > #{default_max_age}d)."

# Changed source files that no scenario lists. Only meaningful for the whole tracker, so skip it
# when the report is limited to one part.
UNTRACKED_SOURCE = %r{\A(app|config|lib)/}

unless options[:part]
  merge_base, status = Open3.capture2('git', '-C', ROOT, 'merge-base', 'HEAD', options[:base])
  committed = if status.success?
                out, = Open3.capture2('git', '-C', ROOT, 'diff', '--name-only', '--diff-filter=d',
                                      merge_base.strip, 'HEAD')
                out.lines.map(&:strip)
              else
                puts "Untracked-change report skipped: no merge-base with #{options[:base]}."
                []
              end
  dirty = dirty_files_for(ROOT).map { |f| f.delete_prefix("#{ROOT}/") }
  ignored = File.exist?(UNTRACKED_IGNORE_FILE) ? YAML.safe_load_file(UNTRACKED_IGNORE_FILE) || [] : []
  tracked_paths = rows.flat_map { |r| r[:paths] }.uniq + ignored
  untracked = (committed + dirty).uniq.grep(UNTRACKED_SOURCE)
    .select { |f| File.file?(File.join(ROOT, f)) }
    .reject { |f| tracked_by?(f, tracked_paths) }.sort
  if untracked.any?
    puts
    puts "#{untracked.size} changed source file(s) no scenario tracks (since merge-base with #{options[:base]}, " \
         'plus uncommitted) - add each to the right scenario `paths`, or to ' \
         'docs/manual-testing/untracked_ignore.yml if it cannot change what the UI displays:'
    untracked.each { |f| puts "  #{f}" }
  end
end
