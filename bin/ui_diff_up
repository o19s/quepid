#!/usr/bin/env bash
set -euo pipefail

# Points the permanent "diff baseline" Quepid instance at a BASE ref's code. It runs on its own
# port, sharing the same database service/keycloak/ollama containers as your primary `bin/docker s` dev
# server but with its own database (a copy of the dev database made by
# bin/ui_diff_db_sync) and its own job worker, so you can screenshot "before" (this instance) vs
# "after" (your live dev server) without ever touching your working tree or the dev data. It is one of three long-lived instances: current (:3000),
# historical (bin/legacy, :3001) and this one (:3003).
#
# Usage:
#   bin/ui_diff_up [BASE_REF] [PORT]
#   bin/ui_diff_up main            # port defaults to 3003 (3001 is bin/legacy's)
#   bin/ui_diff_up --reset HEAD    # discard local edits in the worktree (e.g. a pre-fix baseline)
#
# Idempotent: if the instance is already serving BASE_REF on PORT, this returns immediately.
# Otherwise it checks the shared worktree (../quepid-ui-diff-worktree) out at BASE_REF and
# recreates the single container (quepid_app_ui_diff), detached and with a restart policy, so it
# outlives the calling shell and Docker restarts. Assets are rebuilt only when the ref changes.
# bin/ui_diff_down stops it for a manual teardown.

APP_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$APP_ROOT"

set -a
source .env
set +a

RESET=0
if [ "${1:-}" = "--reset" ]; then
  RESET=1
  shift
fi

BASE_REF="${1:-}"
PORT="${2:-3003}"

if [ -z "$BASE_REF" ]; then
  BASE_REF=$(git merge-base HEAD main 2>/dev/null || git merge-base HEAD origin/main 2>/dev/null || true)
  if [ -z "$BASE_REF" ]; then
    echo "Couldn't determine a default base ref (no merge-base with main/origin/main). Pass one explicitly: bin/ui_diff_up <ref> [port]" >&2
    exit 1
  fi
fi
BASE_SHA=$(git rev-parse "$BASE_REF")

WORKTREE_DIR="$(dirname "$APP_ROOT")/quepid-ui-diff-worktree"
STATE_DIR="$APP_ROOT/tmp/ui_diff"
CURRENT_FILE="$STATE_DIR/current"          # "<sha> <port> <database> <adapter>"
OVERRIDE_FILE="$STATE_DIR/docker-compose.override.yml"
CONTAINER_NAME="quepid_app_ui_diff"
# For MySQL/PostgreSQL, database.yml appends "_development"; SQLite uses an isolated storage mount.
DIFF_DB_NAME="quepid_ui_diff"
DIFF_DB_ADAPTER="${DB_ADAPTER:-mysql2}"

mkdir -p "$STATE_DIR"

echo "==> Base ref: $BASE_REF ($BASE_SHA)"
echo "==> Worktree: $WORKTREE_DIR"
echo "==> Port:     $PORT"

running() {
  [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null)" = "true" ]
}

worktree_dirty() {
  [ -d "$WORKTREE_DIR" ] && [ -n "$(git -C "$WORKTREE_DIR" status --porcelain --untracked-files=no)" ]
}

CURRENT=""
[ -f "$CURRENT_FILE" ] && CURRENT=$(cat "$CURRENT_FILE")

# --- already serving this ref? -----------------------------------------------------------------
if [ "$RESET" = "0" ] && running && [ "$CURRENT" = "$BASE_SHA $PORT $DIFF_DB_NAME $DIFF_DB_ADAPTER" ]; then
  if worktree_dirty; then
    echo "==> Note: the worktree has local edits (a pre-fix baseline?). Pass --reset to discard them."
  fi
  if ! curl -sf -o /dev/null "http://localhost:$PORT" 2>/dev/null; then
    echo "Container is up at this ref but http://localhost:$PORT isn't answering:" >&2
    docker logs --tail 60 "$CONTAINER_NAME" >&2 || true
    exit 1
  fi
  echo "==> Already up: http://localhost:$PORT  (base ref $BASE_REF)"
  exit 0
fi

# Local edits (e.g. a pre-fix baseline) survive a restart at the same ref; switching refs would
# discard them, so that needs an explicit --reset.
KEEP_EDITS=0
if [ "$RESET" = "0" ] && worktree_dirty; then
  if [ "$(git -C "$WORKTREE_DIR" rev-parse HEAD)" = "$BASE_SHA" ]; then
    KEEP_EDITS=1
  else
    echo "The worktree has local edits (a pre-fix baseline?) that switching to $BASE_SHA would discard." >&2
    echo "Check nobody is using them, then rerun with --reset." >&2
    exit 1
  fi
fi

if running && [ -n "$CURRENT" ]; then
  read -r CURRENT_SHA CURRENT_PORT _ <<< "$CURRENT"
  if [ "$CURRENT_SHA $CURRENT_PORT" = "$BASE_SHA $PORT" ]; then
    echo "==> Recreating the baseline at $BASE_SHA (port $PORT)"
  else
    echo "==> Switching the baseline from $CURRENT_SHA (port $CURRENT_PORT) to $BASE_SHA (port $PORT)"
  fi
fi

# --- worktree: create or move to the requested ref ---------------------------------------------
if [ "$KEEP_EDITS" = "1" ]; then
  echo "==> Reusing existing worktree, keeping its local edits"
elif git worktree list --porcelain | grep -qxF "worktree $WORKTREE_DIR"; then
  echo "==> Reusing existing worktree"
  git -C "$WORKTREE_DIR" checkout --force --quiet "$BASE_SHA" || {
    echo "Failed to check out $BASE_SHA in existing worktree; remove it and retry: git worktree remove --force $WORKTREE_DIR" >&2
    exit 1
  }
else
  echo "==> Creating worktree"
  git worktree add --quiet --force "$WORKTREE_DIR" "$BASE_SHA"
fi

# --- seed untracked config files a fresh checkout won't have (mirrors bin/setup_docker) ---------
if [ ! -f "$WORKTREE_DIR/config/database.yml" ]; then
  echo "==> Seeding config/database.yml from .sample (gitignored, absent in a fresh worktree)"
  cp "$WORKTREE_DIR/config/database.yml.sample" "$WORKTREE_DIR/config/database.yml"
fi

# --- replace the single container ---------------------------------------------------------------
docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
rm -f "$CURRENT_FILE"

# --- the baseline's own database: copy the dev database the first time --------------------------
"$APP_ROOT/bin/ui_diff_db_sync" --if-missing

# --- compose override: point the `app` service's volume at the worktree instead of `.` ---------
cat > "$OVERRIDE_FILE" <<YAML
services:
  app:
    volumes:
      - $WORKTREE_DIR:/srv/app:cached
      - ./log:/log
YAML
if [ "$DIFF_DB_ADAPTER" = "sqlite3" ]; then
  echo "      - ./tmp/ui_diff/storage:/srv/app/storage" >> "$OVERRIDE_FILE"
fi

# The build marker lives in the worktree's gitignored tmp/, so it survives checkouts and a
# container restart only rebuilds when the ref actually changed. --reset forces a rebuild.
[ "$RESET" = "1" ] && rm -f "$WORKTREE_DIR/tmp/ui_diff_built_sha"
CONTAINER_CMD='set -e
bundle check || bundle install
if [ "$(cat tmp/ui_diff_built_sha 2>/dev/null)" != "$UI_DIFF_SHA" ]; then
  yarn install --silent
  yarn build
  mkdir -p tmp
  echo "$UI_DIFF_SHA" > tmp/ui_diff_built_sha
fi
rm -f tmp/pids/server.pid
exec bundle exec puma -C config/puma.rb'

echo "==> Starting app container ($CONTAINER_NAME) on port $PORT"
APP_PORT="$PORT" docker compose \
  -f docker-compose.yml -f "$OVERRIDE_FILE" \
  run --detach --service-ports --name "$CONTAINER_NAME" -e "UI_DIFF_SHA=$BASE_SHA" \
  -e "DB_NAME=$DIFF_DB_NAME" -e SOLID_QUEUE_IN_PUMA=1 \
  app bash -c "$CONTAINER_CMD" >/dev/null
docker update --restart unless-stopped "$CONTAINER_NAME" >/dev/null

echo "==> Waiting for http://localhost:$PORT to respond (log: docker logs $CONTAINER_NAME)"
for _ in $(seq 1 180); do
  if curl -sf -o /dev/null "http://localhost:$PORT" 2>/dev/null; then
    echo "$BASE_SHA $PORT $DIFF_DB_NAME $DIFF_DB_ADAPTER" > "$CURRENT_FILE"
    echo "==> Ready: http://localhost:$PORT  (base ref $BASE_REF)"
    exit 0
  fi
  if ! running; then
    echo "Container exited early:" >&2
    docker logs --tail 60 "$CONTAINER_NAME" >&2 || true
    exit 1
  fi
  sleep 2
done

echo "Timed out waiting for http://localhost:$PORT:" >&2
docker logs --tail 60 "$CONTAINER_NAME" >&2 || true
exit 1
