#!/usr/bin/env bash
# Lint and Prettier-check staged CSS under app/assets/stylesheets (same scope as `rake test:stylelint`).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STYLELINT="$ROOT/node_modules/.bin/stylelint"
PRETTIER="$ROOT/node_modules/.bin/prettier"

for bin in "$STYLELINT" "$PRETTIER"; do
  if [[ ! -x "$bin" ]]; then
    echo "$(basename "$bin") not found; run: yarn install (or bin/docker r yarn install)" >&2
    exit 1
  fi
done

files=()
for path in "$@"; do
  case "$path" in
    app/assets/stylesheets/*.css) files+=("$path") ;;
  esac
done

if [[ ${#files[@]} -eq 0 ]]; then
  exit 0
fi

cd "$ROOT"
"$STYLELINT" "${files[@]}"
exec "$PRETTIER" --check "${files[@]}"
